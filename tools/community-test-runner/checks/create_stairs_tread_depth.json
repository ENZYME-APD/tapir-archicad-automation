{
  "title": "CreateStairs honours treadDepth (#425)",
  "minTapir": "1.6.0",
  "steps": [
    {
      "id": "going 0.25, 14 risers",
      "command": "CreateStairs",
      "timeout": 120,
      "params": {
        "stairsData": [
          {
            "baseLinePoints": [
              {
                "x": 600,
                "y": 600
              },
              {
                "x": 614,
                "y": 600
              }
            ],
            "zCoordinate": 0.0,
            "totalHeight": 2.75,
            "flightWidth": 1.0,
            "stepNum": 14,
            "treadDepth": 0.25
          }
        ]
      },
      "save": {
        "g_a": "elements[0].elementId.guid"
      }
    },
    {
      "id": "going 0.25, 14 risers: bounding box",
      "command": "Get3DBoundingBoxes",
      "creates": false,
      "params": {
        "elements": [
          {
            "elementId": {
              "guid": "${g_a}"
            }
          }
        ]
      },
      "save": {
        "x0_a": "boundingBoxes3D[0].boundingBox3D.xMin",
        "x1_a": "boundingBoxes3D[0].boundingBox3D.xMax"
      }
    },
    {
      "id": "going 0.25, 15 risers",
