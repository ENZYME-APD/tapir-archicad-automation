{
  "title": "RebuildMEPRoutingElements adds a node to a pipe route, leaves out a collinear node, keeps the route's insulation and element ID, keeps both sizes and the element ID of a duct route with a size change and maps its old parts to the new ones, resets custom segments, and refuses, without changing anything, a segment without length, a route ending at a tee and a route with a take-off",
  "minTapir": "2.0.1",
  "minArchicad": "28",
  "steps": [
    {
      "id": "floor plan",
      "command": "ChangeWindow",
      "creates": false,
      "params": {
        "windowType": "FloorPlan",
        "storyIndex": 0
      }
    },
    {
      "id": "pipe route with one elbow",
      "command": "CreateMEPRoutingElements",
      "params": {
        "routingElementsData": [
          {
            "domain": "Piping",
            "nodeCoordinates": [
              {
                "x": 0.0,
                "y": -8.0,
                "z": 3.0
              },
              {
                "x": 4.0,
                "y": -8.0,
                "z": 3.0
              },
              {
                "x": 4.0,
                "y": -5.0,
                "z": 3.0
              }
            ]
          }
        ]
      },
      "save": {
        "pipe": "elements[0].elementId.guid"
      },
      "expect": [
        {
          "path": "elements[0].elementId.guid",
          "exists": true,
          "name": "pipe created"
        }
      ]
    },
    {
      "id": "insulate",
      "command": "ModifyMEPRoutingElements",
      "creates": false,
      "params": {
        "routingElementsData": [
          {
            "elementId": {
              "guid": "${pipe}"
            },
            "insulationThickness": 0.02
          }
        ]
      },
      "expect": [
        {
          "path": "executionResults[0].success",
          "eq": true
        }
      ]
    },
    {
      "id": "give the pipe an element ID",
      "command": "SetElementInfoStrings",
      "creates": false,
      "params": {
        "elements": [
          {
            "elementId": {
              "guid": "${pipe}"
            },
            "infoString": "REBUILT PIPE 1"
          }
        ]
      },
      "expect": [
        {
          "path": "executionResults[0].success",
          "eq": true
        }
      ]
    },
    {
      "id": "add a node",
      "command": "RebuildMEPRoutingElements",
      "params": {
        "routingElements": [
          {
            "routingElementId": {
              "guid": "${pipe}"
            },
            "nodeCoordinates": [
              {
                "x": 0.0,
                "y": -8.0,
                "z": 3.0
              },
              {
                "x": 4.0,
                "y": -8.0,
                "z": 3.0
              },
              {
                "x": 4.0,
                "y": -5.0,
                "z": 3.0
              },
              {
                "x": 6.0,
                "y": -5.0,
                "z": 3.0
              }
            ]
          }
        ]
      },
      "save": {
        "rebuilt": "elements[0].elementId.guid"
      },
      "expect": [
        {
          "path": "elements[0].elementId.guid",
          "exists": true,
          "name": "route rebuilt"
        }
      ]
    },
    {
      "id": "read the added node",
      "command": "GetMEPRoutingElements",
      "creates": false,
      "params": {
        "elements": [
          {
            "elementId": {
              "guid": "${rebuilt}"
            }
          }
        ]
      },
      "expect": [
        {
          "path": "routingElements[0].polyline",
          "len": 4,
          "name": "four nodes"
        },
        {
          "path": "routingElements[0].segments",
          "len": 3,
          "name": "three segments"
        },
        {
          "path": "routingElements[0].polyline[3].x",
          "approx": 6.0,
          "name": "the new node is at the end"
        },
        {
          "path": "routingElements[0].segments[2].insulationThickness",
          "approx": 0.02,
          "name": "the new segment has the route's insulation"
        }
      ]
    },
    {
      "id": "leave out a collinear node",
      "command": "RebuildMEPRoutingElements",
      "params": {
        "routingElements": [
          {
            "routingElementId": {
              "guid": "${rebuilt}"
            },
            "nodeCoordinates": [
              {
                "x": 0.0,
                "y": -8.0,
                "z": 3.0
              },
              {
                "x": 2.0,
                "y": -8.0,
                "z": 3.0
              },
              {
                "x": 4.0,
                "y": -8.0,
                "z": 3.0
              },
              {
                "x": 4.0,
                "y": -5.0,
                "z": 3.0
              }
            ],
            "removeCollinearNodes": true
          }
        ]
      },
      "save": {
        "purged": "elements[0].elementId.guid"
      },
      "expect": [
        {
          "path": "elements[0].elementId.guid",
          "exists": true,
          "name": "route rebuilt"
        }
      ]
    },
    {
      "id": "read the purged route",
      "command": "GetMEPRoutingElements",
      "creates": false,
      "params": {
        "elements": [
          {
            "elementId": {
              "guid": "${purged}"
            }
          }
        ]
      },
      "expect": [
        {
          "path": "routingElements[0].polyline",
          "len": 3,
          "name": "the node at x 2 is left out"
        },
        {
          "path": "routingElements[0].polyline[1].x",
          "approx": 4.0,
          "name": "the elbow node stays"
        }
      ]
    },
    {
      "id": "the pipe keeps its element ID through both rebuilds",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": {
        "elements": [
          {
            "elementId": {
              "guid": "${purged}"
            }
          }
        ]
      },
      "expect": [
        {
          "path": "detailsOfElements[0].id",
          "eq": "REBUILT PIPE 1",
          "name": "element ID kept"
        }
      ]
    },
    {
      "id": "two duct routes of different widths, end to end",
      "command": "CreateMEPRoutingElements",
      "params": {
        "routingElementsData": [
          {
            "domain": "Ventilation",
            "crossSectionShape": "Rectangular",
            "crossSectionWidth": 0.4,
            "crossSectionHeight": 0.2,
            "nodeCoordinates": [
              {
                "x": 0.0,
                "y": -14.0,
                "z": 3.0
              },
              {
                "x": 4.0,
                "y": -14.0,
                "z": 3.0
              }
            ]
          },
          {
            "domain": "Ventilation",
            "crossSectionShape": "Rectangular",
            "crossSectionWidth": 0.3,
            "crossSectionHeight": 0.2,
            "nodeCoordinates": [
              {
                "x": 4.0,
                "y": -14.0,
                "z": 3.0
              },
              {
                "x": 8.0,
                "y": -14.0,
                "z": 3.0
              },
              {
                "x": 8.0,
                "y": -11.0,
                "z": 3.0
              }
            ]
          }
        ]
      },
      "save": {
        "wide": "elements[0].elementId.guid",
        "narrow": "elements[1].elementId.guid"
      },
      "expect": [
        {
          "path": "elements[1].elementId.guid",
          "exists": true,
          "name": "both ducts created"
        }
      ]
    },
    {
      "id": "merge them into one route with a size change",
      "command": "ConnectMEPElements",
      "creates": false,
      "params": {
        "connectionsData": [
          {
            "routingElementId": {
              "guid": "${wide}"
            },
            "connectToId": {
              "guid": "${narrow}"
            }
          }
        ]
      },
      "expect": [
        {
          "path": "connectionResults[0].error",
          "exists": false,
          "name": "merged"
        }
      ]
    },
    {
      "id": "the merged route has both widths",
      "command": "GetMEPRoutingElements",
      "creates": false,
      "params": {
        "elements": [
          {
            "elementId": {
              "guid": "${wide}"
            }
          }
        ]
      },
      "expect": [
        {
          "path": "routingElements[0].segments",
          "len": 3,
          "name": "three segments"
        },
        {
          "path": "routingElements[0].segments[0].crossSectionWidth",
          "approx": 0.4,
          "name": "first segment 0.4 wide"
        },
        {
          "path": "routingElements[0].segments[1].crossSectionWidth",
          "approx": 0.3,
          "name": "second segment 0.3 wide"
        }
      ]
    },
    {
      "id": "give the duct an element ID",
      "command": "SetElementInfoStrings",
      "creates": false,
      "params": {
        "elements": [
          {
            "elementId": {
              "guid": "${wide}"
            },
            "infoString": "REBUILT DUCT 1"
          }
        ]
      },
      "expect": [
        {
          "path": "executionResults[0].success",
          "eq": true
        }
      ]
    },
    {
      "id": "add a node at the far end",
      "command": "RebuildMEPRoutingElements",
      "params": {
        "routingElements": [
          {
            "routingElementId": {
              "guid": "${wide}"
            },
            "nodeCoordinates": [
              {
                "x": 0.0,
                "y": -14.0,
                "z": 3.0
              },
              {
                "x": 4.0,
                "y": -14.0,
                "z": 3.0
              },
              {
                "x": 8.0,
                "y": -14.0,
                "z": 3.0
              },
              {
                "x": 8.0,
                "y": -11.0,
                "z": 3.0
              },
              {
                "x": 10.0,
                "y": -11.0,
                "z": 3.0
              }
            ]
          }
        ]
      },
      "save": {
        "duct": "elements[0].elementId.guid"
      },
      "expect": [
        {
          "path": "elements[0].elementId.guid",
          "exists": true,
          "name": "route rebuilt"
        },
        {
          "path": "elements[0].guidMap[0].kind",
          "eq": "Segment",
          "name": "the first new segment is in the guidMap"
        },
        {
          "path": "elements[0].guidMap[0].oldGuid",
          "exists": true,
          "name": "with the old segment it lies along"
        },
        {
          "path": "elements[0].guidMap[0].newGuid",
          "exists": true,
          "name": "and its new guid"
        }
      ]
    },
    {
      "id": "both widths survive the rebuild",
      "command": "GetMEPRoutingElements",
      "creates": false,
      "params": {
        "elements": [
          {
            "elementId": {
              "guid": "${duct}"
            }
          }
        ]
      },
      "expect": [
        {
          "path": "routingElements[0].segments",
          "len": 4,
          "name": "four segments"
        },
        {
          "path": "routingElements[0].segments[0].crossSectionWidth",
          "approx": 0.4,
          "name": "first segment still 0.4 wide"
        },
        {
          "path": "routingElements[0].segments[1].crossSectionWidth",
          "approx": 0.3,
          "name": "second segment still 0.3 wide"
        },
        {
          "path": "routingElements[0].segments[2].crossSectionWidth",
          "approx": 0.3,
          "name": "third segment still 0.3 wide"
        },
        {
          "path": "routingElements[0].segments[3].crossSectionWidth",
          "approx": 0.3,
          "name": "the new end segment continues 0.3 wide, like the segment it is drawn from"
        }
      ]
    },
    {
      "id": "the duct keeps its element ID",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": {
        "elements": [
          {
            "elementId": {
              "guid": "${duct}"
            }
          }
        ]
      },
      "expect": [
        {
          "path": "detailsOfElements[0].id",
          "eq": "REBUILT DUCT 1",
          "name": "element ID kept"
        }
      ]
    },
    {
      "id": "reset the custom segments",
      "command": "RebuildMEPRoutingElements",
      "params": {
        "routingElements": [
          {
            "routingElementId": {
              "guid": "${duct}"
            },
            "resetCustomSegments": true
          }
        ]
      },
      "save": {
        "resetDuct": "elements[0].elementId.guid"
      },
      "expect": [
        {
          "path": "elements[0].elementId.guid",
          "exists": true,
          "name": "route rebuilt"
        }
      ]
    },
    {
      "id": "read the reset route",
      "command": "GetMEPRoutingElements",
      "creates": false,
      "params": {
        "elements": [
          {
            "elementId": {
              "guid": "${resetDuct}"
            }
          }
        ]
      },
      "save": {
        "w0": "routingElements[0].segments[0].crossSectionWidth",
        "w1": "routingElements[0].segments[1].crossSectionWidth"
      },
      "expect": [
        {
          "path": "routingElements[0].segments",
          "len": 4,
          "name": "still four segments"
        }
      ]
    },
    {
      "id": "the reset gave both segments one width",
      "command": "GetMEPRoutingElements",
      "creates": false,
      "params": {
        "elements": [
          {
            "elementId": {
              "guid": "${resetDuct}"
            }
          }
        ]
      },
      "expect": [
        {
          "expr": "${w0} - ${w1}",
          "approx": 0.0,
          "name": "same width"
        }
      ]
    },
    {
      "id": "a segment without length",
      "command": "RebuildMEPRoutingElements",
      "creates": false,
      "params": {
        "routingElements": [
          {
            "routingElementId": {
              "guid": "${purged}"
            },
            "nodeCoordinates": [
              {
                "x": 0.0,
                "y": -8.0,
                "z": 3.0
              },
              {
                "x": 0.0,
                "y": -8.0,
                "z": 3.0
              },
              {
                "x": 4.0,
                "y": -8.0,
                "z": 3.0
              }
            ]
          },
          {
            "routingElementId": {
              "guid": "00000000-0000-0000-0000-00000000BEEF"
            }
          }
        ]
      },
      "expect": [
        {
          "path": "elements[0].error.code",
          "exists": true,
          "name": "refused"
        },
        {
          "path": "elements[1].error.code",
          "exists": true,
          "name": "a guid that is no route is refused"
        }
      ]
    },
    {
      "id": "the refused route is unchanged",
      "command": "GetMEPRoutingElements",
      "creates": false,
      "params": {
        "elements": [
          {
            "elementId": {
              "guid": "${purged}"
            }
          }
        ]
      },
      "expect": [
        {
          "path": "routingElements[0].polyline",
          "len": 3,
          "name": "still three nodes"
        }
      ]
    },
    {
      "id": "a main duct and a branch duct starting on it",
      "command": "CreateMEPRoutingElements",
      "params": {
        "routingElementsData": [
          {
            "domain": "Ventilation",
            "nodeCoordinates": [
              {
                "x": 0.0,
                "y": -20.0,
                "z": 3.0
              },
              {
                "x": 8.0,
                "y": -20.0,
                "z": 3.0
              }
            ]
          },
          {
            "domain": "Ventilation",
            "nodeCoordinates": [
              {
                "x": 4.0,
                "y": -20.0,
                "z": 3.0
              },
              {
                "x": 4.0,
                "y": -17.0,
                "z": 3.0
              }
            ]
          }
        ]
      },
      "save": {
        "main": "elements[0].elementId.guid",
        "branch": "elements[1].elementId.guid"
      },
      "expect": [
        {
          "path": "elements[1].elementId.guid",
          "exists": true,
          "name": "both ducts created"
        }
      ]
    },
    {
      "id": "connect them with a tee",
      "command": "ConnectMEPElements",
      "creates": false,
      "params": {
        "connectionsData": [
          {
            "routingElementId": {
              "guid": "${main}"
            },
            "connectToId": {
              "guid": "${branch}"
            }
          }
        ]
      },
      "save": {
        "tee": "connectionResults[0].createdBranchId.guid",
        "split": "connectionResults[0].splitRoutingElementId.guid"
      },
      "expect": [
        {
          "path": "connectionResults[0].createdBranchId.guid",
          "exists": true,
          "name": "tee created"
        }
      ]
    },
    {
      "id": "a route that ends at the tee is refused",
      "command": "RebuildMEPRoutingElements",
      "creates": false,
      "params": {
        "routingElements": [
          {
            "routingElementId": {
              "guid": "${branch}"
            },
            "nodeCoordinates": [
              {
                "x": 4.0,
                "y": -20.0,
                "z": 3.0
              },
              {
                "x": 4.0,
                "y": -17.0,
                "z": 3.0
              },
              {
                "x": 6.0,
                "y": -17.0,
                "z": 3.0
              }
            ]
          }
        ]
      },
      "expect": [
        {
          "path": "elements[0].error.message",
          "contains": "tee",
          "name": "refused, naming the tee"
        }
      ]
    },
    {
      "id": "the tee is kept",
      "command": "GetMEPPorts",
      "creates": false,
      "params": {
        "elements": [
          {
            "elementId": {
              "guid": "${tee}"
            }
          }
        ]
      },
      "expect": [
        {
          "path": "elementPorts[0].ports",
          "len": 3,
          "name": "the tee still has its three ports"
        }
      ]
    },
    {
      "id": "a duct for a take-off",
      "command": "CreateMEPRoutingElements",
      "params": {
        "routingElementsData": [
          {
            "domain": "Ventilation",
            "nodeCoordinates": [
              {
                "x": 0.0,
                "y": -26.0,
                "z": 3.0
              },
              {
                "x": 6.0,
                "y": -26.0,
                "z": 3.0
              }
            ]
          }
        ]
      },
      "save": {
        "tduct": "elements[0].elementId.guid"
      }
    },
    {
      "id": "its segment",
      "command": "GetMEPRoutingElements",
      "creates": false,
      "params": {
        "elements": [
          {
            "elementId": {
              "guid": "${tduct}"
            }
          }
        ]
      },
      "save": {
        "tseg": "routingElements[0].segments[0].elementId.guid"
      }
    },
    {
      "id": "a take-off on it",
      "command": "CreateMEPTakeOffs",
      "params": {
        "takeOffsData": [
          {
            "segmentId": {
              "guid": "${tseg}"
            },
            "distanceFromBeginning": 2.0,
            "length": 0.3
          }
        ]
      },
      "expect": [
        {
          "path": "elements[0].elementId.guid",
          "exists": true,
          "name": "take-off created"
        }
      ]
    },
    {
      "id": "a route with a take-off is refused",
      "command": "RebuildMEPRoutingElements",
      "creates": false,
      "params": {
        "routingElements": [
          {
            "routingElementId": {
              "guid": "${tduct}"
            },
            "nodeCoordinates": [
              {
                "x": 0.0,
                "y": -26.0,
                "z": 3.0
              },
              {
                "x": 6.0,
                "y": -26.0,
                "z": 3.0
              },
              {
                "x": 6.0,
                "y": -23.0,
                "z": 3.0
              }
            ]
          }
        ]
      },
      "expect": [
        {
          "path": "elements[0].error.message",
          "contains": "take-off",
          "name": "refused, naming the take-off"
        }
      ]
    }
  ],
  "teardown": [
    {
      "command": "DeleteElements",
      "params": {
        "elements": [
          {
            "elementId": {
              "guid": "${split}"
            }
          }
        ]
      }
    },
    {
      "command": "DeleteElements",
      "params": {
        "elements": [
          {
            "elementId": {
              "guid": "${tee}"
            }
          }
        ]
      }
    }
  ]
}
