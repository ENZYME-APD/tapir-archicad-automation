{
  "title": "CreateAngleDimensions and ModifyAngleDimensions write the text position and direction, witness lines, marker and text box of an angle dimension, read them back and refuse bad values (#3133)",
  "minTapir": "2.0.2",
  "requiresEmpty": [],
  "steps": [
    {
      "id": "a 30 degree angle dimension with the new settings (lines from x 940, y 900)",
      "command": "CreateAngleDimensions",
      "params": {
        "angleDimensionsData": [
          {
            "firstLine": { "begCoordinate": { "x": 940.0, "y": 900.0 }, "endCoordinate": { "x": 944.0, "y": 900.0 } },
            "secondLine": { "begCoordinate": { "x": 940.0, "y": 900.0 }, "endCoordinate": { "x": 943.4641016, "y": 902.0 } },
            "arcPosition": { "x": 942.8977775, "y": 900.7764571 },
            "smallArc": true,
            "pen": 1,
            "textHeight": 2.0,
            "textPen": 1,
            "onlyDimensionText": false,
            "textPosition": "Below",
            "textDirection": "Horizontal",
            "witnessForm": "Fix",
            "witnessValue": 0.01,
            "marker": { "type": "FullArrow30", "pen": 2, "size": 2.0 },
            "textBox": { "frame": true, "framePen": 2, "opaque": true, "backgroundPen": 1, "justification": "Center" }
          }
        ]
      },
      "save": { "d": "elements[0].elementId.guid" },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "created, and the command read every setting back" }
      ]
    },
    {
      "id": "read as created",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${d}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.measuredAngle", "approx": 0.5235988, "name": "measures 30 degrees" },
        { "path": "detailsOfElements[0].details.onlyDimensionText", "eq": false, "name": "lines shown" },
        { "path": "detailsOfElements[0].details.textPosition", "eq": "Below", "name": "text below the arc" },
        { "path": "detailsOfElements[0].details.textDirection", "eq": "Horizontal", "name": "text horizontal" },
        { "path": "detailsOfElements[0].details.witnessForm", "eq": "Fix", "name": "witness lines with a fixed gap" },
        { "path": "detailsOfElements[0].details.witnessValue", "approx": 0.01, "name": "witness gap" },
        { "path": "detailsOfElements[0].details.marker.type", "eq": "FullArrow30", "name": "marker type" },
        { "path": "detailsOfElements[0].details.marker.pen", "eq": 2, "name": "marker pen" },
        { "path": "detailsOfElements[0].details.marker.size", "approx": 2.0, "name": "marker size" },
        { "path": "detailsOfElements[0].details.textBox.frame", "eq": true, "name": "text framed" },
        { "path": "detailsOfElements[0].details.textBox.framePen", "eq": 2, "name": "frame pen" },
        { "path": "detailsOfElements[0].details.textBox.opaque", "eq": true, "name": "text opaque" },
        { "path": "detailsOfElements[0].details.textBox.backgroundPen", "eq": 1, "name": "background pen" },
        { "path": "detailsOfElements[0].details.textBox.justification", "eq": "Center", "name": "text centered" },
        { "path": "detailsOfElements[0].details.textBox.leaderLineTypeId.guid", "exists": true, "name": "leader line type read" },
        { "path": "detailsOfElements[0].details.textBox.textAngle", "exists": true, "name": "text angle read" }
      ]
    },
    {
      "id": "change the settings again",
      "command": "ModifyAngleDimensions",
      "creates": false,
      "params": {
        "angleDimensionsWithDetails": [
          {
            "elementId": { "guid": "${d}" },
            "textPosition": "Above",
            "textDirection": "Parallel",
            "witnessForm": "Large",
            "witnessValue": 0.02,
            "marker": { "type": "SlashLine45", "size": 3.0 },
            "textBox": {
              "frame": false,
              "opaque": false,
              "justification": "Right",
              "anchorRow": "Last",
              "anchorPoint": "Top",
              "anchorAtTextEnd": true,
              "leaderPen": 3,
              "leaderShape": "Splinear",
              "arrowType": "ClosedArrow30",
              "arrowPen": 4,
              "arrowSize": 2.5
            }
          }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "change accepted and read back by the command" }
      ]
    },
    {
      "id": "read after the change: the given settings changed, the others kept",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${d}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.textPosition", "eq": "Above", "name": "text above the arc" },
        { "path": "detailsOfElements[0].details.textDirection", "eq": "Parallel", "name": "text parallel" },
        { "path": "detailsOfElements[0].details.witnessForm", "eq": "Large", "name": "large witness lines" },
        { "path": "detailsOfElements[0].details.witnessValue", "approx": 0.02, "name": "witness length" },
        { "path": "detailsOfElements[0].details.marker.type", "eq": "SlashLine45", "name": "marker type changed" },
        { "path": "detailsOfElements[0].details.marker.size", "approx": 3.0, "name": "marker size changed" },
        { "path": "detailsOfElements[0].details.marker.pen", "eq": 2, "name": "marker pen kept" },
        { "path": "detailsOfElements[0].details.textBox.frame", "eq": false, "name": "frame off" },
        { "path": "detailsOfElements[0].details.textBox.framePen", "eq": 2, "name": "frame pen kept" },
        { "path": "detailsOfElements[0].details.textBox.opaque", "eq": false, "name": "background off" },
        { "path": "detailsOfElements[0].details.textBox.justification", "eq": "Right", "name": "text right aligned" },
        { "path": "detailsOfElements[0].details.textBox.anchorRow", "eq": "Last", "name": "anchored at the last row" },
        { "path": "detailsOfElements[0].details.textBox.anchorPoint", "eq": "Top", "name": "anchor point" },
        { "path": "detailsOfElements[0].details.textBox.anchorAtTextEnd", "eq": true, "name": "anchored at the text end" },
        { "path": "detailsOfElements[0].details.textBox.leaderPen", "eq": 3, "name": "leader pen" },
        { "path": "detailsOfElements[0].details.textBox.leaderShape", "eq": "Splinear", "name": "spline leader" },
        { "path": "detailsOfElements[0].details.textBox.arrowType", "eq": "ClosedArrow30", "name": "arrow type" },
        { "path": "detailsOfElements[0].details.textBox.arrowPen", "eq": 4, "name": "arrow pen" },
        { "path": "detailsOfElements[0].details.textBox.arrowSize", "approx": 2.5, "name": "arrow size" },
        { "path": "detailsOfElements[0].details.pen", "eq": 1, "name": "line pen kept" },
        { "path": "detailsOfElements[0].details.measuredAngle", "approx": 0.5235988, "name": "still 30 degrees" }
      ]
    },
    {
      "id": "only the dimension text",
      "command": "ModifyAngleDimensions",
      "creates": false,
      "params": {
        "angleDimensionsWithDetails": [ { "elementId": { "guid": "${d}" }, "onlyDimensionText": true } ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "onlyDimensionText accepted" }
      ]
    },
    {
      "id": "read the text-only dimension",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${d}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.onlyDimensionText", "eq": true, "name": "only the text shown" },
        { "path": "detailsOfElements[0].details.textPosition", "eq": "Above", "name": "text position kept" }
      ]
    },
    {
      "id": "a line type that does not exist is refused",
      "command": "ModifyAngleDimensions",
      "creates": false,
      "params": {
        "angleDimensionsWithDetails": [
          { "elementId": { "guid": "${d}" }, "textBox": { "leaderLineTypeId": { "guid": "00000000-0000-0000-0000-00000000BEEF" } } }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": false, "name": "unknown leader line type refused" }
      ]
    },
    {
      "id": "a square root leader is for labels only",
      "command": "ModifyAngleDimensions",
      "creates": false,
      "allowEnvelopeError": true,
      "params": {
        "angleDimensionsWithDetails": [ { "elementId": { "guid": "${d}" }, "textBox": { "leaderShape": "SquareRoot" } } ]
      },
      "expect": [
        { "path": "__envelopeError__", "exists": true, "name": "SquareRoot refused by the schema" }
      ]
    },
    {
      "id": "an unknown text position is refused",
      "command": "ModifyAngleDimensions",
      "creates": false,
      "allowEnvelopeError": true,
      "params": {
        "angleDimensionsWithDetails": [ { "elementId": { "guid": "${d}" }, "textPosition": "Middle" } ]
      },
      "expect": [
        { "path": "__envelopeError__", "exists": true, "name": "textPosition Middle refused by the schema" }
      ]
    },
    {
      "id": "the refused changes changed nothing",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${d}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.textBox.leaderShape", "eq": "Splinear", "name": "leader shape still Splinear" },
        { "path": "detailsOfElements[0].details.textPosition", "eq": "Above", "name": "text position still Above" }
      ]
    }
  ]
}
