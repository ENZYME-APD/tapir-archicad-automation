{
  "title": "CreateHatches takes the fill orientation, fill category, contour line type, transparent or window background and zone area percentage, GetDetailsOfElements reads them back and SetDetailsOfElements changes them (#2665)",
  "minTapir": "2.0.1",
  "requiresEmpty": [ "Hatch" ],
  "steps": [
    {
      "id": "a vector fill, so the fill orientation is kept",
      "command": "CreateFills",
      "creates": false,
      "params": {
        "fillDataArray": [
          {
            "name": "Tapir check hatch settings fill",
            "subType": "Vector",
            "scaleWithPlan": true,
            "useForWalls": true,
            "useForDraft": true,
            "useForCover": true,
            "horizontalSpacing": 1.0,
            "verticalSpacing": 1.0,
            "angle": 0.0,
            "bitPattern": "AA55AA55AA55AA55",
            "lineItems": [
              { "frequency": 0.2, "direction": 0.7853981633974483, "offsetLine": 0.0, "offset": { "x": 0.0, "y": 0.0 } }
            ]
          }
        ],
        "overwriteExisting": false
      },
      "save": { "fill": "attributeIds[0].attributeId.guid" },
      "expect": [ { "path": "attributeIds[0].attributeId.guid", "exists": true, "name": "vector fill created" } ]
    },
    {
      "id": "two line types for the contour",
      "command": "CreateLines",
      "creates": false,
      "params": {
        "lineDataArray": [
          {
            "name": "Tapir check hatch contour dashed",
            "scaleWithPlan": false,
            "defineScale": 1.0,
            "lineType": "Dashed",
            "period": 4.0,
            "dashItems": [ { "dash": 2.0, "gap": 1.0 }, { "dash": 0.5, "gap": 0.5 } ]
          },
          {
            "name": "Tapir check hatch contour solid",
            "scaleWithPlan": true,
            "defineScale": 100.0,
            "lineType": "Solid"
          }
        ],
        "overwriteExisting": false
      },
      "save": { "lineDashed": "attributeIds[0].attributeId.guid", "lineSolid": "attributeIds[1].attributeId.guid" },
      "expect": [
        { "path": "attributeIds[0].attributeId.guid", "exists": true, "name": "dashed line type created" },
        { "path": "attributeIds[1].attributeId.guid", "exists": true, "name": "solid line type created" }
      ]
    },
    {
      "id": "two hatches with every new setting in one call",
      "command": "CreateHatches",
      "params": {
        "hatchesData": [
          {
            "coordinates": [ { "x": 900.0, "y": 900.0 }, { "x": 904.0, "y": 900.0 }, { "x": 904.0, "y": 904.0 }, { "x": 900.0, "y": 904.0 } ],
            "floorInd": 0,
            "fillId": { "guid": "${fill}" },
            "contourPenIndex": 5,
            "contourLineTypeId": { "guid": "${lineDashed}" },
            "fillPenIndex": 4,
            "fillBackgroundPenIndex": 0,
            "roomSpecial": 40,
            "fillCategory": "Cut",
            "fillOrientation": {
              "type": "Distorted",
              "origin": { "x": 900.5, "y": 900.25 },
              "matrix00": 0.0, "matrix10": 1.0, "matrix01": -1.0, "matrix11": 0.0
            }
          },
          {
            "coordinates": [ { "x": 910.0, "y": 900.0 }, { "x": 914.0, "y": 900.0 }, { "x": 914.0, "y": 904.0 }, { "x": 910.0, "y": 904.0 } ],
            "floorInd": 0,
            "fillId": { "guid": "${fill}" },
            "contourPenIndex": 0,
            "contourLineTypeId": { "guid": "${lineSolid}" },
            "fillPenIndex": 4,
            "fillBackgroundPenIndex": -1,
            "roomSpecial": -1,
            "fillCategory": "Cover",
            "fillOrientation": { "origin": { "x": 910.5, "y": 900.75 } }
          }
        ]
      },
      "save": { "h1": "elements[0].elementId.guid", "h2": "elements[1].elementId.guid" },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "oriented cut-fill hatch created in one call (was refused with 4002)" },
        { "path": "elements[1].elementId.guid", "exists": true, "name": "cover-fill hatch without contour created" }
      ]
    },
    {
      "id": "read the new settings back",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${h1}" } }, { "elementId": { "guid": "${h2}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.fillCategory", "eq": "Cut", "name": "fill category Cut applied" },
        { "path": "detailsOfElements[0].details.contourPenIndex", "eq": 5, "name": "contour pen 5 applied" },
        { "path": "detailsOfElements[0].details.contourLineTypeId.guid", "eq": "${lineDashed}", "name": "dashed contour line type applied" },
        { "path": "detailsOfElements[0].details.fillBackgroundPenIndex", "eq": 0, "name": "transparent background applied" },
        { "path": "detailsOfElements[0].details.roomSpecial", "eq": 40, "name": "40 % subtracted from the zone area" },
        { "path": "detailsOfElements[0].details.fillOrientation.type", "eq": "Distorted", "name": "orientation type applied on create" },
        { "path": "detailsOfElements[0].details.fillOrientation.origin.x", "approx": 900.5, "name": "orientation origin x applied on create" },
        { "path": "detailsOfElements[0].details.fillOrientation.origin.y", "approx": 900.25, "name": "orientation origin y applied on create" },
        { "path": "detailsOfElements[0].details.fillOrientation.matrix10", "approx": 1.0, "name": "orientation matrix10 applied on create" },
        { "path": "detailsOfElements[0].details.fillOrientation.matrix01", "approx": -1.0, "name": "orientation matrix01 applied on create" },
        { "path": "detailsOfElements[1].details.fillCategory", "eq": "Cover", "name": "fill category Cover applied" },
        { "path": "detailsOfElements[1].details.contourPenIndex", "eq": 0, "name": "contour switched off" },
        { "path": "detailsOfElements[1].details.contourLineTypeId.guid", "eq": "${lineSolid}", "name": "solid contour line type applied" },
        { "path": "detailsOfElements[1].details.fillBackgroundPenIndex", "eq": -1, "name": "window background applied" },
        { "path": "detailsOfElements[1].details.roomSpecial", "lt": 0, "name": "zone area subtraction off" },
        { "path": "detailsOfElements[1].details.fillOrientation.type", "ne": "Global", "name": "a given origin detaches a Global fill" },
        { "path": "detailsOfElements[1].details.fillOrientation.origin.x", "approx": 910.5, "name": "origin-only orientation x applied" },
        { "path": "detailsOfElements[1].details.fillOrientation.origin.y", "approx": 900.75, "name": "origin-only orientation y applied" }
      ]
    },
    {
      "id": "change category, contour line type, contour and background",
      "command": "SetDetailsOfElements",
      "creates": false,
      "params": {
        "elementsWithDetails": [
          {
            "elementId": { "guid": "${h1}" },
            "details": { "typeSpecificDetails": { "fillCategory": "Drafting", "contourLineTypeId": { "guid": "${lineSolid}" }, "fillBackgroundPenIndex": -1 } }
          },
          {
            "elementId": { "guid": "${h2}" },
            "details": { "typeSpecificDetails": { "fillCategory": "Cut", "contourPenIndex": 3, "contourLineTypeId": { "guid": "${lineDashed}" }, "fillBackgroundPenIndex": 0, "roomSpecial": 100 } }
          }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true },
        { "path": "executionResults[1].success", "eq": true }
      ]
    },
    {
      "id": "read the changed settings back",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${h1}" } }, { "elementId": { "guid": "${h2}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.fillCategory", "eq": "Drafting", "name": "fill category changed to Drafting" },
        { "path": "detailsOfElements[0].details.contourLineTypeId.guid", "eq": "${lineSolid}", "name": "contour line type changed" },
        { "path": "detailsOfElements[0].details.fillBackgroundPenIndex", "eq": -1, "name": "background changed to the window background" },
        { "path": "detailsOfElements[0].details.contourPenIndex", "eq": 5, "name": "contour pen kept" },
        { "path": "detailsOfElements[0].details.fillOrientation.type", "eq": "Distorted", "name": "orientation kept" },
        { "path": "detailsOfElements[1].details.fillCategory", "eq": "Cut", "name": "fill category changed to Cut" },
        { "path": "detailsOfElements[1].details.contourPenIndex", "eq": 3, "name": "contour switched on with pen 3" },
        { "path": "detailsOfElements[1].details.contourLineTypeId.guid", "eq": "${lineDashed}", "name": "contour line type changed to dashed" },
        { "path": "detailsOfElements[1].details.fillBackgroundPenIndex", "eq": 0, "name": "background changed to transparent" },
        { "path": "detailsOfElements[1].details.roomSpecial", "eq": 100, "name": "100 % subtracted from the zone area" }
      ]
    }
  ],
  "teardown": [
    { "command": "DeleteElements", "params": { "elements": [ { "elementId": { "guid": "${h1}" } }, { "elementId": { "guid": "${h2}" } } ] } },
    {
      "command": "DeleteAttributes",
      "params": { "attributesToDelete": [ { "attributeType": "Line", "attributeId": { "attributeId": { "guid": "${lineDashed}" } } } ] }
    },
    {
      "command": "DeleteAttributes",
      "params": { "attributesToDelete": [ { "attributeType": "Line", "attributeId": { "attributeId": { "guid": "${lineSolid}" } } } ] }
    },
    {
      "command": "DeleteAttributes",
      "params": { "attributesToDelete": [ { "attributeType": "Fill", "attributeId": { "attributeId": { "guid": "${fill}" } } } ] }
    }
  ]
}
