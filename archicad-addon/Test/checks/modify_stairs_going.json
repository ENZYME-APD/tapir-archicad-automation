{
  "title": "ModifyStairs lays a stair out with a new going (treadDepth) (#2525)",
  "minTapir": "2.0.1",
  "steps": [
    {
      "id": "going property id",
      "command": "API.GetPropertyIds",
      "creates": false,
      "params": { "properties": [ { "type": "BuiltIn", "nonLocalizedName": "Stair_DefaultGoing" } ] },
      "save": { "goingId": "properties[0].propertyId.guid" },
      "expect": [
        { "path": "properties[0].propertyId.guid", "exists": true, "name": "Stair_DefaultGoing found" }
      ]
    },
    {
      "id": "stair with a 0.28 going",
      "command": "CreateStairs",
      "params": {
        "stairsData": [
          {
            "baseLinePoints": [ { "x": 760.0, "y": 700.0 }, { "x": 766.0, "y": 700.0 } ],
            "baselinePosition": "Center",
            "zCoordinate": 0.0,
            "floorIndex": 0,
            "totalHeight": 2.8,
            "flightWidth": 1.2,
            "treadDepth": 0.28
          }
        ]
      },
      "save": { "s": "elements[0].elementId.guid" },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "stair created" }
      ]
    },
    {
      "id": "the going as created",
      "command": "GetPropertyValuesOfElements",
      "creates": false,
      "params": {
        "elements": [ { "elementId": { "guid": "${s}" } } ],
        "properties": [ { "propertyId": { "guid": "${goingId}" } } ]
      },
      "expect": [
        { "path": "propertyValuesForElements[0].propertyValues[0].propertyValue.value", "approx": 0.28, "tol": 0.005, "name": "going 0.28 as created" }
      ]
    },
    {
      "id": "change the going to 0.26",
      "command": "ModifyStairs",
      "creates": false,
      "params": {
        "stairsWithDetails": [ { "elementId": { "guid": "${s}" }, "treadDepth": 0.26 } ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "accepted" }
      ]
    },
    {
      "id": "the going after ModifyStairs",
      "command": "GetPropertyValuesOfElements",
      "creates": false,
      "params": {
        "elements": [ { "elementId": { "guid": "${s}" } } ],
        "properties": [ { "propertyId": { "guid": "${goingId}" } } ]
      },
      "expect": [
        { "path": "propertyValuesForElements[0].propertyValues[0].propertyValue.value", "approx": 0.26, "tol": 0.005, "name": "going changed to 0.26" }
      ]
    },
    {
      "id": "the rest of the stair is kept",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${s}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.totalHeight", "approx": 2.8, "name": "total height kept" },
        { "path": "detailsOfElements[0].details.flightWidth", "approx": 1.2, "name": "flight width kept" },
        { "path": "detailsOfElements[0].details.baseLinePoints[0].x", "approx": 760.0, "name": "baseline start kept" }
      ]
    }
  ]
}
