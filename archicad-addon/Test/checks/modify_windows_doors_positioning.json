{
  "title": "Windows and doors: sill anchor, sub-floor thickness, reveal anchor, surface, plane and fix point are read, created, modified and read back (#2575)",
  "minTapir": "2.0.1",
  "steps": [
    {
      "id": "host wall",
      "command": "CreateWalls",
      "params": {
        "wallsData": [
          {
            "begCoordinate": { "x": 940.0, "y": 940.0 },
            "endCoordinate": { "x": 948.0, "y": 940.0 },
            "zCoordinate": 0.0,
            "height": 3.0,
            "thickness": 0.3
          }
        ]
      },
      "save": {
        "wall": "elements[0].elementId.guid"
      }
    },
    {
      "id": "a surface",
      "command": "GetAttributesByType",
      "creates": false,
      "params": { "attributeType": "Surface" },
      "save": { "surface": "attributes[1].attributeId.guid" }
    },
    {
      "id": "window anchored to the story",
      "command": "CreateWindows",
      "params": {
        "windowsData": [
          {
            "ownerWallId": { "guid": "${wall}" },
            "centerOffset": 1.5,
            "sillHeight": 0.9,
            "width": 1.0,
            "height": 1.2,
            "verticalLink": "SillToStory",
            "verticalLinkStoryIndex": 0,
            "subFloorThickness": 0.15
          }
        ]
      },
      "save": {
        "window": "elements[0].elementId.guid"
      },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "window created" }
      ]
    },
    {
      "id": "door",
      "command": "CreateDoors",
      "params": {
        "doorsData": [
          {
            "ownerWallId": { "guid": "${wall}" },
            "centerOffset": 5.5,
            "sillHeight": 0.0,
            "width": 0.9,
            "height": 2.1
          }
        ]
      },
      "save": {
        "door": "elements[0].elementId.guid"
      },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "door created" }
      ]
    },
    {
      "id": "read as created",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": {
        "elements": [
          { "elementId": { "guid": "${window}" } },
          { "elementId": { "guid": "${door}" } }
        ]
      },
      "expect": [
        { "path": "detailsOfElements[0].details.verticalLink", "eq": "SillToStory", "name": "window created anchored to a story" },
        { "path": "detailsOfElements[0].details.verticalLinkStoryIndex", "eq": 0, "name": "window anchored to story 0" },
        { "path": "detailsOfElements[0].details.subFloorThickness", "approx": 0.15, "name": "window created with the sub-floor thickness" },
        { "path": "detailsOfElements[0].details.revealDepthLocation", "exists": true, "name": "window reveal anchor read" },
        { "path": "detailsOfElements[0].details.directionType", "exists": true, "name": "window plane read" },
        { "path": "detailsOfElements[0].details.fixPoint", "exists": true, "name": "window fix point read" },
        { "path": "detailsOfElements[0].details.useObjectMaterials", "exists": true, "name": "window surface override read" },
        { "path": "detailsOfElements[0].details.revealDepthFromSide", "exists": true, "name": "window computed reveal depth read" },
        { "path": "detailsOfElements[0].details.startPoint.x", "exists": true, "name": "window start point read" },
        { "path": "detailsOfElements[1].details.verticalLink", "exists": true, "name": "door anchor read" },
        { "path": "detailsOfElements[1].details.subFloorThickness", "exists": true, "name": "door sub-floor thickness read" }
      ]
    },
    {
      "id": "modify window",
      "command": "ModifyWindows",
      "creates": false,
      "params": {
        "windowsWithDetails": [
          {
            "elementId": { "guid": "${window}" },
            "verticalLink": "HeaderToWallBottom",
            "subFloorThickness": 0.05,
            "revealDepthLocation": "Core",
            "useObjectMaterials": false,
            "surfaceId": { "guid": "${surface}" },
            "directionType": "Vertical",
            "fixPoint": "Beginning"
          }
        ]
      },
      "expect": [
        { "path": "executionResults", "len": 1, "name": "one result" },
        { "path": "executionResults[0].success", "eq": true, "name": "window modified and every setting read back" }
      ]
    },
    {
      "id": "modify door",
      "command": "ModifyDoors",
      "creates": false,
      "params": {
        "doorsWithDetails": [
          {
            "elementId": { "guid": "${door}" },
            "verticalLink": "HeaderToStory",
            "verticalLinkStoryIndex": 0,
            "subFloorThickness": 0.1
          }
        ]
      },
      "expect": [
        { "path": "executionResults", "len": 1, "name": "one result" },
        { "path": "executionResults[0].success", "eq": true, "name": "door modified and every setting read back" }
      ]
    },
    {
      "id": "read back the changes",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": {
        "elements": [
          { "elementId": { "guid": "${window}" } },
          { "elementId": { "guid": "${door}" } }
        ]
      },
      "expect": [
        { "path": "detailsOfElements[0].details.verticalLink", "eq": "HeaderToWallBottom", "name": "window anchored to the wall bottom by its header" },
        { "path": "detailsOfElements[0].details.verticalLinkStoryIndex", "exists": false, "name": "no story index for a wall anchor" },
        { "path": "detailsOfElements[0].details.subFloorThickness", "approx": 0.05, "name": "window sub-floor thickness changed" },
        { "path": "detailsOfElements[0].details.revealDepthLocation", "eq": "Core", "name": "window reveal anchored to the core" },
        { "path": "detailsOfElements[0].details.useObjectMaterials", "eq": false, "name": "window surface override on" },
        { "path": "detailsOfElements[0].details.surfaceId.guid", "eq": "${surface}", "name": "window surface changed" },
        { "path": "detailsOfElements[0].details.directionType", "eq": "Vertical", "name": "window plane vertical" },
        { "path": "detailsOfElements[0].details.fixPoint", "eq": "Beginning", "name": "window fix point at the beginning" },
        { "path": "detailsOfElements[0].details.width", "approx": 1.0, "name": "window width not sent, kept" },
        { "path": "detailsOfElements[1].details.verticalLink", "eq": "HeaderToStory", "name": "door anchored to a story by its header" },
        { "path": "detailsOfElements[1].details.verticalLinkStoryIndex", "eq": 0, "name": "door anchored to story 0" },
        { "path": "detailsOfElements[1].details.subFloorThickness", "approx": 0.1, "name": "door sub-floor thickness changed" }
      ]
    },
    {
      "id": "bad window input",
      "command": "ModifyWindows",
      "creates": false,
      "params": {
        "windowsWithDetails": [
          {
            "elementId": { "guid": "${window}" },
            "subFloorThickness": 0.2,
            "verticalLinkStoryIndex": 0
          },
          {
            "elementId": { "guid": "${window}" },
            "subFloorThickness": 0.2,
            "verticalLink": "SillToStory",
            "verticalLinkStoryIndex": 999
          },
          {
            "elementId": { "guid": "${window}" },
            "subFloorThickness": 0.2,
            "surfaceId": { "guid": "00000000-0000-0000-0000-00000000BEEF" }
          }
        ]
      },
      "expect": [
        { "path": "executionResults", "len": 3, "name": "one result per item" },
        { "path": "executionResults[0].success", "eq": false, "name": "story index without a story anchor refused" },
        { "path": "executionResults[1].success", "eq": false, "name": "nonexistent story refused" },
        { "path": "executionResults[2].success", "eq": false, "name": "nonexistent surface refused" },
        { "path": "executionResults[2].error.message", "exists": true, "name": "surface error has a message" }
      ]
    },
    {
      "id": "bad input changed nothing",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": {
        "elements": [
          { "elementId": { "guid": "${window}" } }
        ]
      },
      "expect": [
        { "path": "detailsOfElements[0].details.verticalLink", "eq": "HeaderToWallBottom", "name": "window anchor unchanged" },
        { "path": "detailsOfElements[0].details.subFloorThickness", "approx": 0.05, "name": "window sub-floor thickness unchanged" },
        { "path": "detailsOfElements[0].details.surfaceId.guid", "eq": "${surface}", "name": "window surface unchanged" }
      ]
    }
  ]
}
