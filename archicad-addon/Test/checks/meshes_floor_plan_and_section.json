{
  "title": "CreateMeshes, ModifyMeshes and GetDetailsOfElements write and read the floor plan and section settings of a mesh: story visibility, cut fill pens, section contour pen and cover fill (#2630)",
  "minTapir": "2.0.1",
  "requiresEmpty": [ "Mesh" ],
  "steps": [
    {
      "id": "two fills of the project",
      "command": "GetAttributesByType",
      "creates": false,
      "params": { "attributeType": "Fill" },
      "save": {
        "fillA": "attributes[1].attributeId.guid",
        "fillB": "attributes[2].attributeId.guid"
      },
      "expect": [
        { "path": "attributes[2].attributeId.guid", "exists": true, "name": "the project has three fills" }
      ]
    },
    {
      "id": "a solid mesh with floor plan settings, and a mesh with an unknown cover fill",
      "command": "CreateMeshes",
      "params": {
        "meshesData": [
          {
            "floorIndex": 0,
            "level": 0.0,
            "skirtType": "SolidBodyWithSkirt",
            "skirtLevel": 0.5,
            "visibility": { "showOnHome": true, "showAllAbove": false, "showRelAbove": 1, "showAllBelow": false, "showRelBelow": 0 },
            "fillVisibility": { "showOnHome": true, "showAllAbove": false, "showRelAbove": 0, "showAllBelow": false, "showRelBelow": 0 },
            "cutFillPen": { "overridden": true, "penIndex": 5 },
            "cutFillBackgroundPen": { "overridden": true, "penIndex": 6 },
            "sectionContourPen": 7,
            "floorFill": { "use": true, "foregroundPen": 11, "backgroundPen": 12, "fillId": { "guid": "${fillA}" } },
            "polygonCoordinates": [
              { "x": 1060.0, "y": 760.0, "z": 0.0 },
              { "x": 1064.0, "y": 760.0, "z": 0.2 },
              { "x": 1064.0, "y": 764.0, "z": 0.4 },
              { "x": 1060.0, "y": 764.0, "z": 0.1 }
            ]
          },
          {
            "floorIndex": 0,
            "floorFill": { "fillId": { "guid": "00000000-0000-0000-0000-00000000BEEF" } },
            "polygonCoordinates": [
              { "x": 1070.0, "y": 760.0, "z": 0.0 },
              { "x": 1074.0, "y": 760.0, "z": 0.0 },
              { "x": 1074.0, "y": 764.0, "z": 0.0 }
            ]
          }
        ]
      },
      "save": { "m1": "elements[0].elementId.guid" },
      "expect": [
        { "path": "elements", "len": 2, "name": "one answer per item" },
        { "path": "elements[0].elementId.guid", "exists": true, "name": "mesh created" },
        { "path": "elements[1].error.code", "exists": true, "name": "an unknown cover fill is refused" }
      ]
    },
    {
      "id": "read the new mesh back",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${m1}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.visibility.showOnHome", "eq": true },
        { "path": "detailsOfElements[0].details.visibility.showRelAbove", "eq": 1, "name": "contour shown one story above" },
        { "path": "detailsOfElements[0].details.fillVisibility.showRelAbove", "eq": 0, "name": "cover fill on the home story only" },
        { "path": "detailsOfElements[0].details.cutFillPen.overridden", "eq": true },
        { "path": "detailsOfElements[0].details.cutFillPen.penIndex", "eq": 5 },
        { "path": "detailsOfElements[0].details.cutFillBackgroundPen.overridden", "eq": true },
        { "path": "detailsOfElements[0].details.cutFillBackgroundPen.penIndex", "eq": 6 },
        { "path": "detailsOfElements[0].details.sectionContourPen", "eq": 7 },
        { "path": "detailsOfElements[0].details.floorFill.use", "eq": true },
        { "path": "detailsOfElements[0].details.floorFill.foregroundPen", "eq": 11 },
        { "path": "detailsOfElements[0].details.floorFill.backgroundPen", "eq": 12 },
        { "path": "detailsOfElements[0].details.floorFill.fillId.guid", "eq": "${fillA}" },
        { "path": "detailsOfElements[0].details.skirtLevel", "approx": 0.5, "name": "skirt level kept" }
      ]
    },
    {
      "id": "change the floor plan settings of the mesh; a refused item with an unknown fill",
      "command": "ModifyMeshes",
      "creates": false,
      "params": {
        "meshesData": [
          {
            "elementId": { "guid": "${m1}" },
            "meshData": {
              "visibility": { "showAllAbove": true },
              "fillVisibility": { "showRelAbove": 2 },
              "cutFillPen": { "overridden": false },
              "cutFillBackgroundPen": { "overridden": true, "penIndex": 16 },
              "sectionContourPen": 17,
              "floorFill": {
                "foregroundPen": 21,
                "fillId": { "guid": "${fillB}" },
                "useLocalOrigin": true,
                "localOrigin": { "x": 1061.0, "y": 761.0 },
                "angle": 0.5
              }
            }
          },
          {
            "elementId": { "guid": "${m1}" },
            "meshData": {
              "sectionContourPen": 3,
              "floorFill": { "fillId": { "guid": "00000000-0000-0000-0000-00000000BEEF" } }
            }
          }
        ]
      },
      "expect": [
        { "path": "executionResults", "len": 2, "name": "one result per item" },
        { "path": "executionResults[0].success", "eq": true, "name": "floor plan settings written" },
        { "path": "executionResults[1].success", "eq": false, "name": "an unknown cover fill is refused" }
      ]
    },
    {
      "id": "read the modified mesh back",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${m1}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.visibility.showAllAbove", "eq": true, "name": "contour shown on all stories above" },
        { "path": "detailsOfElements[0].details.visibility.showOnHome", "eq": true, "name": "omitted visibility fields kept" },
        { "path": "detailsOfElements[0].details.fillVisibility.showRelAbove", "eq": 2, "name": "cover fill shown two stories above" },
        { "path": "detailsOfElements[0].details.cutFillPen.overridden", "eq": false, "name": "cut fill pen override cleared" },
        { "path": "detailsOfElements[0].details.cutFillBackgroundPen.overridden", "eq": true },
        { "path": "detailsOfElements[0].details.cutFillBackgroundPen.penIndex", "eq": 16 },
        { "path": "detailsOfElements[0].details.sectionContourPen", "eq": 17, "name": "section contour pen written (the refused item changed nothing)" },
        { "path": "detailsOfElements[0].details.floorFill.use", "eq": true, "name": "omitted cover fill fields kept" },
        { "path": "detailsOfElements[0].details.floorFill.foregroundPen", "eq": 21 },
        { "path": "detailsOfElements[0].details.floorFill.backgroundPen", "eq": 12, "name": "omitted background pen kept" },
        { "path": "detailsOfElements[0].details.floorFill.fillId.guid", "eq": "${fillB}" },
        { "path": "detailsOfElements[0].details.floorFill.useLocalOrigin", "eq": true },
        { "path": "detailsOfElements[0].details.floorFill.localOrigin.x", "approx": 1061.0 },
        { "path": "detailsOfElements[0].details.floorFill.localOrigin.y", "approx": 761.0 },
        { "path": "detailsOfElements[0].details.floorFill.angle", "approx": 0.5 },
        { "path": "detailsOfElements[0].details.polygonCoordinates[2].z", "approx": 0.4, "name": "outline kept" }
      ]
    }
  ]
}
