{
  "title": "Zones: polygon display (gross/net), uniform stamp pen and reduce area by % in CreateZones, ModifyZones, SetDetailsOfElements and GetDetailsOfElements (#2631 part 5)",
  "minTapir": "2.0.1",
  "steps": [
    {
      "id": "zone created with the new settings",
      "command": "CreateZones",
      "params": {
        "zonesData": [
          {
            "name": "TapirCheck display zone",
            "numberStr": "D1",
            "floorIndex": 0,
            "polygonDisplay": "Net",
            "stampPen": { "uniform": true, "pen": 7 },
            "reducePercent": 25.0,
            "geometry": {
              "polygonCoordinates": [
                { "x": 940.0, "y": 760.0 },
                { "x": 944.0, "y": 760.0 },
                { "x": 944.0, "y": 763.0 },
                { "x": 940.0, "y": 763.0 }
              ]
            }
          }
        ]
      },
      "save": { "z1": "elements[0].elementId.guid" },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "zone created, the new keys accepted" }
      ]
    },
    {
      "id": "read the new zone",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${z1}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.polygonDisplay", "eq": "Net" },
        { "path": "detailsOfElements[0].details.stampPen.uniform", "eq": true },
        { "path": "detailsOfElements[0].details.stampPen.pen", "eq": 7 },
        { "path": "detailsOfElements[0].details.reducePercent", "approx": 25.0 }
      ]
    },
    {
      "id": "modify them; only the given fields change",
      "command": "ModifyZones",
      "creates": false,
      "params": {
        "zonesWithDetails": [
          {
            "elementId": { "guid": "${z1}" },
            "polygonDisplay": "Gross",
            "stampPen": { "pen": 9 },
            "reducePercent": 10.0
          }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "zone modified" }
      ]
    },
    {
      "id": "read the modified zone",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${z1}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.polygonDisplay", "eq": "Gross" },
        { "path": "detailsOfElements[0].details.stampPen.uniform", "eq": true, "name": "uniform kept" },
        { "path": "detailsOfElements[0].details.stampPen.pen", "eq": 9 },
        { "path": "detailsOfElements[0].details.reducePercent", "approx": 10.0 },
        { "path": "detailsOfElements[0].details.name", "eq": "TapirCheck display zone", "name": "name kept" }
      ]
    },
    {
      "id": "SetDetailsOfElements takes the same keys",
      "command": "SetDetailsOfElements",
      "creates": false,
      "params": {
        "elementsWithDetails": [
          {
            "elementId": { "guid": "${z1}" },
            "details": { "typeSpecificDetails": { "stampPen": { "uniform": false }, "reducePercent": 0.0 } }
          }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "zone changed" }
      ]
    },
    {
      "id": "read the zone again",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${z1}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.stampPen.uniform", "eq": false },
        { "path": "detailsOfElements[0].details.stampPen.pen", "eq": 9, "name": "pen kept" },
        { "path": "detailsOfElements[0].details.reducePercent", "approx": 0.0 },
        { "path": "detailsOfElements[0].details.polygonDisplay", "eq": "Gross", "name": "polygon display kept" }
      ]
    }
  ]
}
