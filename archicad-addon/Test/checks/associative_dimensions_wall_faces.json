{
  "title": "CreateAssociativeDimensions on wall faces: a perpendicular dimension is created, oblique ones get an error instead of an elementId (#2505)",
  "minTapir": "2.0.1",
  "steps": [
    {
      "id": "a straight wall along y, 0.30 m thick",
      "command": "CreateWalls",
      "params": {
        "wallsData": [
          { "begCoordinate": { "x": 700.0, "y": 700.0 }, "endCoordinate": { "x": 700.0, "y": 706.0 }, "zCoordinate": 0.0, "height": 3.0, "thickness": 0.3 }
        ]
      },
      "save": { "w": "elements[0].elementId.guid" },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "wall created" }
      ]
    },
    {
      "id": "perpendicular, 0.02 degrees and 1 degree off the face normal",
      "command": "CreateAssociativeDimensions",
      "params": {
        "dimensionsData": [
          {
            "referencePoint": { "x": 699.0, "y": 703.0 },
            "direction": { "x": 1.0, "y": 0.0 },
            "floorIndex": 0,
            "witnessPoints": [
              { "elementId": { "guid": "${w}" }, "line": true, "inIndex": 20 },
              { "elementId": { "guid": "${w}" }, "line": true, "inIndex": 10 }
            ]
          },
          {
            "referencePoint": { "x": 699.0, "y": 702.0 },
            "direction": { "x": 1.0, "y": 0.000349 },
            "floorIndex": 0,
            "witnessPoints": [
              { "elementId": { "guid": "${w}" }, "line": true, "inIndex": 20 },
              { "elementId": { "guid": "${w}" }, "line": true, "inIndex": 10 }
            ]
          },
          {
            "referencePoint": { "x": 699.0, "y": 701.0 },
            "direction": { "x": 1.0, "y": 0.017455 },
            "floorIndex": 0,
            "witnessPoints": [
              { "elementId": { "guid": "${w}" }, "line": true, "inIndex": 20 },
              { "elementId": { "guid": "${w}" }, "line": true, "inIndex": 10 }
            ]
          }
        ]
      },
      "save": { "d": "elements[0].elementId.guid" },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "perpendicular dimension created" },
        { "path": "elements[1].elementId", "exists": false, "name": "0.02 degrees: no elementId of a dimension Archicad removes" },
        { "path": "elements[1].error.code", "exists": true, "name": "0.02 degrees: an error instead" },
        { "path": "elements[2].elementId", "exists": false, "name": "1 degree: no elementId" },
        { "path": "elements[2].error.code", "exists": true, "name": "1 degree: an error" }
      ]
    },
    {
      "id": "the perpendicular dimension exists",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${d}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].type", "eq": "Dimension", "name": "a dimension" },
        { "path": "detailsOfElements[0].details.witnessPointCount", "eq": 2, "name": "two witness points" }
      ]
    },
    {
      "id": "only that one dimension is in the project",
      "command": "API.GetElementsByType",
      "creates": false,
      "params": { "elementType": "Dimension" },
      "expect": [
        { "path": "elements", "len": 1, "name": "no leftover dimension" }
      ]
    }
  ]
}
