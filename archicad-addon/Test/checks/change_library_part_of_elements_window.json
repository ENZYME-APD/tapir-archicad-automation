{
  "title": "ChangeLibraryPartOfElements still resolves a window's own part by name after the Wall End support (#2634)",
  "minTapir": "1.8.0",
  "steps": [
    {
      "id": "host wall",
      "command": "CreateWalls",
      "params": {
        "wallsData": [
          {
            "begCoordinate": { "x": 960.0, "y": 960.0 },
            "endCoordinate": { "x": 966.0, "y": 960.0 },
            "zCoordinate": 0.0,
            "height": 3.0,
            "thickness": 0.3
          }
        ]
      },
      "save": {
        "wall": "elements[0].elementId.guid"
      }
    },
    {
      "id": "window",
      "command": "CreateWindows",
      "params": {
        "windowsData": [
          {
            "ownerWallId": { "guid": "${wall}" },
            "centerOffset": 3.0,
            "sillHeight": 0.9,
            "width": 1.0,
            "height": 1.2
          }
        ]
      },
      "save": {
        "window": "elements[0].elementId.guid"
      },
      "expect": [
        {
          "path": "elements[0].elementId.guid",
          "exists": true,
          "name": "window created"
        }
      ]
    },
    {
      "id": "window part",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": {
        "elements": [
          { "elementId": { "guid": "${window}" } }
        ]
      },
      "save": {
        "partName": "detailsOfElements[0].details.libPart.name"
      },
      "expect": [
        {
          "path": "detailsOfElements[0].details.libPart.name",
          "exists": true,
          "name": "window has a library part"
        }
      ]
    },
    {
      "id": "change to its own part",
      "command": "ChangeLibraryPartOfElements",
      "creates": false,
      "params": {
        "elementsWithLibraryPart": [
          {
            "elementId": { "guid": "${window}" },
            "libraryPart": { "name": "${partName}" },
            "keepParameters": true,
            "keepSize": true
          }
        ]
      },
      "expect": [
        {
          "path": "executionResults[0].success",
          "eq": true,
          "name": "a window (not a wall end) still finds its window part"
        }
      ]
    },
    {
      "id": "change to a nonexistent part",
      "command": "ChangeLibraryPartOfElements",
      "creates": false,
      "params": {
        "elementsWithLibraryPart": [
          {
            "elementId": { "guid": "${window}" },
            "libraryPart": { "name": "No Such Library Part 2634" }
          }
        ]
      },
      "expect": [
        {
          "path": "executionResults[0].success",
          "eq": false,
          "name": "an unknown part is refused"
        }
      ]
    }
  ]
}
