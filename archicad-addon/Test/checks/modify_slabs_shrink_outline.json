        {
          "path": "detailsOfElements[0].details.polygonOutline[1].x",
          "approx": 964.104,
          "name": "20 -> 8: the new points"
        },
        {
          "path": "detailsOfElements[1].details.polygonOutline",
          "len": 5,
          "name": "11 -> 4: four points and the closing one"
        },
        {
          "path": "detailsOfElements[1].details.polygonOutline[0].y",
          "approx": 1018.26,
          "name": "11 -> 4: the new points"
        },
        {
          "path": "detailsOfElements[2].details.polygonOutline",
          "len": 9,
          "name": "11 -> 8: eight points and the closing one"
