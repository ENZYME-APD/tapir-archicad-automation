{
  "title": "ModifyZones changes the polygon and holes of a manual zone in place, keeping its GUID and settings, and refuses a new polygon that overlaps another zone",
  "minTapir": "2.0.1",
  "steps": [
    {
      "id": "manual zone A",
      "command": "CreateZones",
      "params": {
        "zonesData": [
          {
            "name": "TapirCheck polygon A",
            "numberStr": "PA",
            "floorIndex": 0,
            "stampPosition": { "x": 801.0, "y": 801.0 },
            "height": 2.6,
            "geometry": {
              "polygonCoordinates": [
                { "x": 800.0, "y": 800.0 },
                { "x": 804.0, "y": 800.0 },
                { "x": 804.0, "y": 803.0 },
                { "x": 800.0, "y": 803.0 }
              ]
            }
          }
        ]
      },
      "save": { "za": "elements[0].elementId.guid" },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "zone A created" }
      ]
    },
    {
      "id": "manual zone B, well away from A",
      "command": "CreateZones",
      "params": {
        "zonesData": [
          {
            "name": "TapirCheck polygon B",
            "numberStr": "PB",
            "floorIndex": 0,
            "stampPosition": { "x": 821.0, "y": 801.0 },
            "geometry": {
              "polygonCoordinates": [
                { "x": 820.0, "y": 800.0 },
                { "x": 824.0, "y": 800.0 },
                { "x": 824.0, "y": 803.0 },
                { "x": 820.0, "y": 803.0 }
              ]
            }
          }
        ]
      },
      "save": { "zb": "elements[0].elementId.guid" },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "zone B created" }
      ]
    },
    {
      "id": "new polygon with a hole for A; then a polygon for B that overlaps only the new A",
      "command": "ModifyZones",
      "creates": false,
      "params": {
        "zonesWithDetails": [
          {
            "elementId": { "guid": "${za}" },
            "geometry": {
              "polygonCoordinates": [
                { "x": 800.0, "y": 800.0 },
                { "x": 806.0, "y": 800.0 },
                { "x": 806.0, "y": 804.0 },
                { "x": 803.0, "y": 806.0 },
                { "x": 800.0, "y": 804.0 }
              ],
              "holes": [
                {
                  "polygonOutline": [
                    { "x": 802.0, "y": 801.0 },
                    { "x": 803.0, "y": 801.0 },
                    { "x": 803.0, "y": 802.0 },
                    { "x": 802.0, "y": 802.0 }
                  ]
                }
              ]
            }
          },
          {
            "elementId": { "guid": "${zb}" },
            "geometry": {
              "polygonCoordinates": [
                { "x": 805.0, "y": 800.0 },
                { "x": 812.0, "y": 800.0 },
                { "x": 812.0, "y": 803.0 },
                { "x": 805.0, "y": 803.0 }
              ]
            }
          }
        ]
      },
      "expect": [
        { "path": "executionResults", "len": 2, "name": "one result per item" },
        { "path": "executionResults[0].success", "eq": true, "name": "polygon of A changed" },
        { "path": "executionResults[1].success", "eq": false, "name": "B overlapping the new A refused" },
        { "path": "executionResults[1].error.message", "contains": "TapirCheck polygon A", "name": "names the overlapped zone" }
      ]
    },
    {
      "id": "read A back: same GUID, new polygon and hole, settings kept",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${za}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.isManual", "eq": true, "name": "still a manual zone" },
        { "path": "detailsOfElements[0].details.name", "eq": "TapirCheck polygon A", "name": "name kept" },
        { "path": "detailsOfElements[0].details.numberStr", "eq": "PA", "name": "number kept" },
        { "path": "detailsOfElements[0].details.height", "approx": 2.6, "name": "height kept" },
        { "path": "detailsOfElements[0].details.stampPosition.x", "approx": 801.0, "name": "stamp kept" },
        { "path": "detailsOfElements[0].details.polygonOutline", "len": 6, "name": "five corners and the closing point" },
        { "path": "detailsOfElements[0].details.polygonOutline[1].x", "approx": 806.0, "name": "new corner (x)" },
        { "path": "detailsOfElements[0].details.polygonOutline[3].y", "approx": 806.0, "name": "new apex (y)" },
        { "path": "detailsOfElements[0].details.holes", "len": 1, "name": "one hole" },
        { "path": "detailsOfElements[0].details.holes[0].polygonOutline", "len": 5, "name": "hole: four corners and the closing point" }
      ]
    },
    {
      "id": "B is unchanged after its refused polygon",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${zb}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.polygonOutline[0].x", "approx": 820.0, "name": "B keeps its polygon" },
        { "path": "detailsOfElements[0].details.polygonOutline[1].x", "approx": 824.0, "name": "B keeps its polygon (corner)" }
      ]
    },
    {
      "id": "move B with a closed outline (first point repeated), no overlap, and remove the hole of A",
      "command": "ModifyZones",
      "creates": false,
      "params": {
        "zonesWithDetails": [
          {
            "elementId": { "guid": "${zb}" },
            "stampPosition": { "x": 831.0, "y": 801.0 },
            "geometry": {
              "polygonCoordinates": [
                { "x": 830.0, "y": 800.0 },
                { "x": 835.0, "y": 800.0 },
                { "x": 835.0, "y": 804.0 },
                { "x": 830.0, "y": 804.0 },
                { "x": 830.0, "y": 800.0 }
              ]
            }
          },
          {
            "elementId": { "guid": "${za}" },
            "geometry": {
              "polygonCoordinates": [
                { "x": 800.0, "y": 800.0 },
                { "x": 806.0, "y": 800.0 },
                { "x": 806.0, "y": 804.0 },
                { "x": 800.0, "y": 804.0 }
              ]
            }
          }
        ]
      },
      "expect": [
        { "path": "executionResults", "len": 2, "name": "one result per item" },
        { "path": "executionResults[0].success", "eq": true, "name": "B moved" },
        { "path": "executionResults[1].success", "eq": true, "name": "A changed again" }
      ]
    },
    {
      "id": "read B and A back",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${zb}" } }, { "elementId": { "guid": "${za}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.polygonOutline", "len": 5, "name": "B: the repeated first point is not a fifth corner" },
        { "path": "detailsOfElements[0].details.polygonOutline[1].x", "approx": 835.0, "name": "B moved (x)" },
        { "path": "detailsOfElements[0].details.polygonOutline[2].y", "approx": 804.0, "name": "B moved (y)" },
        { "path": "detailsOfElements[0].details.stampPosition.x", "approx": 831.0, "name": "B stamp moved" },
        { "path": "detailsOfElements[1].details.polygonOutline", "len": 5, "name": "A: four corners and the closing point" },
        { "path": "detailsOfElements[1].details.holes", "len": 0, "name": "A: hole removed" }
      ]
    },
    {
      "id": "bad geometry is refused",
      "command": "ModifyZones",
      "creates": false,
      "params": {
        "zonesWithDetails": [
          {
            "elementId": { "guid": "${za}" },
            "geometry": {
              "polygonCoordinates": [
                { "x": 800.0, "y": 800.0 },
                { "x": 806.0, "y": 800.0 },
                { "x": 800.0, "y": 800.0 }
              ]
            }
          }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": false, "name": "two corners refused" },
        { "path": "executionResults[0].error.message", "contains": "at least 3", "name": "says why" }
      ]
    }
  ]
}
