{
  "title": "CreateZones, ModifyZones and SetDetailsOfElements write the zone's 3D surface, GetDetailsOfElements reads it (#2631)",
  "minTapir": "2.0.1",
  "minArchicad": "25",
  "steps": [
    {
      "id": "two surfaces",
      "command": "GetAttributesByType",
      "creates": false,
      "params": { "attributeType": "Surface" },
      "save": { "surf1": "attributes[0].attributeId.guid", "surf2": "attributes[1].attributeId.guid" }
    },
    {
      "id": "zone created with a surface on all sides",
      "command": "CreateZones",
      "params": {
        "zonesData": [
          {
            "name": "TapirCheck surface zone",
            "numberStr": "S1",
            "floorIndex": 0,
            "surface": { "surfaceId": { "guid": "${surf1}" }, "useOnAllSides": true },
            "geometry": {
              "polygonCoordinates": [
                { "x": 940.0, "y": 720.0 },
                { "x": 944.0, "y": 720.0 },
                { "x": 944.0, "y": 723.0 },
                { "x": 940.0, "y": 723.0 }
              ]
            }
          }
        ]
      },
      "save": { "z1": "elements[0].elementId.guid" },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "zone created, surface accepted" }
      ]
    },
    {
      "id": "read the new zone",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${z1}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.surface.surfaceId.guid", "eq": "${surf1}" },
        { "path": "detailsOfElements[0].details.surface.useOnAllSides", "eq": true }
      ]
    },
    {
      "id": "inherit the bounding walls' surfaces, and refuse an unknown surface",
      "command": "ModifyZones",
      "creates": false,
      "params": {
        "zonesWithDetails": [
          {
            "elementId": { "guid": "${z1}" },
            "surface": { "useOnAllSides": false }
          },
          {
            "elementId": { "guid": "${z1}" },
            "name": "TapirCheck must not be renamed",
            "surface": { "surfaceId": { "guid": "00000000-0000-0000-0000-00000000BEEF" } }
          }
        ]
      },
      "expect": [
        { "path": "executionResults", "len": 2, "name": "one result per item" },
        { "path": "executionResults[0].success", "eq": true, "name": "zone modified" },
        { "path": "executionResults[1].success", "eq": false, "name": "unknown surface refused" }
      ]
    },
    {
      "id": "read the modified zone",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${z1}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.surface.useOnAllSides", "eq": false },
        { "path": "detailsOfElements[0].details.surface.surfaceId.guid", "eq": "${surf1}", "name": "surface kept" },
        { "path": "detailsOfElements[0].details.name", "eq": "TapirCheck surface zone", "name": "the refused item changed nothing" }
      ]
    },
    {
      "id": "change the surface with SetDetailsOfElements",
      "command": "SetDetailsOfElements",
      "creates": false,
      "params": {
        "elementsWithDetails": [
          {
            "elementId": { "guid": "${z1}" },
            "details": {
              "typeSpecificDetails": {
                "surface": { "surfaceId": { "guid": "${surf2}" }, "useOnAllSides": true }
              }
            }
          }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "zone changed" }
      ]
    },
    {
      "id": "read the zone again",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${z1}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.surface.surfaceId.guid", "eq": "${surf2}" },
        { "path": "detailsOfElements[0].details.surface.useOnAllSides", "eq": true }
      ]
    }
  ]
}
