{
  "title": "CreateChangeMarkers creates a Change with its first marker, links a second marker to it, refuses wrong Change links and bad polygons, and GetDetailsOfElements reads the markers back (#2658)",
  "minTapir": "2.0.1",
  "steps": [
    {
      "id": "marker that creates a Change",
      "command": "CreateChangeMarkers",
      "params": {
        "changeMarkersData": [
          {
            "polygon": [{"x": 700, "y": 700}, {"x": 704, "y": 700}, {"x": 704, "y": 703}, {"x": 700, "y": 703}],
            "markerPosition": {"x": 705, "y": 704},
            "changeId": "TAPIR-CHECK-2658",
            "createChange": true,
            "changeDescription": "Tapir check change"
          }
        ]
      },
      "save": {"m1": "elements[0].elementId.guid"},
      "expect": [
        {"path": "elements", "len": 1, "name": "one result"},
        {"path": "elements[0].elementId.guid", "exists": true, "name": "created"}
      ]
    },
    {
      "id": "the new Change exists",
      "command": "GetRevisionChanges",
      "creates": false,
      "params": {},
      "expect": [
        {"path": "revisionChanges", "len": 1, "name": "the empty project has exactly this Change"},
        {"path": "revisionChanges[0].id", "eq": "TAPIR-CHECK-2658", "name": "with the given ID"},
        {"path": "revisionChanges[0].description", "eq": "Tapir check change", "name": "with the given description"}
      ]
    },
    {
      "id": "second marker linked to it, and the refused items",
      "command": "CreateChangeMarkers",
      "params": {
        "changeMarkersData": [
          {
            "polygon": [{"x": 710, "y": 700}, {"x": 712, "y": 700}, {"x": 711, "y": 702}, {"x": 710, "y": 700}],
            "markerComponent": "CloudOnly",
            "changeId": "TAPIR-CHECK-2658"
          },
          {
            "polygon": [{"x": 720, "y": 700}, {"x": 722, "y": 700}, {"x": 721, "y": 702}],
            "changeId": "TAPIR-CHECK-2658",
            "createChange": true,
            "changeDescription": "duplicate"
          },
          {
            "polygon": [{"x": 730, "y": 700}, {"x": 732, "y": 700}, {"x": 731, "y": 702}],
            "changeId": "TAPIR-CHECK-NO-SUCH-CHANGE"
          },
          {
            "polygon": [{"x": 740, "y": 700}, {"x": 742, "y": 700}, {"x": 742, "y": 700}, {"x": 740, "y": 700}],
            "changeId": "TAPIR-CHECK-2658"
          }
        ]
      },
      "save": {"m2": "elements[0].elementId.guid"},
      "expect": [
        {"path": "elements", "len": 4, "name": "one result per item"},
        {"path": "elements[0].elementId.guid", "exists": true, "name": "linked marker created"},
        {"path": "elements[1].error.message", "exists": true, "name": "a second Change with the same ID is refused"},
        {"path": "elements[2].error.message", "exists": true, "name": "a link to a Change that does not exist is refused"},
        {"path": "elements[3].error.message", "exists": true, "name": "a polygon of fewer than 3 different points is refused"}
      ]
    },
    {
      "id": "still one Change",
      "command": "GetRevisionChanges",
      "creates": false,
      "params": {},
      "expect": [
        {"path": "revisionChanges", "len": 1, "name": "the refused items made no Change"}
      ]
    },
    {
      "id": "read the markers back",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": {"elements": [{"elementId": {"guid": "${m1}"}}, {"elementId": {"guid": "${m2}"}}]},
      "expect": [
        {"path": "detailsOfElements[0].type", "eq": "ChangeMarker"},
        {"path": "detailsOfElements[0].details.changeId", "eq": "TAPIR-CHECK-2658", "name": "first marker linked to the new Change"},
        {"path": "detailsOfElements[0].details.linkType", "eq": "Linked", "name": "first marker is linked"},
        {"path": "detailsOfElements[0].details.markerComponent", "eq": "HeadAndCloud", "name": "default components"},
        {"path": "detailsOfElements[0].details.position.x", "approx": 702, "name": "position defaults to the polygon's centre (x)"},
        {"path": "detailsOfElements[0].details.position.y", "approx": 701.5, "name": "position defaults to the polygon's centre (y)"},
        {"path": "detailsOfElements[0].details.polygon", "len": 5, "name": "4 points and the closing point"},
        {"path": "detailsOfElements[0].details.polygon[1].x", "approx": 704},
        {"path": "detailsOfElements[0].details.polygon[2].y", "approx": 703},
        {"path": "detailsOfElements[1].details.changeId", "eq": "TAPIR-CHECK-2658", "name": "second marker linked to the same Change"},
        {"path": "detailsOfElements[1].details.markerComponent", "eq": "CloudOnly"},
        {"path": "detailsOfElements[1].details.polygon", "len": 4, "name": "3 points and the closing point"}
      ]
    }
  ]
}
