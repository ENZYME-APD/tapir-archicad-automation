{
  "title": "CreateAngleDimensions: static angle dimensions between two lines, read back with GetDetailsOfElements, bad inputs refused",
  "minTapir": "2.0.1",
  "steps": [
    {
      "id": "create a 30 degree angle dimension with lines sharing their start point",
      "command": "CreateAngleDimensions",
      "params": {
        "angleDimensionsData": [
          {
            "firstLine": { "begCoordinate": { "x": 900.0, "y": 900.0 }, "endCoordinate": { "x": 904.0, "y": 900.0 } },
            "secondLine": { "begCoordinate": { "x": 900.0, "y": 900.0 }, "endCoordinate": { "x": 903.4641016, "y": 902.0 } },
            "arcPosition": { "x": 902.8977775, "y": 900.7764571 },
            "smallArc": true,
            "floorIndex": 0,
            "pen": 2,
            "textHeight": 2.5,
            "textPen": 3
          }
        ]
      },
      "save": { "a": "elements[0].elementId.guid" },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "angle dimension created" }
      ]
    },
    {
      "id": "create a right angle dimension whose lines only meet when extended",
      "command": "CreateAngleDimensions",
      "params": {
        "angleDimensionsData": [
          {
            "firstLine": { "begCoordinate": { "x": 910.0, "y": 900.0 }, "endCoordinate": { "x": 914.0, "y": 900.0 } },
            "secondLine": { "begCoordinate": { "x": 912.0, "y": 901.0 }, "endCoordinate": { "x": 912.0, "y": 905.0 } },
            "arcPosition": { "x": 913.0, "y": 901.0 },
            "floorIndex": 0
          }
        ]
      },
      "save": { "b": "elements[0].elementId.guid" },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "second angle dimension created" }
      ]
    },
    {
      "id": "read both back",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": {
        "elements": [
          { "elementId": { "guid": "${a}" } },
          { "elementId": { "guid": "${b}" } }
        ]
      },
      "expect": [
        { "path": "detailsOfElements[0].type", "eq": "AngleDimension", "name": "an angle dimension" },
        { "path": "detailsOfElements[0].details.measuredAngle", "approx": 0.5235988, "name": "measures 30 degrees" },
        { "path": "detailsOfElements[0].details.arcCenter.x", "approx": 900.0, "name": "arc centered on the common point (x)" },
        { "path": "detailsOfElements[0].details.arcCenter.y", "approx": 900.0, "name": "arc centered on the common point (y)" },
        { "path": "detailsOfElements[0].details.firstLine.endCoordinate.x", "approx": 904.0, "name": "first line as created" },
        { "path": "detailsOfElements[0].details.secondLine.endCoordinate.y", "approx": 902.0, "name": "second line as created" },
        { "path": "detailsOfElements[0].details.arcPosition.x", "approx": 902.8977775, "name": "arc position as created" },
        { "path": "detailsOfElements[0].details.smallArc", "eq": true, "name": "inner dimension" },
        { "path": "detailsOfElements[0].details.pen", "eq": 2, "name": "pen as created" },
        { "path": "detailsOfElements[0].details.textHeight", "approx": 2.5, "name": "text height as created" },
        { "path": "detailsOfElements[0].details.textPen", "eq": 3, "name": "text pen as created" },
        { "path": "detailsOfElements[1].type", "eq": "AngleDimension", "name": "second is an angle dimension" },
        { "path": "detailsOfElements[1].details.measuredAngle", "approx": 1.5707963, "name": "measures 90 degrees" },
        { "path": "detailsOfElements[1].details.arcCenter.x", "approx": 912.0, "name": "arc centered on the extended lines' intersection (x)" },
        { "path": "detailsOfElements[1].details.arcCenter.y", "approx": 900.0, "name": "arc centered on the extended lines' intersection (y)" }
      ]
    },
    {
      "id": "bad inputs",
      "command": "CreateAngleDimensions",
      "creates": false,
      "params": {
        "angleDimensionsData": [
          {
            "firstLine": { "begCoordinate": { "x": 920.0, "y": 900.0 }, "endCoordinate": { "x": 924.0, "y": 900.0 } },
            "secondLine": { "begCoordinate": { "x": 920.0, "y": 901.0 }, "endCoordinate": { "x": 924.0, "y": 901.0 } },
            "arcPosition": { "x": 922.0, "y": 903.0 }
          },
          {
            "firstLine": { "begCoordinate": { "x": 920.0, "y": 900.0 }, "endCoordinate": { "x": 920.0, "y": 900.0 } },
            "secondLine": { "begCoordinate": { "x": 920.0, "y": 900.0 }, "endCoordinate": { "x": 920.0, "y": 904.0 } },
            "arcPosition": { "x": 921.0, "y": 901.0 }
          },
          {
            "firstLine": { "begCoordinate": { "x": 920.0, "y": 900.0 }, "endCoordinate": { "x": 924.0, "y": 900.0 } },
            "secondLine": { "begCoordinate": { "x": 920.0, "y": 900.0 }, "endCoordinate": { "x": 920.0, "y": 904.0 } },
            "arcPosition": { "x": 920.0, "y": 900.0 }
          }
        ]
      },
      "expect": [
        { "path": "elements[0].error", "exists": true, "name": "parallel lines refused" },
        { "path": "elements[1].error", "exists": true, "name": "zero-length line refused" },
        { "path": "elements[2].error", "exists": true, "name": "arc position at the center refused" }
      ]
    }
  ]
}
