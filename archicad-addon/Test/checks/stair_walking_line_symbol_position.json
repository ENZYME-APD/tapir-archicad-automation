{
  "title": "CreateStairs and ModifyStairs write the position of the walking line symbol and GetDetailsOfElements reads it",
  "minTapir": "2.0.1",
  "steps": [
    {
      "id": "a straight stair with a centered walking line symbol",
      "command": "CreateStairs",
      "params": {
        "stairsData": [
          { "baseLinePoints": [ { "x": 800.0, "y": 700.0 }, { "x": 806.0, "y": 700.0 } ], "zCoordinate": 0.0, "floorIndex": 0, "totalHeight": 2.8, "flightWidth": 1.2, "walkingLineSymbolPosition": "Center" }
        ]
      },
      "save": { "s": "elements[0].elementId.guid" },
      "expect": [ { "path": "elements[0].elementId.guid", "exists": true, "name": "stair created" } ]
    },
    {
      "id": "read it back",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${s}" } } ] },
      "expect": [ { "path": "detailsOfElements[0].details.walkingLineSymbolPosition", "eq": "Center", "name": "centered symbol read" } ]
    },
    {
      "id": "ModifyStairs: automatic symbol position",
      "command": "ModifyStairs",
      "creates": false,
      "params": { "stairsWithDetails": [ { "elementId": { "guid": "${s}" }, "walkingLineSymbolPosition": "Auto" } ] },
      "expect": [ { "path": "executionResults[0].success", "eq": true, "name": "change accepted" } ]
    },
    {
      "id": "read the change back",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${s}" } } ] },
      "expect": [ { "path": "detailsOfElements[0].details.walkingLineSymbolPosition", "eq": "Auto", "name": "automatic symbol position read" } ]
    }
  ]
}
