{
  "title": "CreateRoofs takes id, layerIndex and pivotEdges: a gable roof in one call on the given layer with the given id, and bad items create nothing",
  "minTapir": "2.0.1",
  "requiresEmpty": [ "Roof" ],
  "steps": [
    {
      "id": "layer for the roofs",
      "command": "CreateLayers",
      "creates": false,
      "params": {
        "layerDataArray": [ { "name": "Tapir check roof layer", "isHidden": false, "isLocked": false } ]
      },
      "save": { "layer": "attributeIds[0].attributeId.guid" }
    },
    {
      "id": "index of the layer",
      "command": "GetLayers",
      "creates": false,
      "params": {
        "attributeIds": [ { "attributeId": { "guid": "${layer}" } } ],
        "fields": [ "isHidden" ]
      },
      "save": { "layerIndex": "layers[0].index" },
      "expect": [
        { "expr": "${layerIndex}", "gt": 1, "name": "the new layer is not the Archicad layer" }
      ]
    },
    {
      "id": "gable roof with id and layer, and a hip roof without them",
      "command": "CreateRoofs",
      "params": {
        "roofsData": [
          {
            "id": "CHK-ROOF-1",
            "layerIndex": "${layerIndex}",
            "level": 3.0, "floorIndex": 0, "thickness": 0.2, "structureType": "Basic", "eavesOverhang": 0.6,
            "levels": [ { "levelHeight": 10.0, "levelAngle": 0.5235988 } ],
            "polygonCoordinates": [ { "x": 760, "y": 700 }, { "x": 768, "y": 700 }, { "x": 768, "y": 706 }, { "x": 760, "y": 706 } ],
            "pivotEdges": [
              {},
              { "levels": [ { "angleType": "Gable" } ] },
              {},
              { "levels": [ { "angleType": "Gable" } ] }
            ]
          },
          {
            "level": 3.0, "floorIndex": 0, "thickness": 0.2, "structureType": "Basic", "eavesOverhang": 0.6,
            "levels": [ { "levelHeight": 10.0, "levelAngle": 0.5235988 } ],
            "polygonCoordinates": [ { "x": 772, "y": 700 }, { "x": 780, "y": 700 }, { "x": 780, "y": 706 }, { "x": 772, "y": 706 } ]
          }
        ]
      },
      "save": { "r1": "elements[0].elementId.guid", "r2": "elements[1].elementId.guid" },
      "expect": [
        { "path": "elements", "len": 2 },
        { "path": "elements[0].elementId.guid", "exists": true, "name": "gable roof created" },
        { "path": "elements[1].elementId.guid", "exists": true, "name": "hip roof created" }
      ]
    },
    {
      "id": "read the roofs back",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": {
        "elements": [ { "elementId": { "guid": "${r1}" } }, { "elementId": { "guid": "${r2}" } } ]
      },
      "save": { "roofLayer": "detailsOfElements[0].layerIndex", "hipLayer": "detailsOfElements[1].layerIndex" },
      "expect": [
        { "path": "detailsOfElements[0].type", "eq": "Roof" },
        { "path": "detailsOfElements[0].id", "eq": "CHK-ROOF-1", "name": "id applied" },
        { "expr": "${roofLayer} - ${layerIndex}", "approx": 0, "name": "layerIndex applied" },
        { "expr": "${hipLayer} - ${layerIndex}", "ne": 0, "name": "roof without layerIndex keeps the layer of the tool defaults" },
        { "path": "detailsOfElements[0].details.pivotEdges", "len": 4, "name": "one pivot edge per side" },
        { "path": "detailsOfElements[0].details.pivotEdges[0].levels[0].angleType", "eq": "Sloped", "name": "edge 0 (south) stays sloped" },
        { "path": "detailsOfElements[0].details.pivotEdges[0].levels[0].angle", "approx": 0.5235988, "tol": 0.0001, "name": "edge 0 keeps the level's slope" },
        { "path": "detailsOfElements[0].details.pivotEdges[1].levels[0].angleType", "eq": "Gable", "name": "edge 1 (east) is a gable" },
        { "path": "detailsOfElements[0].details.pivotEdges[2].levels[0].angleType", "eq": "Sloped", "name": "edge 2 (north) stays sloped" },
        { "path": "detailsOfElements[0].details.pivotEdges[3].levels[0].angleType", "eq": "Gable", "name": "edge 3 (west) is a gable" },
        { "path": "detailsOfElements[1].details.pivotEdges[1].levels[0].angleType", "eq": "Sloped", "name": "hip roof without pivotEdges: all sloped" },
        { "path": "detailsOfElements[1].details.pivotEdges[3].levels[0].angleType", "eq": "Sloped", "name": "hip roof without pivotEdges: all sloped (west)" },
        { "path": "detailsOfElements[1].id", "ne": "CHK-ROOF-1", "name": "roof without id keeps an automatic id" }
      ]
    },
    {
      "id": "bad items: pivotEdges on a single-plane roof, the wrong number of pivotEdges, an unknown layer",
      "command": "CreateRoofs",
      "params": {
        "roofsData": [
          {
            "level": 3.0, "floorIndex": 0,
            "polygonCoordinates": [ { "x": 760, "y": 720 }, { "x": 766, "y": 720 }, { "x": 766, "y": 724 }, { "x": 760, "y": 724 } ],
            "pivotLine": { "begCoordinate": { "x": 760, "y": 720 }, "endCoordinate": { "x": 766, "y": 720 } },
            "angle": 0.2617994,
            "pivotEdges": [ {}, {}, {}, {} ]
          },
          {
            "level": 3.0, "floorIndex": 0,
            "levels": [ { "levelHeight": 10.0, "levelAngle": 0.5235988 } ],
            "polygonCoordinates": [ { "x": 772, "y": 720 }, { "x": 780, "y": 720 }, { "x": 780, "y": 726 }, { "x": 772, "y": 726 } ],
            "pivotEdges": [ { "levels": [ { "angleType": "Gable" } ] }, {} ]
          },
          {
            "level": 3.0, "floorIndex": 0,
            "layerIndex": 999999,
            "levels": [ { "levelHeight": 10.0, "levelAngle": 0.5235988 } ],
            "polygonCoordinates": [ { "x": 784, "y": 720 }, { "x": 792, "y": 720 }, { "x": 792, "y": 726 }, { "x": 784, "y": 726 } ]
          }
        ]
      },
      "expect": [
        { "path": "elements", "len": 3 },
        { "path": "elements[0].error.code", "exists": true, "name": "pivotEdges on a single-plane roof refused" },
        { "path": "elements[1].error.code", "exists": true, "name": "too few pivotEdges refused" },
        { "path": "elements[2].error.code", "exists": true, "name": "unknown layer refused" }
      ]
    },
    {
      "id": "only the two valid roofs were created (the roof with too few pivotEdges was deleted again)",
      "command": "GetElementsByType",
      "creates": false,
      "params": { "elementType": "Roof" },
      "expect": [ { "path": "elements", "len": 2 } ]
    }
  ]
}
