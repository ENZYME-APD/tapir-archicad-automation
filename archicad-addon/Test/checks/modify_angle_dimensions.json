{
  "title": "ModifyAngleDimensions changes the lines, arc position and settings of an angle dimension, and refuses bad input",
  "minTapir": "2.0.1",
  "requiresEmpty": [],
  "steps": [
    {
      "id": "a 30 degree angle dimension (lines from the origin of the check at x 930, y 900)",
      "command": "CreateAngleDimensions",
      "params": {
        "angleDimensionsData": [
          {
            "firstLine": { "begCoordinate": { "x": 930.0, "y": 900.0 }, "endCoordinate": { "x": 934.0, "y": 900.0 } },
            "secondLine": { "begCoordinate": { "x": 930.0, "y": 900.0 }, "endCoordinate": { "x": 933.4641016, "y": 902.0 } },
            "arcPosition": { "x": 932.8977775, "y": 900.7764571 },
            "smallArc": true,
            "pen": 1,
            "textHeight": 2.0,
            "textPen": 1
          }
        ]
      },
      "save": { "d": "elements[0].elementId.guid" },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "angle dimension created" }
      ]
    },
    {
      "id": "read as created",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${d}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.measuredAngle", "approx": 0.5235988, "name": "measures 30 degrees" }
      ]
    },
    {
      "id": "second line to 45 degrees with a new arc position, and new pens and text height",
      "command": "ModifyAngleDimensions",
      "creates": false,
      "params": {
        "angleDimensionsWithDetails": [
          {
            "elementId": { "guid": "${d}" },
            "secondLine": { "begCoordinate": { "x": 930.0, "y": 900.0 }, "endCoordinate": { "x": 932.8284271, "y": 902.8284271 } },
            "arcPosition": { "x": 932.7716386, "y": 901.1480503 },
            "pen": 3,
            "textHeight": 3.0,
            "textPen": 5
          }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "change accepted and read back by the command" }
      ]
    },
    {
      "id": "read after the change",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${d}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.measuredAngle", "approx": 0.7853982, "name": "measures 45 degrees" },
        { "path": "detailsOfElements[0].details.firstLine.endCoordinate.x", "approx": 934.0, "name": "first line kept" },
        { "path": "detailsOfElements[0].details.secondLine.endCoordinate.x", "approx": 932.8284271, "name": "second line end x changed" },
        { "path": "detailsOfElements[0].details.secondLine.endCoordinate.y", "approx": 902.8284271, "name": "second line end y changed" },
        { "path": "detailsOfElements[0].details.arcCenter.x", "approx": 930.0, "name": "arc center still at the intersection, x" },
        { "path": "detailsOfElements[0].details.arcCenter.y", "approx": 900.0, "name": "arc center still at the intersection, y" },
        { "path": "detailsOfElements[0].details.smallArc", "eq": true, "name": "smallArc kept" },
        { "path": "detailsOfElements[0].details.pen", "eq": 3, "name": "pen changed" },
        { "path": "detailsOfElements[0].details.textHeight", "approx": 3.0, "name": "text height changed" },
        { "path": "detailsOfElements[0].details.textPen", "eq": 5, "name": "text pen changed" }
      ]
    },
    {
      "id": "only the arc position: the radius changes, the lines stay",
      "command": "ModifyAngleDimensions",
      "creates": false,
      "params": {
        "angleDimensionsWithDetails": [
          { "elementId": { "guid": "${d}" }, "arcPosition": { "x": 931.8477591, "y": 900.7653669 } }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "arc position change accepted" }
      ]
    },
    {
      "id": "read after the arc position change",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${d}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.radius", "approx": 2.0, "name": "radius is the new distance of 2 m" },
        { "path": "detailsOfElements[0].details.measuredAngle", "approx": 0.7853982, "name": "still 45 degrees" },
        { "path": "detailsOfElements[0].details.pen", "eq": 3, "name": "pen kept" }
      ]
    },
    {
      "id": "bad inputs",
      "command": "ModifyAngleDimensions",
      "creates": false,
      "params": {
        "angleDimensionsWithDetails": [
          { "elementId": { "guid": "00000000-0000-0000-0000-00000000BEEF" }, "pen": 2 },
          { "elementId": { "guid": "${d}" } },
          { "elementId": { "guid": "${d}" }, "secondLine": { "begCoordinate": { "x": 930.0, "y": 901.0 }, "endCoordinate": { "x": 934.0, "y": 901.0 } } },
          { "elementId": { "guid": "${d}" }, "arcPosition": { "x": 930.0, "y": 900.0 } }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": false, "name": "nonexistent guid refused" },
        { "path": "executionResults[1].success", "eq": false, "name": "an item with nothing to change refused" },
        { "path": "executionResults[2].success", "eq": false, "name": "a second line parallel to the first refused" },
        { "path": "executionResults[3].success", "eq": false, "name": "an arc position on the intersection refused" }
      ]
    },
    {
      "id": "the refused items changed nothing",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${d}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.measuredAngle", "approx": 0.7853982, "name": "still 45 degrees" },
        { "path": "detailsOfElements[0].details.radius", "approx": 2.0, "name": "radius kept" }
      ]
    }
  ]
}
