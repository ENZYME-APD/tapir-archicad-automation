{
  "title": "GetDetailsOfElements reads the arcs of a multi-plane roof's pivot polygon and its segmentation, which ModifyRoofs writes and reads back (#2582)",
  "minTapir": "2.0.1",
  "steps": [
    {
      "id": "multi-plane roof with one curved pivot edge, and a single-plane roof",
      "command": "CreateRoofs",
      "params": {
        "roofsData": [
          {
            "level": 3.0, "floorIndex": 0, "thickness": 0.2, "structureType": "Basic", "eavesOverhang": 0.3,
            "levels": [ { "levelHeight": 10.0, "levelAngle": 0.5235988 } ],
            "polygonCoordinates": [ { "x": 900, "y": 700 }, { "x": 906, "y": 700 }, { "x": 906, "y": 706 }, { "x": 900, "y": 706 } ],
            "polygonArcs": [ { "begIndex": 1, "endIndex": 2, "arcAngle": 0.8 } ]
          },
          {
            "level": 3.0, "floorIndex": 0, "thickness": 0.2, "structureType": "Basic",
            "polygonCoordinates": [ { "x": 920, "y": 700 }, { "x": 926, "y": 700 }, { "x": 926, "y": 704 }, { "x": 920, "y": 704 } ],
            "pivotLine": { "begCoordinate": { "x": 920, "y": 700 }, "endCoordinate": { "x": 926, "y": 700 } },
            "angle": 0.2617994
          }
        ]
      },
      "save": { "r1": "elements[0].elementId.guid", "r2": "elements[1].elementId.guid" }
    },
    {
      "id": "details of the curved roof",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${r1}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.roofClass", "eq": "MultiPlane" },
        { "path": "detailsOfElements[0].details.pivotPolygonOutline", "len": 5, "name": "four corners and the closing point" },
        { "path": "detailsOfElements[0].details.pivotPolygonArcs", "len": 1, "name": "the curved pivot edge is read back as an arc" },
        { "path": "detailsOfElements[0].details.pivotPolygonArcs[0].arcAngle", "exists": true, "name": "the arc has its angle" },
        { "path": "detailsOfElements[0].details.segmentType", "exists": true, "name": "segmentType is read" },
        { "path": "detailsOfElements[0].details.segmentsByArc", "exists": true, "name": "segmentsByArc is read" },
        { "path": "detailsOfElements[0].details.segmentsByCircle", "exists": true, "name": "segmentsByCircle is read" }
      ]
    },
    {
      "id": "segment each arc into 6",
      "command": "ModifyRoofs",
      "creates": false,
      "params": { "roofsWithDetails": [ { "elementId": { "guid": "${r1}" }, "segmentType": "SegmentsByArc", "segmentsByArc": 6 } ] },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "written and read back" }
      ]
    },
    {
      "id": "read back SegmentsByArc 6",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${r1}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.segmentType", "eq": "SegmentsByArc" },
        { "path": "detailsOfElements[0].details.segmentsByArc", "eq": 6 },
        { "path": "detailsOfElements[0].details.pivotPolygonArcs", "len": 1, "name": "the arc is kept" },
        { "path": "detailsOfElements[0].details.eavesOverhang", "approx": 0.3, "name": "the overhang is kept" }
      ]
    },
    {
      "id": "segment a whole circle into 24",
      "command": "ModifyRoofs",
      "creates": false,
      "params": { "roofsWithDetails": [ { "elementId": { "guid": "${r1}" }, "segmentType": "SegmentsByCircle", "segmentsByCircle": 24 } ] },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "written and read back" }
      ]
    },
    {
      "id": "read back SegmentsByCircle 24",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${r1}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.segmentType", "eq": "SegmentsByCircle" },
        { "path": "detailsOfElements[0].details.segmentsByCircle", "eq": 24 },
        { "path": "detailsOfElements[0].details.segmentsByArc", "eq": 6, "name": "segmentsByArc not sent, kept" }
      ]
    },
    {
      "id": "segmentation on a single-plane roof is refused",
      "command": "ModifyRoofs",
      "creates": false,
      "params": { "roofsWithDetails": [ { "elementId": { "guid": "${r2}" }, "segmentType": "SegmentsByArc" } ] },
      "expect": [
        { "path": "executionResults[0].success", "eq": false, "name": "multi-plane roofs only" }
      ]
    },
    {
      "id": "the single-plane roof has no segmentation",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${r2}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.roofClass", "eq": "SinglePlane" },
        { "path": "detailsOfElements[0].details.segmentType", "exists": false },
        { "path": "detailsOfElements[0].details.pivotPolygonArcs", "exists": false }
      ]
    }
  ]
}
