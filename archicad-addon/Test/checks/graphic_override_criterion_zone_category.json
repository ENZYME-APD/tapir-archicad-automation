{
  "title": "Graphic override rules: the Zone Category condition (zoneCategory, zoneCategoryNot)",
  "minTapir": "1.8.1",
  "minArchicad": "29",
  "steps": [
    {
      "id": "a zone category to refer to",
      "command": "CreateZoneCategories",
      "creates": false,
      "params": {
        "zoneCategoryDataArray": [
          {
            "name": "TapirCheck NUF 4",
            "categoryCode": "NUF4",
            "color": {
              "red": 0.9,
              "green": 0.8,
              "blue": 0.4
            }
          }
        ],
        "overwriteExisting": true
      },
      "expect": [
        {
          "path": "attributeIds[0].attributeId.guid",
          "exists": true,
          "name": "zone category created"
        }
      ]
    },
    {
      "id": "rules with is and is not",
      "command": "CreateGraphicOverrideRules",
      "creates": false,
      "params": {
        "graphicOverrideRules": [
          {
            "name": "TapirCheck zone category is",
            "ruleGroupName": "TapirCheck criterion zone category",
            "criterion": {
              "and": [
                {
                  "elementType": "Zone"
                },
                {
                  "zoneCategory": "TapirCheck NUF 4"
                }
              ]
            },
            "style": {
              "lineMarkerTextPen": 20
            }
          },
          {
            "name": "TapirCheck zone category is not",
            "ruleGroupName": "TapirCheck criterion zone category",
            "criterion": {
              "and": [
                {
                  "elementType": "Zone"
                },
                {
                  "zoneCategoryNot": "TapirCheck NUF 4"
                }
              ]
            },
            "style": {
              "lineMarkerTextPen": 20
            }
          }
        ]
      },
      "expect": [
        {
          "path": "graphicOverrideRuleIds[0].graphicOverrideRuleId.guid",
          "exists": true,
          "name": "is rule created"
        },
        {
          "path": "graphicOverrideRuleIds[1].graphicOverrideRuleId.guid",
          "exists": true,
          "name": "is not rule created"
        }
      ]
    },
    {
      "id": "read them back",
      "command": "GetGraphicOverrideRulesByName",
      "params": {
        "graphicOverrideRules": [
          {
            "name": "TapirCheck zone category is",
            "ruleGroupName": "TapirCheck criterion zone category"
          },
          {
            "name": "TapirCheck zone category is not",
            "ruleGroupName": "TapirCheck criterion zone category"
          }
        ],
        "includeCriterion": true
      },
      "expect": [
        {
          "path": "graphicOverrideRules[0].criterion.and[1].zoneCategory",
          "eq": "TapirCheck NUF 4",
          "name": "zoneCategory read back by name"
        },
        {
          "path": "graphicOverrideRules[1].criterion.and[1].zoneCategoryNot",
          "eq": "TapirCheck NUF 4",
          "name": "zoneCategoryNot read back by name"
        }
      ]
    },
    {
      "id": "an unknown zone category",
      "command": "CreateGraphicOverrideRules",
      "creates": false,
      "params": {
        "graphicOverrideRules": [
          {
            "name": "TapirCheck zone category unknown",
            "ruleGroupName": "TapirCheck criterion zone category",
            "criterion": {
              "and": [
                {
                  "elementType": "Zone"
                },
                {
                  "zoneCategory": "TapirCheck no such category"
                }
              ]
            }
          }
        ]
      },
      "expect": [
        {
          "path": "graphicOverrideRuleIds[0].error.code",
          "exists": true,
          "name": "rejected"
        }
      ]
    }
  ],
  "teardown": [
    {
      "command": "DeleteGraphicOverrideRuleGroups",
      "params": {
        "ruleGroupNames": [
          "TapirCheck criterion zone category"
        ],
        "deleteRules": true
      }
    }
  ]
}
