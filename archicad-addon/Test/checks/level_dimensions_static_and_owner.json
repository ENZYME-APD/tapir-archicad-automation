{
  "title": "ModifyLevelDimensions: the value of a static level dimension, the Static checkbox and the owner element, read back by GetDetailsOfElements (#2656)",
  "minTapir": "2.0.1",
  "steps": [
    {
      "id": "static level dimension at 0.5 on floor 0",
      "command": "CreateLevelDimensions",
      "params": {
        "levelDimensionsData": [
          { "position": { "x": 860.0, "y": 800.0 }, "level": 0.5, "floorIndex": 0 }
        ]
      },
      "save": { "d": "elements[0].elementId.guid" },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "static level dimension created" }
      ]
    },
    {
      "id": "ModifyLevelDimensions: new static value",
      "command": "ModifyLevelDimensions",
      "creates": false,
      "params": {
        "levelDimensionsWithDetails": [
          { "elementId": { "guid": "${d}" }, "level": 1.25 }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "level change accepted" }
      ]
    },
    {
      "id": "the new static value",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${d}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.level", "approx": 1.25, "name": "shows the new value" },
        { "path": "detailsOfElements[0].details.position.x", "approx": 860.0, "name": "position kept" }
      ]
    },
    {
      "id": "ModifyLevelDimensions: Static off",
      "command": "ModifyLevelDimensions",
      "creates": false,
      "params": {
        "levelDimensionsWithDetails": [
          { "elementId": { "guid": "${d}" }, "staticLevel": false }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "Static off accepted" }
      ]
    },
    {
      "id": "after Static off it measures the floor",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${d}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.staticLevel", "eq": false, "name": "not static" },
        { "path": "detailsOfElements[0].details.level", "approx": 0.0, "tol": 0.01, "name": "shows the level of floor 0" }
      ]
    },
    {
      "id": "lower slab at 1.2",
      "command": "CreateSlabs",
      "params": {
        "slabsData": [
          {
            "level": 1.2,
            "floorIndex": 0,
            "polygonCoordinates": [
              { "x": 870.0, "y": 800.0 }, { "x": 874.0, "y": 800.0 },
              { "x": 874.0, "y": 804.0 }, { "x": 870.0, "y": 804.0 }
            ]
          }
        ]
      },
      "save": { "s1": "elements[0].elementId.guid" },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "lower slab created" }
      ]
    },
    {
      "id": "upper slab at 2.4 over the same outline",
      "command": "CreateSlabs",
      "params": {
        "slabsData": [
          {
            "level": 2.4,
            "floorIndex": 0,
            "polygonCoordinates": [
              { "x": 870.0, "y": 800.0 }, { "x": 874.0, "y": 800.0 },
              { "x": 874.0, "y": 804.0 }, { "x": 870.0, "y": 804.0 }
            ]
          }
        ]
      },
      "save": { "s2": "elements[0].elementId.guid" },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "upper slab created" }
      ]
    },
    {
      "id": "level dimension owned by the lower slab",
      "command": "CreateLevelDimensions",
      "params": {
        "levelDimensionsData": [
          { "position": { "x": 872.0, "y": 802.0 }, "parentElementId": { "guid": "${s1}" } }
        ]
      },
      "save": { "a": "elements[0].elementId.guid" },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "associative level dimension created" }
      ]
    },
    {
      "id": "owned by the lower slab",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${a}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.ownerElementId.guid", "eq": "${s1}", "name": "owner is the lower slab" },
        { "path": "detailsOfElements[0].details.level", "approx": 1.2, "tol": 0.5, "name": "shows about the lower slab's height" }
      ]
    },
    {
      "id": "ModifyLevelDimensions: owner to the upper slab",
      "command": "ModifyLevelDimensions",
      "creates": false,
      "params": {
        "levelDimensionsWithDetails": [
          { "elementId": { "guid": "${a}" }, "parentElementId": { "guid": "${s2}" } }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "owner change accepted" }
      ]
    },
    {
      "id": "owned by the upper slab",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${a}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.ownerElementId.guid", "eq": "${s2}", "name": "owner is the upper slab" },
        { "path": "detailsOfElements[0].details.ownerElementType", "eq": "Slab", "name": "owner type slab" },
        { "path": "detailsOfElements[0].details.level", "approx": 2.4, "tol": 0.5, "name": "shows about the upper slab's height" }
      ]
    },
    {
      "id": "ModifyLevelDimensions: Static on for the associative one",
      "command": "ModifyLevelDimensions",
      "creates": false,
      "params": {
        "levelDimensionsWithDetails": [
          { "elementId": { "guid": "${a}" }, "staticLevel": true }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "Static on accepted" }
      ]
    },
    {
      "id": "after Static on",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${a}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.staticLevel", "eq": true, "name": "static" },
        { "path": "detailsOfElements[0].details.level", "approx": 2.4, "tol": 0.5, "name": "keeps the upper slab's height" }
      ]
    },
    {
      "id": "ModifyLevelDimensions: level with staticLevel false",
      "command": "ModifyLevelDimensions",
      "creates": false,
      "params": {
        "levelDimensionsWithDetails": [
          { "elementId": { "guid": "${d}" }, "level": 3.0, "staticLevel": false }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": false, "name": "contradicting request refused" }
      ]
    },
    {
      "id": "ModifyLevelDimensions: level with parentElementId",
      "command": "ModifyLevelDimensions",
      "creates": false,
      "params": {
        "levelDimensionsWithDetails": [
          { "elementId": { "guid": "${a}" }, "level": 3.0, "parentElementId": { "guid": "${s1}" } }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": false, "name": "contradicting request refused" }
      ]
    },
    {
      "id": "ModifyLevelDimensions: owner that does not exist",
      "command": "ModifyLevelDimensions",
      "creates": false,
      "params": {
        "levelDimensionsWithDetails": [
          { "elementId": { "guid": "${a}" }, "parentElementId": { "guid": "00000000-0000-0000-0000-000000002656" } }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": false, "name": "unknown owner refused" }
      ]
    },
    {
      "id": "the refused items changed nothing",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${d}" } }, { "elementId": { "guid": "${a}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.level", "approx": 0.0, "tol": 0.01, "name": "floor dimension unchanged" },
        { "path": "detailsOfElements[1].details.ownerElementId.guid", "eq": "${s2}", "name": "owner unchanged" }
      ]
    }
  ]
}
