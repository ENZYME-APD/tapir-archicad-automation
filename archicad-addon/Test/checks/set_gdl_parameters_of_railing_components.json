{
  "title": "SetGDLParametersOfElements: the top rail of a railing (#2572 part 5)",
  "minTapir": "2.0.1",
  "steps": [
    {
      "id": "create a one-segment railing on story 0",
      "command": "CreateRailings",
      "params": {
        "railingsData": [
          {
            "coordinates": [
              { "x": 830.0, "y": 830.0 },
              { "x": 834.0, "y": 830.0 }
            ],
            "floorIndex": 0,
            "bottomOffset": 0.0,
            "height": 1.0
          }
        ]
      },
      "save": { "r": "elements[0].elementId.guid" },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "railing created" }
      ]
    },
    {
      "id": "list the railing's components",
      "command": "GetSubelementsOfHierarchicalElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${r}" } } ] },
      "save": { "toprail": "subelements[0].railingToprails[0].elementId.guid" },
      "expect": [
        { "path": "subelements[0].railingToprails[0].elementId.guid", "exists": true, "name": "the railing has a top rail" }
      ]
    },
    {
      "id": "read the top rail's GDL parameters",
      "command": "GetGDLParametersOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${toprail}" } } ] },
      "save": { "aBefore": "gdlParametersOfElements[0].parameters[0].value" },
      "expect": [
        { "path": "gdlParametersOfElements[0].parameters[0].name", "eq": "A", "name": "the top rail's first parameter is A (every library part has A and B)" },
        { "path": "gdlParametersOfElements[0].parameters[0].value", "ne": 0.237, "name": "A does not already have the value written below" }
      ]
    },
    {
      "id": "dry run: write A with a different value",
      "command": "SetGDLParametersOfElements",
      "creates": false,
      "params": {
        "dryRun": true,
        "elementsWithGDLParameters": [
          {
            "elementId": { "guid": "${toprail}" },
            "gdlParameters": [ { "name": "A", "value": 0.237 } ]
          }
        ]
      },
      "save": { "dryOldA": "executionResults[0].wouldChange.oldValue[0].value" },
      "expect": [
        { "path": "dryRun", "eq": true, "name": "answered as a dry run" },
        { "path": "executionResults", "len": 1, "name": "one result" },
        { "path": "executionResults[0].success", "eq": true, "name": "the top rail accepts the parameter (no 'Failed to open parameters')" },
        { "path": "executionResults[0].wouldChange.newValue[0].name", "eq": "A", "name": "wouldChange lists A" },
        { "path": "executionResults[0].wouldChange.newValue[0].value", "approx": 0.237, "tol": 0.000001, "name": "wouldChange has the new value" },
        { "expr": "${dryOldA} - ${aBefore}", "approx": 0.0, "tol": 0.000001, "name": "wouldChange has the value before" }
      ]
    },
    {
      "id": "the dry run changed nothing",
      "command": "GetGDLParametersOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${toprail}" } } ] },
      "save": { "aAfterDryRun": "gdlParametersOfElements[0].parameters[0].value" },
      "expect": [
        { "expr": "${aAfterDryRun} - ${aBefore}", "approx": 0.0, "tol": 0.000001, "name": "A unchanged after the dry run" }
      ]
    },
    {
      "id": "write A with a different value",
      "command": "SetGDLParametersOfElements",
      "creates": false,
      "params": {
        "elementsWithGDLParameters": [
          {
            "elementId": { "guid": "${toprail}" },
            "gdlParameters": [ { "name": "A", "value": 0.237 } ]
          }
        ]
      },
      "expect": [
        { "path": "executionResults", "len": 1, "name": "one result" },
        { "path": "executionResults[0].success", "eq": true, "name": "Archicad changes the top rail and keeps the value" }
      ]
    },
    {
      "id": "read A back",
      "command": "GetGDLParametersOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${toprail}" } } ] },
      "expect": [
        { "path": "gdlParametersOfElements[0].parameters[0].name", "eq": "A", "name": "the first parameter is still A" },
        { "path": "gdlParametersOfElements[0].parameters[0].value", "approx": 0.237, "tol": 0.000001, "name": "A has the written value" }
      ]
    },
    {
      "id": "a parameter the top rail does not have",
      "command": "SetGDLParametersOfElements",
      "creates": false,
      "params": {
        "elementsWithGDLParameters": [
          {
            "elementId": { "guid": "${toprail}" },
            "gdlParameters": [ { "name": "tapirCheckNoSuchParameter2572", "value": 1.0 } ]
          }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": false, "name": "nonexistent parameter refused" },
        { "path": "executionResults[0].error.message", "contains": "railing component", "name": "refused by the railing component path" }
      ]
    },
    {
      "id": "the railing itself still answers as before",
      "command": "GetGDLParametersOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${r}" } } ] },
      "expect": [
        { "path": "gdlParametersOfElements", "len": 1, "name": "one answer for the railing" }
      ]
    }
  ]
}
