{
  "title": "CreateArcs takes angle, ratio and reflected; CreatePolylines takes lineTypeId and drawSegmentMode, SetDetailsOfElements changes drawSegmentMode and GetDetailsOfElements reads it back",
  "minTapir": "2.0.1",
  "requiresEmpty": [ "Arc", "PolyLine" ],
  "steps": [
    {
      "id": "a line type other than the first",
      "command": "GetAttributesByType",
      "creates": false,
      "params": { "attributeType": "Line" },
      "save": { "lt": "attributes[1].attributeId.guid" },
      "expect": [
        { "path": "attributes[1].attributeId.guid", "exists": true, "name": "the project has a second line type" }
      ]
    },
    {
      "id": "an elliptic arc in one call",
      "command": "CreateArcs",
      "params": {
        "arcsData": [
          {
            "origin": { "x": 820.0, "y": 800.0 },
            "radius": 3.0,
            "begAngle": 0.0,
            "endAngle": 1.5707963267948966,
            "angle": 0.5,
            "ratio": 2.0,
            "reflected": true,
            "lineTypeId": { "guid": "${lt}" },
            "floorInd": 0
          }
        ]
      },
      "save": { "a1": "elements[0].elementId.guid" },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "elliptic arc created" }
      ]
    },
    {
      "id": "read the elliptic arc back",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${a1}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].type", "eq": "Arc" },
        { "path": "detailsOfElements[0].details.origin.x", "approx": 820.0, "name": "origin kept" },
        { "path": "detailsOfElements[0].details.angle", "approx": 0.5, "name": "axis angle applied at creation" },
        { "path": "detailsOfElements[0].details.ratio", "approx": 2.0, "name": "ratio applied at creation, not reset to 1" },
        { "path": "detailsOfElements[0].details.reflected", "eq": true, "name": "reflected applied at creation" },
        { "path": "detailsOfElements[0].details.lineTypeId.guid", "eq": "${lt}", "name": "line type applied" }
      ]
    },
    {
      "id": "a circular arc without the new fields",
      "command": "CreateArcs",
      "params": {
        "arcsData": [
          { "origin": { "x": 830.0, "y": 800.0 }, "radius": 2.0, "begAngle": 0.0, "endAngle": 1.0, "floorInd": 0 }
        ]
      },
      "save": { "a2": "elements[0].elementId.guid" },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "circular arc created" }
      ]
    },
    {
      "id": "read the circular arc back",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${a2}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.ratio", "approx": 1.0, "name": "ratio still defaults to 1" },
        { "path": "detailsOfElements[0].details.angle", "approx": 0.0, "name": "axis angle still defaults to 0" }
      ]
    },
    {
      "id": "polylines with lineTypeId and both dash modes",
      "command": "CreatePolylines",
      "params": {
        "polylinesData": [
          {
            "coordinates": [ { "x": 800.0, "y": 800.0 }, { "x": 804.0, "y": 800.0 }, { "x": 804.0, "y": 803.0 } ],
            "lineTypeId": { "guid": "${lt}" },
            "lineTypeIndex": 1,
            "drawSegmentMode": "Continuous",
            "floorInd": 0
          },
          {
            "coordinates": [ { "x": 800.0, "y": 810.0 }, { "x": 804.0, "y": 810.0 }, { "x": 804.0, "y": 813.0 } ],
            "lineTypeId": { "guid": "${lt}" },
            "drawSegmentMode": "SegmentBySegment",
            "floorInd": 0
          }
        ]
      },
      "save": { "p1": "elements[0].elementId.guid", "p2": "elements[1].elementId.guid" },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "continuous polyline created" },
        { "path": "elements[1].elementId.guid", "exists": true, "name": "segment by segment polyline created" }
      ]
    },
    {
      "id": "read the polylines back",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": {
        "elements": [ { "elementId": { "guid": "${p1}" } }, { "elementId": { "guid": "${p2}" } } ]
      },
      "expect": [
        { "path": "detailsOfElements[0].type", "eq": "PolyLine" },
        { "path": "detailsOfElements[0].details.lineTypeId.guid", "eq": "${lt}", "name": "lineTypeId applied and wins over lineTypeIndex" },
        { "path": "detailsOfElements[0].details.drawSegmentMode", "eq": "Continuous", "name": "Continuous applied" },
        { "path": "detailsOfElements[1].details.lineTypeId.guid", "eq": "${lt}", "name": "lineTypeId applied" },
        { "path": "detailsOfElements[1].details.drawSegmentMode", "eq": "SegmentBySegment", "name": "SegmentBySegment applied" }
      ]
    },
    {
      "id": "swap the dash modes",
      "command": "SetDetailsOfElements",
      "creates": false,
      "params": {
        "elementsWithDetails": [
          { "elementId": { "guid": "${p1}" }, "details": { "typeSpecificDetails": { "drawSegmentMode": "SegmentBySegment" } } },
          { "elementId": { "guid": "${p2}" }, "details": { "typeSpecificDetails": { "drawSegmentMode": "Continuous" } } }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true },
        { "path": "executionResults[1].success", "eq": true }
      ]
    },
    {
      "id": "read the swapped dash modes back",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": {
        "elements": [ { "elementId": { "guid": "${p1}" } }, { "elementId": { "guid": "${p2}" } } ]
      },
      "expect": [
        { "path": "detailsOfElements[0].details.drawSegmentMode", "eq": "SegmentBySegment", "name": "changed to SegmentBySegment" },
        { "path": "detailsOfElements[0].details.coordinates", "len": 3, "name": "geometry kept" },
        { "path": "detailsOfElements[0].details.lineTypeId.guid", "eq": "${lt}", "name": "line type kept" },
        { "path": "detailsOfElements[1].details.drawSegmentMode", "eq": "Continuous", "name": "changed to Continuous" }
      ]
    },
    {
      "id": "exactly the two polylines exist",
      "command": "GetElementsByType",
      "creates": false,
      "params": { "elementType": "PolyLine" },
      "expect": [ { "path": "elements", "len": 2 } ]
    }
  ],
  "teardown": [
    { "command": "DeleteElements", "params": { "elements": [ { "elementId": { "guid": "${a1}" } } ] } },
    { "command": "DeleteElements", "params": { "elements": [ { "elementId": { "guid": "${a2}" } } ] } },
    { "command": "DeleteElements", "params": { "elements": [ { "elementId": { "guid": "${p1}" } } ] } },
    { "command": "DeleteElements", "params": { "elements": [ { "elementId": { "guid": "${p2}" } } ] } }
  ]
}
