{
  "title": "SetViewSettings sets the renovation filter by renovationFilterName and fails an unknown or conflicting name without writing (#2700)",
  "minTapir": "2.0.1",
  "steps": [
    {
      "id": "a story of the Project Map",
      "command": "GetNavigatorItemTree",
      "creates": false,
      "stopOnFail": true,
      "params": {
        "navigatorMapId": "ProjectMap"
      },
      "save": {
        "story": "navigatorItemTree.children[0].navigatorItem.children[0].navigatorItem.navigatorItemId.guid"
      },
      "expect": [
        { "path": "navigatorItemTree.children[0].navigatorItem.children[0].navigatorItem.type", "eq": "StoryItem", "name": "first item of the first Project Map group is a story" }
      ]
    },
    {
      "id": "two renovation filters of the template",
      "command": "GetRenovationFilters",
      "creates": false,
      "stopOnFail": true,
      "params": {},
      "save": {
        "filterAId": "renovationFilters[0].renovationFilterId.guid",
        "filterAName": "renovationFilters[0].name",
        "filterBId": "renovationFilters[1].renovationFilterId.guid",
        "filterBName": "renovationFilters[1].name"
      },
      "expect": [
        { "path": "renovationFilters[1].renovationFilterId.guid", "exists": true, "name": "the template has at least two renovation filters" }
      ]
    },
    {
      "id": "folder at the View Map root",
      "command": "CreateViewMapFolder",
      "creates": false,
      "stopOnFail": true,
      "params": {
        "folderName": "TapirCheck renovation filter folder"
      },
      "save": {
        "folder": "navigatorItemId.guid"
      },
      "expect": [
        { "path": "navigatorItemId.guid", "exists": true, "name": "folder created" }
      ]
    },
    {
      "id": "view of the story",
      "command": "CreateViewsInViewMap",
      "creates": false,
      "stopOnFail": true,
      "params": {
        "viewsData": [
          { "navigatorItemId": { "guid": "${story}" }, "parentNavigatorItemId": { "guid": "${folder}" }, "name": "TapirCheck renovation filter view" }
        ]
      },
      "save": {
        "view": "navigatorItems[0].navigatorItemId.guid"
      },
      "expect": [
        { "path": "navigatorItems[0].navigatorItemId.guid", "exists": true, "name": "view created" }
      ]
    },
    {
      "id": "filter A by guid",
      "command": "SetViewSettings",
      "creates": false,
      "params": {
        "navigatorItemIdsWithViewSettings": [
          { "navigatorItemId": { "guid": "${view}" }, "viewSettings": { "renovationFilterGuid": { "guid": "${filterAId}" } } }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true }
      ]
    },
    {
      "id": "filter B by name",
      "command": "SetViewSettings",
      "creates": false,
      "params": {
        "navigatorItemIdsWithViewSettings": [
          { "navigatorItemId": { "guid": "${view}" }, "viewSettings": { "renovationFilterName": "${filterBName}" } }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true }
      ]
    },
    {
      "id": "the view uses filter B",
      "command": "GetViewSettings",
      "creates": false,
      "params": {
        "navigatorItemIds": [ { "navigatorItemId": { "guid": "${view}" } } ]
      },
      "expect": [
        { "path": "viewSettings[0].renovationFilterGuid.guid", "eq": "${filterBId}", "name": "filter set by its name" },
        { "path": "viewSettings[0].renovationFilterName", "eq": "${filterBName}", "name": "name read back" }
      ]
    },
    {
      "id": "a name the project has no filter for, with a scale",
      "command": "SetViewSettings",
      "creates": false,
      "params": {
        "navigatorItemIdsWithViewSettings": [
          { "navigatorItemId": { "guid": "${view}" }, "viewSettings": { "renovationFilterName": "TapirCheck no such renovation filter", "drawingScale": 20 } }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": false, "name": "unknown name refused" }
      ]
    },
    {
      "id": "guid and name of different filters",
      "command": "SetViewSettings",
      "creates": false,
      "params": {
        "navigatorItemIdsWithViewSettings": [
          { "navigatorItemId": { "guid": "${view}" }, "viewSettings": { "renovationFilterGuid": { "guid": "${filterAId}" }, "renovationFilterName": "${filterBName}", "drawingScale": 20 } }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": false, "name": "conflicting guid and name refused" }
      ]
    },
    {
      "id": "the refused items wrote nothing",
      "command": "GetViewSettings",
      "creates": false,
      "params": {
        "navigatorItemIds": [ { "navigatorItemId": { "guid": "${view}" } } ]
      },
      "expect": [
        { "path": "viewSettings[0].renovationFilterGuid.guid", "eq": "${filterBId}", "name": "still filter B" },
        { "path": "viewSettings[0].drawingScale", "ne": 20, "name": "scale of the refused items not written" }
      ]
    },
    {
      "id": "guid and name of the same filter, as GetViewSettings returns them",
      "command": "SetViewSettings",
      "creates": false,
      "params": {
        "navigatorItemIdsWithViewSettings": [
          { "navigatorItemId": { "guid": "${view}" }, "viewSettings": { "renovationFilterGuid": { "guid": "${filterAId}" }, "renovationFilterName": "${filterAName}" } }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true }
      ]
    },
    {
      "id": "the view uses filter A",
      "command": "GetViewSettings",
      "creates": false,
      "params": {
        "navigatorItemIds": [ { "navigatorItemId": { "guid": "${view}" } } ]
      },
      "expect": [
        { "path": "viewSettings[0].renovationFilterGuid.guid", "eq": "${filterAId}", "name": "filter A" }
      ]
    }
  ],
  "teardown": [
    {
      "command": "DeleteNavigatorItems",
      "params": { "navigatorItemIds": [ { "navigatorItemId": { "guid": "${view}" } } ] }
    },
    {
      "command": "DeleteNavigatorItems",
      "params": { "navigatorItemIds": [ { "navigatorItemId": { "guid": "${folder}" } } ] }
    }
  ]
}
