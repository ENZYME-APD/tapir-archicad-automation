{
  "title": "Zone cover fill: use the surface's fill and the fill orientation in CreateZones, ModifyZones, SetDetailsOfElements and GetDetailsOfElements (#2631)",
  "minTapir": "2.0.1",
  "minArchicad": "27",
  "steps": [
    {
      "id": "a fill",
      "command": "GetAttributesByType",
      "creates": false,
      "params": { "attributeType": "Fill" },
      "save": { "fill": "attributes[0].attributeId.guid" }
    },
    {
      "id": "zone created with the surface's fill and a rotated fill",
      "command": "CreateZones",
      "params": {
        "zonesData": [
          {
            "name": "TapirCheck cover fill zone",
            "numberStr": "CF1",
            "floorIndex": 0,
            "coverFill": {
              "use": true,
              "fillId": { "guid": "${fill}" },
              "use3DHatching": true,
              "useLocalOrigo": true,
              "locOrigo": { "x": 941.0, "y": 721.0 },
              "fillAngle": 0.5
            },
            "geometry": {
              "polygonCoordinates": [
                { "x": 940.0, "y": 720.0 },
                { "x": 944.0, "y": 720.0 },
                { "x": 944.0, "y": 723.0 },
                { "x": 940.0, "y": 723.0 }
              ]
            }
          }
        ]
      },
      "save": { "z1": "elements[0].elementId.guid" },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "zone created, the new cover fill keys accepted" }
      ]
    },
    {
      "id": "read the new zone",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${z1}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.coverFill.use", "eq": true },
        { "path": "detailsOfElements[0].details.coverFill.fillId.guid", "eq": "${fill}" },
        { "path": "detailsOfElements[0].details.coverFill.use3DHatching", "eq": true, "name": "use the surface's fill set on create" },
        { "path": "detailsOfElements[0].details.coverFill.useLocalOrigo", "eq": true, "name": "fill linked to the zone" },
        { "path": "detailsOfElements[0].details.coverFill.locOrigo.x", "approx": 941.0 },
        { "path": "detailsOfElements[0].details.coverFill.locOrigo.y", "approx": 721.0 },
        { "path": "detailsOfElements[0].details.coverFill.fillAngle", "approx": 0.5, "name": "fill angle set on create" }
      ]
    },
    {
      "id": "modify only the fill angle and the surface's fill",
      "command": "ModifyZones",
      "creates": false,
      "params": {
        "zonesWithDetails": [
          {
            "elementId": { "guid": "${z1}" },
            "coverFill": { "use3DHatching": false, "fillAngle": 1.0 }
          }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "zone modified" }
      ]
    },
    {
      "id": "read the modified zone",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${z1}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.coverFill.use3DHatching", "eq": false, "name": "use the surface's fill cleared" },
        { "path": "detailsOfElements[0].details.coverFill.fillAngle", "approx": 1.0, "name": "fill angle changed" },
        { "path": "detailsOfElements[0].details.coverFill.useLocalOrigo", "eq": true, "name": "orientation kept" },
        { "path": "detailsOfElements[0].details.coverFill.locOrigo.x", "approx": 941.0, "name": "fill origin kept" },
        { "path": "detailsOfElements[0].details.coverFill.locOrigo.y", "approx": 721.0 },
        { "path": "detailsOfElements[0].details.coverFill.fillId.guid", "eq": "${fill}", "name": "fill kept" },
        { "path": "detailsOfElements[0].details.name", "eq": "TapirCheck cover fill zone", "name": "name kept" }
      ]
    },
    {
      "id": "move the fill origin with ModifyZones",
      "command": "ModifyZones",
      "creates": false,
      "params": {
        "zonesWithDetails": [
          {
            "elementId": { "guid": "${z1}" },
            "coverFill": { "locOrigo": { "x": 942.5, "y": 722.0 } }
          }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "fill origin moved" }
      ]
    },
    {
      "id": "read the moved fill origin",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${z1}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.coverFill.locOrigo.x", "approx": 942.5, "name": "fill origin moved" },
        { "path": "detailsOfElements[0].details.coverFill.locOrigo.y", "approx": 722.0 },
        { "path": "detailsOfElements[0].details.coverFill.fillAngle", "approx": 1.0, "name": "fill angle kept" }
      ]
    },
    {
      "id": "switch to the project origin with SetDetailsOfElements",
      "command": "SetDetailsOfElements",
      "creates": false,
      "params": {
        "elementsWithDetails": [
          {
            "elementId": { "guid": "${z1}" },
            "details": { "typeSpecificDetails": { "coverFill": { "useLocalOrigo": false } } }
          }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "SetDetailsOfElements takes the new key" }
      ]
    },
    {
      "id": "read the zone again",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${z1}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.coverFill.useLocalOrigo", "eq": false, "name": "fill linked to the project origin" },
        { "path": "detailsOfElements[0].details.coverFill.fillId.guid", "eq": "${fill}", "name": "fill kept" }
      ]
    }
  ]
}
