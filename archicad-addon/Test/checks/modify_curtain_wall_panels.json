{
  "title": "ModifyCurtainWallPanels: a panel class is assigned and read back, bad inputs refused (#2533)",
  "minTapir": "2.0.1",
  "steps": [
    {
      "id": "create a one-segment curtain wall with panel class 1 in every cell",
      "command": "CreateCurtainWalls",
      "params": {
        "curtainWallsData": [
          {
            "coordinates": [
              { "x": 940.0, "y": 940.0 },
              { "x": 946.0, "y": 940.0 }
            ],
            "zCoordinate": 0.0,
            "floorIndex": 0,
            "height": 3.0,
            "primaryPattern": { "sizes": [ 1.5 ], "logic": "FixedSizes", "origin": "StartWithPattern" },
            "secondaryPattern": { "sizes": [ 1.5 ], "logic": "FixedSizes", "origin": "StartWithPattern" },
            "cells": [
              { "columnIndex": 0, "rowIndex": 0, "panelClassIndex": 1, "leftFrameClassIndex": 1, "bottomFrameClassIndex": 1, "crossingFrameType": "None" }
            ]
          }
        ]
      },
      "save": { "cw": "elements[0].elementId.guid" },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "curtain wall created" }
      ]
    },
    {
      "id": "its panels and frames",
      "command": "GetSubelementsOfHierarchicalElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${cw}" } } ] },
      "save": {
        "p0": "subelements[0].cWallPanels[0].elementId.guid",
        "p1": "subelements[0].cWallPanels[1].elementId.guid",
        "f": "subelements[0].cWallFrames[0].elementId.guid"
      },
      "expect": [
        { "path": "subelements[0].cWallPanels", "len": 8, "name": "4 columns and 2 rows of 1.5 m" },
        { "path": "subelements[0].cWallFrames[0].elementId.guid", "exists": true, "name": "the curtain wall has frames" }
      ]
    },
    {
      "id": "panel classes as created",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": {
        "elements": [
          { "elementId": { "guid": "${p0}" } },
          { "elementId": { "guid": "${p1}" } }
        ]
      },
      "expect": [
        { "path": "detailsOfElements[0].type", "eq": "CurtainWallPanel", "name": "the saved subelement is a panel" },
        { "path": "detailsOfElements[0].details.classIndex", "eq": 1, "name": "GetDetailsOfElements reports the panel class of the cells" },
        { "path": "detailsOfElements[0].details.className", "exists": true, "name": "and its name" },
        { "path": "detailsOfElements[1].details.classIndex", "eq": 1, "name": "the second panel has class 1 too" }
      ]
    },
    {
      "id": "ModifyCurtainWallPanels: panel class 1 on the first panel",
      "command": "ModifyCurtainWallPanels",
      "creates": false,
      "params": {
        "panelsWithDetails": [
          { "panelId": { "guid": "${p0}" }, "classIndex": 1 }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "class assignment accepted and read back" }
      ]
    },
    {
      "id": "the panel after the class assignment",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": {
        "elements": [
          { "elementId": { "guid": "${p0}" } },
          { "elementId": { "guid": "${cw}" } }
        ]
      },
      "expect": [
        { "path": "detailsOfElements[0].details.classIndex", "eq": 1, "name": "panel has class 1" },
        { "path": "detailsOfElements[0].details.isHidden", "eq": false, "name": "panel still shown" },
        { "path": "detailsOfElements[1].details.height", "approx": 3.0, "name": "curtain wall height unchanged" }
      ]
    },
    {
      "id": "ModifyCurtainWallPanels: bad inputs",
      "command": "ModifyCurtainWallPanels",
      "creates": false,
      "params": {
        "panelsWithDetails": [
          { "panelId": { "guid": "00000000-0000-0000-0000-00000000BEEF" }, "classIndex": 1 },
          { "panelId": { "guid": "${f}" }, "classIndex": 1 },
          { "panelId": { "guid": "${cw}" }, "classIndex": 1 },
          { "panelId": { "guid": "${p1}" }, "classIndex": 99 },
          { "panelId": { "guid": "${p1}" } }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": false, "name": "nonexistent guid refused" },
        { "path": "executionResults[1].success", "eq": false, "name": "a curtain wall frame refused" },
        { "path": "executionResults[2].success", "eq": false, "name": "a curtain wall refused" },
        { "path": "executionResults[3].success", "eq": false, "name": "a panel class the curtain wall does not have refused" },
        { "path": "executionResults[4].success", "eq": false, "name": "an item with nothing to change refused" }
      ]
    },
    {
      "id": "the refused items changed nothing",
      "command": "GetSubelementsOfHierarchicalElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${cw}" } } ] },
      "expect": [
        { "path": "subelements[0].cWallPanels", "len": 8, "name": "panel count unchanged" }
      ]
    },
    {
      "id": "panel classes after the refused items",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": {
        "elements": [
          { "elementId": { "guid": "${p0}" } },
          { "elementId": { "guid": "${p1}" } }
        ]
      },
      "expect": [
        { "path": "detailsOfElements[0].details.classIndex", "eq": 1, "name": "first panel class unchanged" },
        { "path": "detailsOfElements[1].details.classIndex", "eq": 1, "name": "second panel class unchanged" }
      ]
    }
  ]
}
