{
  "title": "SetDetailsOfElements sets the id and the layer of an Opening placed with PlaceOpenings, and GetDetailsOfElements reads them back and points to GetOpeningDetails for the rest (#2629)",
  "minTapir": "2.0.1",
  "minArchicad": "29",
  "requiresEmpty": ["Wall", "Opening"],
  "steps": [
    {
      "id": "target layer",
      "command": "CreateLayers",
      "creates": false,
      "params": {
        "layerDataArray": [
          { "name": "Tapir check opening layer", "isHidden": false, "isLocked": false }
        ]
      },
      "save": { "layer": "attributeIds[0].attributeId.guid" }
    },
    {
      "id": "index of the layer",
      "command": "GetLayers",
      "creates": false,
      "params": {
        "attributeIds": [ { "attributeId": { "guid": "${layer}" } } ],
        "fields": [ "isHidden" ]
      },
      "save": { "layerIndex": "layers[0].index" },
      "expect": [
        { "expr": "${layerIndex}", "gt": 1, "name": "a layer of its own" }
      ]
    },
    {
      "id": "host wall",
      "command": "CreateWalls",
      "params": {
        "wallsData": [
          {
            "begCoordinate": { "x": 720.0, "y": 740.0 },
            "endCoordinate": { "x": 726.0, "y": 740.0 },
            "zCoordinate": 0.0,
            "height": 3.0,
            "thickness": 0.3
          }
        ]
      },
      "save": { "wall": "elements[0].elementId.guid" }
    },
    {
      "id": "opening in the wall",
      "command": "PlaceOpenings",
      "params": {
        "openingsData": [
          {
            "parentElementId": { "guid": "${wall}" },
            "point": { "x": 723.0, "y": 740.0, "z": 1.2 }
          }
        ]
      },
      "save": { "opening": "elements[0].elementId.guid" },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "opening placed" }
      ]
    },
    {
      "id": "set id and layer of the opening",
      "command": "SetDetailsOfElements",
      "creates": false,
      "params": {
        "elementsWithDetails": [
          { "elementId": { "guid": "${opening}" }, "details": { "id": "T-O1", "layerIndex": "${layerIndex}" } }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "id and layer set" }
      ]
    },
    {
      "id": "read the opening back",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": {
        "elements": [ { "elementId": { "guid": "${opening}" } } ]
      },
      "save": { "readLayerIndex": "detailsOfElements[0].layerIndex" },
      "expect": [
        { "path": "detailsOfElements[0].type", "eq": "Opening" },
        { "path": "detailsOfElements[0].id", "eq": "T-O1", "name": "id applied" },
        { "expr": "${readLayerIndex} - ${layerIndex}", "approx": 0, "name": "layer applied" },
        { "path": "detailsOfElements[0].details.error", "contains": "GetOpeningDetails", "name": "points to GetOpeningDetails" }
      ]
    },
    {
      "id": "only the id",
      "command": "SetDetailsOfElements",
      "creates": false,
      "params": {
        "elementsWithDetails": [
          { "elementId": { "guid": "${opening}" }, "details": { "id": "T-O2" } }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "id set" }
      ]
    },
    {
      "id": "second id read back",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": {
        "elements": [ { "elementId": { "guid": "${opening}" } } ]
      },
      "expect": [
        { "path": "detailsOfElements[0].id", "eq": "T-O2", "name": "second id applied" }
      ]
    }
  ],
  "teardown": [
    {
      "command": "DeleteAttributes",
      "params": {
        "attributesToDelete": [ { "attributeType": "Layer", "attributeId": { "attributeId": { "guid": "${layer}" } } } ]
      }
    }
  ]
}
