{
  "title": "SetLayoutSettings renames a master layout by its database id and by its navigator item (#2524)",
  "minTapir": "2.0.1",
  "minArchicad": "27",
  "steps": [
    {
      "id": "subset for the layout",
      "command": "CreateLayoutSubset",
      "creates": false,
      "params": { "subsetsData": [ { "name": "Tapir check master rename" } ] },
      "save": { "subset": "navigatorItems[0].navigatorItemId.guid" },
      "expect": [
        { "path": "navigatorItems[0].navigatorItemId.guid", "exists": true, "name": "id of the new subset" }
      ]
    },
    {
      "id": "layout on a new master",
      "command": "CreateLayout",
      "creates": false,
      "params": {
        "layoutsData": [
          {
            "layoutName": "Tapir check rename layout",
            "parentNavigatorItemId": { "guid": "${subset}" },
            "masterLayoutName": "Tapir check rename master",
            "paperWidth": 420,
            "paperHeight": 297
          }
        ]
      },
      "save": { "layoutDb": "databases[0].databaseId.guid" },
      "expect": [
        { "path": "databases[0].error", "exists": false, "name": "created" }
      ]
    },
    {
      "id": "read the layout and its master",
      "command": "GetLayoutSettings",
      "creates": false,
      "params": { "layoutDatabaseIds": [ { "databaseId": { "guid": "${layoutDb}" } } ] },
      "save": {
        "master": "layoutSettings[0].masterNavigatorItemId.guid",
        "masterDb": "layoutSettings[0].masterLayoutDatabaseId.guid"
      },
      "expect": [
        { "path": "layoutSettings[0].masterLayoutName", "eq": "Tapir check rename master" },
        { "path": "layoutSettings[0].masterLayoutDatabaseId.guid", "exists": true },
        { "path": "layoutSettings[0].masterNavigatorItemId.guid", "exists": true }
      ]
    },
    {
      "id": "[rename the master by its database id]",
      "command": "SetLayoutSettings",
      "creates": false,
      "params": {
        "layoutsData": [
          { "layoutDatabaseId": { "guid": "${masterDb}" }, "layoutName": "Tapir check master renamed" }
        ]
      },
      "expect": [
        { "path": "executionResults", "len": 1 },
        { "path": "executionResults[0].success", "eq": true, "name": "master renamed" }
      ]
    },
    {
      "id": "the layout shows the new master name",
      "command": "GetLayoutSettings",
      "creates": false,
      "params": { "layoutDatabaseIds": [ { "databaseId": { "guid": "${layoutDb}" } } ] },
      "expect": [
        { "path": "layoutSettings[0].masterLayoutName", "eq": "Tapir check master renamed", "name": "new name read back" },
        { "path": "layoutSettings[0].layoutName", "eq": "Tapir check rename layout", "name": "layout name kept" }
      ]
    },
    {
      "id": "[rename the master by its navigator item]",
      "command": "SetLayoutSettings",
      "creates": false,
      "params": {
        "layoutsData": [
          { "layoutNavigatorItemId": { "guid": "${master}" }, "layoutName": "Tapir check master renamed twice" }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "master renamed" }
      ]
    },
    {
      "id": "the layout shows the second master name, the master keeps its size",
      "command": "GetLayoutSettings",
      "creates": false,
      "params": {
        "layoutDatabaseIds": [
          { "databaseId": { "guid": "${layoutDb}" } },
          { "databaseId": { "guid": "${masterDb}" } }
        ]
      },
      "expect": [
        { "path": "layoutSettings[0].masterLayoutName", "eq": "Tapir check master renamed twice", "name": "second name read back" },
        { "path": "layoutSettings[1].horizontalSize", "approx": 420, "tol": 0.01, "name": "master width kept" },
        { "path": "layoutSettings[1].verticalSize", "approx": 297, "tol": 0.01, "name": "master height kept" }
      ]
    },
    {
      "id": "[rename the layout by its database id]",
      "command": "SetLayoutSettings",
      "creates": false,
      "params": {
        "layoutsData": [
          { "layoutDatabaseId": { "guid": "${layoutDb}" }, "layoutName": "Tapir check rename layout renamed" }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "layout renamed" }
      ]
    },
    {
      "id": "layout renamed, master untouched",
      "command": "GetLayoutSettings",
      "creates": false,
      "params": { "layoutDatabaseIds": [ { "databaseId": { "guid": "${layoutDb}" } } ] },
      "expect": [
        { "path": "layoutSettings[0].layoutName", "eq": "Tapir check rename layout renamed" },
        { "path": "layoutSettings[0].masterLayoutName", "eq": "Tapir check master renamed twice" }
      ]
    }
  ],
  "teardown": [
    { "command": "DeleteNavigatorItems", "params": { "navigatorItemIds": [ { "navigatorItemId": { "guid": "${subset}" } } ] } },
    { "command": "DeleteNavigatorItems", "params": { "navigatorItemIds": [ { "navigatorItemId": { "guid": "${master}" } } ] } }
  ]
}
