{
  "title": "ModifyRailings changes a post of a node and an inner post, a panel and a baluster set of a segment, refuses components the railing does not have (#2572)",
  "minTapir": "2.0.1",
  "steps": [
    {
      "id": "create a one-segment railing on story 0",
      "command": "CreateRailings",
      "params": {
        "railingsData": [
          {
            "coordinates": [
              { "x": 820.0, "y": 820.0 },
              { "x": 824.0, "y": 820.0 }
            ],
            "floorIndex": 0,
            "bottomOffset": 0.0,
            "height": 1.0
          }
        ]
      },
      "save": { "r": "elements[0].elementId.guid" },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "railing created" }
      ]
    },
    {
      "id": "components of the railing before the change",
      "command": "GetSubelementsOfHierarchicalElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${r}" } } ] },
      "save": { "post0": "subelements[0].railingPosts[0].elementId.guid" },
      "expect": [
        { "path": "subelements[0].railingSegments", "len": 1, "name": "one segment" },
        { "path": "subelements[0].railingNodes", "len": 2, "name": "two nodes" },
        { "path": "subelements[0].railingPosts[0].elementId.guid", "exists": true, "name": "the default railing has a post" },
        { "path": "subelements[0].railingInnerPosts[0].elementId.guid", "exists": true, "name": "the default railing has an inner post" },
        { "path": "subelements[0].railingPanels[0].elementId.guid", "exists": true, "name": "the default railing has a panel" },
        { "path": "subelements[0].railingBalusterSets[0].elementId.guid", "exists": true, "name": "the default railing has a baluster set" }
      ]
    },
    {
      "id": "vertical position of the post before the change",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${post0}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].type", "eq": "RailingPost", "name": "it is a post" },
        { "path": "detailsOfElements[0].details.verticalPosition.bottomRailIndex", "ne": 1, "name": "the post does not start at rail 1 yet, so setting 1 is a change" },
        { "path": "detailsOfElements[0].details.verticalPosition.topRailIndex", "gt": 1, "name": "the post reaches above rail 1, so it can start there" }
      ]
    },
    {
      "id": "ModifyRailings: the vertical position of the post of node 0",
      "command": "ModifyRailings",
      "creates": false,
      "params": {
        "railingsWithDetails": [
          {
            "elementId": { "guid": "${r}" },
            "nodes": [ { "index": 0, "posts": [ { "index": 0, "verticalPosition": { "bottomRailIndex": 1 } } ] } ]
          }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "post change accepted and read back" }
      ]
    },
    {
      "id": "ModifyRailings: frame and distribution of the first baluster set",
      "command": "ModifyRailings",
      "creates": false,
      "params": {
        "railingsWithDetails": [
          {
            "elementId": { "guid": "${r}" },
            "segments": [
              {
                "index": 0,
                "balusterSets": [
                  { "index": 0, "frame": { "lateralOffset": 0.02 }, "distribution": { "type": "PatternLength", "length": 0.15 } }
                ]
              }
            ]
          }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "baluster set change accepted and read back" }
      ]
    },
    {
      "id": "ModifyRailings: double post offset of the first inner post",
      "command": "ModifyRailings",
      "creates": false,
      "params": {
        "railingsWithDetails": [
          {
            "elementId": { "guid": "${r}" },
            "segments": [ { "index": 0, "innerPosts": [ { "index": 0, "doublePostOffset": 0.06 } ] } ]
          }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "inner post change accepted and read back" }
      ]
    },
    {
      "id": "ModifyRailings: visibility and top offset of the first panel",
      "command": "ModifyRailings",
      "creates": false,
      "params": {
        "railingsWithDetails": [
          {
            "elementId": { "guid": "${r}" },
            "segments": [ { "index": 0, "panels": [ { "index": 0, "visible": true, "frame": { "topOffset": 0.1 } } ] } ]
          }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "panel change accepted and read back" }
      ]
    },
    {
      "id": "components of the railing after the change",
      "command": "GetSubelementsOfHierarchicalElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${r}" } } ] },
      "save": {
        "post": "subelements[0].railingPosts[0].elementId.guid",
        "innerPost": "subelements[0].railingInnerPosts[0].elementId.guid",
        "panel": "subelements[0].railingPanels[0].elementId.guid",
        "balusterSet": "subelements[0].railingBalusterSets[0].elementId.guid"
      },
      "expect": [
        { "path": "subelements[0].railingSegments", "len": 1, "name": "still one segment" },
        { "path": "subelements[0].railingBalusterSets[0].elementId.guid", "exists": true, "name": "the baluster set is still there" }
      ]
    },
    {
      "id": "details of the post, the inner post, the panel and the baluster set",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": {
        "elements": [
          { "elementId": { "guid": "${post}" } },
          { "elementId": { "guid": "${innerPost}" } },
          { "elementId": { "guid": "${panel}" } },
          { "elementId": { "guid": "${balusterSet}" } },
          { "elementId": { "guid": "${r}" } }
        ]
      },
      "expect": [
        { "path": "detailsOfElements[0].type", "eq": "RailingPost", "name": "first is the post" },
        { "path": "detailsOfElements[0].details.verticalPosition.bottomRailIndex", "eq": 1, "name": "the post got its bottom rail index" },
        { "path": "detailsOfElements[1].type", "eq": "RailingInnerPost", "name": "second is the inner post" },
        { "path": "detailsOfElements[1].details.doublePostOffset", "approx": 0.06, "name": "the inner post got its double post offset" },
        { "path": "detailsOfElements[2].type", "eq": "RailingPanel", "name": "third is the panel" },
        { "path": "detailsOfElements[2].details.visible", "eq": true, "name": "the panel is visible" },
        { "path": "detailsOfElements[2].details.frame.topOffset", "approx": 0.1, "name": "the panel got its top offset" },
        { "path": "detailsOfElements[3].type", "eq": "RailingBalusterSet", "name": "fourth is the baluster set" },
        { "path": "detailsOfElements[3].details.frame.lateralOffset", "approx": 0.02, "name": "the baluster set got its lateral offset" },
        { "path": "detailsOfElements[3].details.distribution.type", "eq": "PatternLength", "name": "the baluster set got its distribution type" },
        { "path": "detailsOfElements[3].details.distribution.length", "approx": 0.15, "name": "the baluster set got its distribution length" },
        { "path": "detailsOfElements[4].details.segments[0].height", "approx": 1.0, "name": "the segment height is kept" },
        { "path": "detailsOfElements[4].details.referenceLine[1].x", "approx": 824.0, "name": "the reference line is kept" }
      ]
    },
    {
      "id": "ModifyRailings: components the railing does not have, and a baluster set with no fields",
      "command": "ModifyRailings",
      "creates": false,
      "params": {
        "railingsWithDetails": [
          { "elementId": { "guid": "${r}" }, "nodes": [ { "index": 0, "posts": [ { "index": 99, "verticalPosition": { "bottomRailIndex": 0 } } ] } ] },
          { "elementId": { "guid": "${r}" }, "segments": [ { "index": 0, "panels": [ { "index": 99, "visible": false } ] } ] },
          { "elementId": { "guid": "${r}" }, "segments": [ { "index": 0, "innerPosts": [ { "index": 99, "doublePostOffset": 0.1 } ] } ] },
          { "elementId": { "guid": "${r}" }, "segments": [ { "index": 0, "balusterSets": [ { "index": 0 } ] } ] },
          { "elementId": { "guid": "${r}" }, "segments": [ { "index": 0, "panels": [ { "index": 0, "visible": false } ] }, { "index": 1, "balusterSets": [ { "index": 0, "frame": { "lateralOffset": 0.0 } } ] } ] }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": false, "name": "a post the node does not have refused" },
        { "path": "executionResults[1].success", "eq": false, "name": "a panel the segment does not have refused" },
        { "path": "executionResults[2].success", "eq": false, "name": "an inner post the segment does not have refused" },
        { "path": "executionResults[3].success", "eq": false, "name": "a baluster set with no fields refused" },
        { "path": "executionResults[4].success", "eq": false, "name": "a segment the railing does not have refused, with the valid panel change of the same item" }
      ]
    },
    {
      "id": "the refused items changed nothing",
      "command": "GetSubelementsOfHierarchicalElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${r}" } } ] },
      "save": {
        "panel2": "subelements[0].railingPanels[0].elementId.guid",
        "balusterSet2": "subelements[0].railingBalusterSets[0].elementId.guid"
      },
      "expect": [
        { "path": "subelements[0].railingPanels[0].elementId.guid", "exists": true, "name": "the panel is still there" }
      ]
    },
    {
      "id": "panel and baluster set after the refused items",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": {
        "elements": [
          { "elementId": { "guid": "${panel2}" } },
          { "elementId": { "guid": "${balusterSet2}" } }
        ]
      },
      "expect": [
        { "path": "detailsOfElements[0].details.visible", "eq": true, "name": "the panel is still visible" },
        { "path": "detailsOfElements[1].details.frame.lateralOffset", "approx": 0.02, "name": "the baluster set lateral offset is unchanged" }
      ]
    }
  ]
}
