{
  "title": "ModifyRailings hides the top rail and changes a rail and a handrail of a segment, refuses rails the segment does not have (#2572)",
  "minTapir": "2.0.1",
  "steps": [
    {
      "id": "create a one-segment railing on story 0",
      "command": "CreateRailings",
      "params": {
        "railingsData": [
          {
            "coordinates": [
              { "x": 800.0, "y": 800.0 },
              { "x": 804.0, "y": 800.0 }
            ],
            "floorIndex": 0,
            "bottomOffset": 0.0,
            "height": 1.0
          }
        ]
      },
      "save": { "r": "elements[0].elementId.guid" },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "railing created" }
      ]
    },
    {
      "id": "components of the railing before the change",
      "command": "GetSubelementsOfHierarchicalElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${r}" } } ] },
      "expect": [
        { "path": "subelements[0].railingSegments", "len": 1, "name": "one segment" },
        { "path": "subelements[0].railingToprails", "len": 1, "name": "one top rail for the segment" },
        { "path": "subelements[0].railingRails[0].elementId.guid", "exists": true, "name": "the segment has a rail" },
        { "path": "subelements[0].railingHandrails[0].elementId.guid", "exists": true, "name": "the segment has a handrail" }
      ]
    },
    {
      "id": "ModifyRailings: hide the top rail, move the first rail",
      "command": "ModifyRailings",
      "creates": false,
      "params": {
        "railingsWithDetails": [
          {
            "elementId": { "guid": "${r}" },
            "segments": [
              {
                "index": 0,
                "toprail": { "visible": false },
                "rails": [ { "index": 0, "relative": false, "height": 0.4, "horizontalOffset": 0.03 } ]
              }
            ]
          }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "top rail and rail change accepted and read back" }
      ]
    },
    {
      "id": "ModifyRailings: move the first handrail",
      "command": "ModifyRailings",
      "creates": false,
      "params": {
        "railingsWithDetails": [
          {
            "elementId": { "guid": "${r}" },
            "segments": [
              { "index": 0, "handrails": [ { "index": 0, "height": 0.85, "horizontalOffset": 0.05 } ] }
            ]
          }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "handrail change accepted and read back" }
      ]
    },
    {
      "id": "components of the railing after the change",
      "command": "GetSubelementsOfHierarchicalElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${r}" } } ] },
      "save": {
        "toprail": "subelements[0].railingToprails[0].elementId.guid",
        "rail": "subelements[0].railingRails[0].elementId.guid",
        "handrail": "subelements[0].railingHandrails[0].elementId.guid"
      },
      "expect": [
        { "path": "subelements[0].railingToprails", "len": 1, "name": "still one top rail" },
        { "path": "subelements[0].railingRails[0].elementId.guid", "exists": true, "name": "the rail is still there" }
      ]
    },
    {
      "id": "details of the top rail, the rail and the handrail",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": {
        "elements": [
          { "elementId": { "guid": "${toprail}" } },
          { "elementId": { "guid": "${rail}" } },
          { "elementId": { "guid": "${handrail}" } },
          { "elementId": { "guid": "${r}" } }
        ]
      },
      "expect": [
        { "path": "detailsOfElements[0].type", "eq": "RailingToprail", "name": "first is the top rail" },
        { "path": "detailsOfElements[0].details.visible", "eq": false, "name": "the top rail is hidden" },
        { "path": "detailsOfElements[1].type", "eq": "RailingRail", "name": "second is the rail" },
        { "path": "detailsOfElements[1].details.relative", "eq": false, "name": "the rail is not relative" },
        { "path": "detailsOfElements[1].details.height", "approx": 0.4, "name": "the rail got its height" },
        { "path": "detailsOfElements[1].details.horizontalOffset", "approx": 0.03, "name": "the rail got its horizontal offset" },
        { "path": "detailsOfElements[2].type", "eq": "RailingHandrail", "name": "third is the handrail" },
        { "path": "detailsOfElements[2].details.height", "approx": 0.85, "name": "the handrail got its height" },
        { "path": "detailsOfElements[2].details.horizontalOffset", "approx": 0.05, "name": "the handrail got its horizontal offset" },
        { "path": "detailsOfElements[3].details.segments[0].height", "approx": 1.0, "name": "the segment height is kept" },
        { "path": "detailsOfElements[3].details.referenceLine[1].x", "approx": 804.0, "name": "the reference line is kept" }
      ]
    },
    {
      "id": "ModifyRailings: rails and handrails the segment does not have, and a rail with no fields",
      "command": "ModifyRailings",
      "creates": false,
      "params": {
        "railingsWithDetails": [
          { "elementId": { "guid": "${r}" }, "segments": [ { "index": 0, "rails": [ { "index": 99, "height": 0.2 } ] } ] },
          { "elementId": { "guid": "${r}" }, "segments": [ { "index": 0, "handrails": [ { "index": 99, "height": 0.2 } ] } ] },
          { "elementId": { "guid": "${r}" }, "segments": [ { "index": 0, "rails": [ { "index": 0 } ] } ] },
          { "elementId": { "guid": "${r}" }, "segments": [ { "index": 1, "toprail": { "visible": true } } ] }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": false, "name": "a rail the segment does not have refused" },
        { "path": "executionResults[1].success", "eq": false, "name": "a handrail the segment does not have refused" },
        { "path": "executionResults[2].success", "eq": false, "name": "a rail with no fields refused" },
        { "path": "executionResults[3].success", "eq": false, "name": "a segment the railing does not have refused" }
      ]
    },
    {
      "id": "the refused items changed nothing",
      "command": "GetSubelementsOfHierarchicalElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${r}" } } ] },
      "save": {
        "toprail2": "subelements[0].railingToprails[0].elementId.guid",
        "rail2": "subelements[0].railingRails[0].elementId.guid"
      },
      "expect": [
        { "path": "subelements[0].railingToprails", "len": 1, "name": "still one top rail" }
      ]
    },
    {
      "id": "top rail and rail after the refused items",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": {
        "elements": [
          { "elementId": { "guid": "${toprail2}" } },
          { "elementId": { "guid": "${rail2}" } }
        ]
      },
      "expect": [
        { "path": "detailsOfElements[0].details.visible", "eq": false, "name": "the top rail is still hidden" },
        { "path": "detailsOfElements[1].details.height", "approx": 0.4, "name": "the rail height is unchanged" }
      ]
    }
  ]
}
