{
  "title": "GetZoneBoundaries and GetElementConnections read a zone in a room of four walls",
  "minTapir": "1.8.1",
  "minArchicad": "28",
  "steps": [
    {
      "id": "room of four basic walls, and a wall apart",
      "command": "CreateWalls",
      "params": {
        "wallsData": [
          { "begCoordinate": { "x": 700, "y": 700 }, "endCoordinate": { "x": 706, "y": 700 }, "floorIndex": 0, "zCoordinate": 0,
            "height": 3.0, "thickness": 0.2, "structureType": "Basic", "referenceLineLocation": "Center", "offset": 0.0 },
          { "begCoordinate": { "x": 706, "y": 700 }, "endCoordinate": { "x": 706, "y": 705 }, "floorIndex": 0, "zCoordinate": 0,
            "height": 3.0, "thickness": 0.2, "structureType": "Basic", "referenceLineLocation": "Center", "offset": 0.0 },
          { "begCoordinate": { "x": 706, "y": 705 }, "endCoordinate": { "x": 700, "y": 705 }, "floorIndex": 0, "zCoordinate": 0,
            "height": 3.0, "thickness": 0.2, "structureType": "Basic", "referenceLineLocation": "Center", "offset": 0.0 },
          { "begCoordinate": { "x": 700, "y": 705 }, "endCoordinate": { "x": 700, "y": 700 }, "floorIndex": 0, "zCoordinate": 0,
            "height": 3.0, "thickness": 0.2, "structureType": "Basic", "referenceLineLocation": "Center", "offset": 0.0 },
          { "begCoordinate": { "x": 720, "y": 700 }, "endCoordinate": { "x": 724, "y": 700 }, "floorIndex": 0, "zCoordinate": 0,
            "height": 3.0, "thickness": 0.2, "structureType": "Basic", "referenceLineLocation": "Center", "offset": 0.0 }
        ]
      },
      "save": {
        "w1": "elements[0].elementId.guid", "w2": "elements[1].elementId.guid",
        "w3": "elements[2].elementId.guid", "w4": "elements[3].elementId.guid",
        "w5": "elements[4].elementId.guid"
      }
    },
    {
      "id": "manual zone filling the room",
      "command": "CreateZones",
      "params": {
        "zonesData": [
          { "name": "Tapir check zone", "numberStr": "T1", "floorIndex": 0, "height": 2.5, "bottomOffset": 0.0, "floorThickness": 0.0,
            "geometry": { "polygonCoordinates": [ { "x": 700.1, "y": 700.1 }, { "x": 705.9, "y": 700.1 }, { "x": 705.9, "y": 704.9 }, { "x": 700.1, "y": 704.9 } ] } }
        ]
      },
      "save": { "z1": "elements[0].elementId.guid" }
    },
    {
      "id": "boundaries of [zone, wall, bogus]",
      "command": "GetZoneBoundaries",
      "creates": false,
      "params": {
        "zones": [
          { "elementId": { "guid": "${z1}" } },
          { "elementId": { "guid": "${w1}" } },
          { "elementId": { "guid": "00000000-0000-0000-0000-00000000BEEF" } }
        ]
      },
      "expect": [
        { "path": "zoneBoundariesOfZones", "len": 3, "name": "one item per zone" },
        { "path": "zoneBoundariesOfZones[0].zoneBoundaries[0].connectedElementId.guid", "exists": true, "name": "zone: a boundary names its element" },
        { "path": "zoneBoundariesOfZones[0].zoneBoundaries[3].connectedElementId.guid", "exists": true, "name": "zone: at least one boundary per wall" },
        { "path": "zoneBoundariesOfZones[0].zoneBoundaries[0].area", "gt": 0, "name": "zone: a boundary has an area" },
        { "path": "zoneBoundariesOfZones[0].zoneBoundaries[0].isExternal", "exists": true, "name": "zone: a boundary says whether it is external" },
        { "path": "zoneBoundariesOfZones[0].zoneBoundaries[0].polygonOutline[2]", "exists": true, "name": "zone: a boundary has its outline" },
        { "path": "zoneBoundariesOfZones[1].error", "exists": true, "name": "wall: not a zone, an error item" },
        { "path": "zoneBoundariesOfZones[2].error", "exists": true, "name": "unknown element is an error item" }
      ]
    },
    {
      "id": "boundaries of the zone by zoneElementId",
      "command": "GetZoneBoundaries",
      "creates": false,
      "params": { "zoneElementId": { "guid": "${z1}" } },
      "expect": [
        { "path": "zoneBoundaries[3].connectedElementId.guid", "exists": true, "name": "at least one boundary per wall" }
      ]
    },
    {
      "id": "neither zoneElementId nor zones",
      "command": "GetZoneBoundaries",
      "creates": false,
      "params": {},
      "expect": [
        { "path": "error", "exists": true, "name": "fails" }
      ]
    },
    {
      "id": "both zoneElementId and zones",
      "command": "GetZoneBoundaries",
      "creates": false,
      "params": { "zoneElementId": { "guid": "${z1}" }, "zones": [ { "elementId": { "guid": "${z1}" } } ] },
      "expect": [
        { "path": "error", "exists": true, "name": "fails" }
      ]
    },
    {
      "id": "connections among [four room walls, wall apart, bogus]",
      "command": "GetElementConnections",
      "creates": false,
      "params": {
        "elements": [
          { "elementId": { "guid": "${w1}" } },
          { "elementId": { "guid": "${w2}" } },
          { "elementId": { "guid": "${w3}" } },
          { "elementId": { "guid": "${w4}" } },
          { "elementId": { "guid": "${w5}" } },
          { "elementId": { "guid": "00000000-0000-0000-0000-00000000BEEF" } }
        ]
      },
      "expect": [
        { "path": "executionResults", "len": 6, "name": "one result per element" },
        { "path": "executionResults[0].success", "eq": true, "name": "room wall 1 found" },
        { "path": "executionResults[3].success", "eq": true, "name": "room wall 4 found" },
        { "path": "executionResults[4].success", "eq": true, "name": "wall apart found" },
        { "path": "executionResults[5].success", "eq": false, "name": "unknown element not found" },
        { "path": "connections", "len": 4, "name": "one connection per room corner" },
        { "path": "connections[0].elementId1.guid", "exists": true, "name": "connection names its first element" },
        { "path": "connections[0].elementId2.guid", "exists": true, "name": "connection names its second element" },
        { "path": "connections[0].polygons[0].coordinates[2]", "exists": true, "name": "connection has its touching polygon" }
      ]
    },
    {
      "id": "connections between a room wall and the wall apart",
      "command": "GetElementConnections",
      "creates": false,
      "params": {
        "elements": [
          { "elementId": { "guid": "${w1}" } },
          { "elementId": { "guid": "${w5}" } }
        ]
      },
      "expect": [
        { "path": "connections", "len": 0, "name": "they do not touch" }
      ]
    }
  ]
}
