{
  "title": "RenameNavigatorItem with autotext tokens in the new name reports success, and GetNavigatorItemTree reads the custom name back (#2499)",
  "minTapir": "2.0.1",
  "steps": [
    {
      "id": "a story of the Project Map",
      "command": "GetNavigatorItemTree",
      "creates": false,
      "stopOnFail": true,
      "params": { "navigatorMapId": "ProjectMap" },
      "save": {
        "story": "navigatorItemTree.children[0].navigatorItem.children[0].navigatorItem.navigatorItemId.guid"
      },
      "expect": [
        { "path": "navigatorItemTree.children[0].navigatorItem.children[0].navigatorItem.type", "eq": "StoryItem", "name": "first item of the first Project Map group is a story" }
      ]
    },
    {
      "id": "View Map before",
      "command": "GetNavigatorItemTree",
      "creates": false,
      "params": { "navigatorMapId": "PublicViewMap" },
      "save": {
        "viewRoot": "navigatorItemTree.navigatorItemId.guid",
        "viewFirst": "navigatorItemTree.children[0].navigatorItem.navigatorItemId.guid"
      }
    },
    {
      "id": "folder",
      "command": "CreateViewMapFolder",
      "creates": false,
      "params": { "folderName": "TapirCheck autotext folder" },
      "save": { "folder": "navigatorItemId.guid" }
    },
    {
      "id": "folder second in the View Map",
      "command": "MoveNavigatorItem",
      "creates": false,
      "params": {
        "navigatorItemIdToMove": { "guid": "${folder}" },
        "parentNavigatorItemId": { "guid": "${viewRoot}" },
        "previousNavigatorItemId": { "guid": "${viewFirst}" }
      },
      "expect": [
        { "path": "success", "eq": true }
      ]
    },
    {
      "id": "clone the story into the folder",
      "command": "CloneProjectMapItemToViewMap",
      "creates": false,
      "params": {
        "viewsData": [
          { "navigatorItemId": { "guid": "${story}" }, "parentNavigatorItemId": { "guid": "${folder}" } }
        ]
      },
      "save": { "view": "navigatorItems[0].navigatorItemId.guid" },
      "expect": [
        { "path": "navigatorItems[0].navigatorItemId.guid", "exists": true, "name": "view created" }
      ]
    },
    {
      "id": "rename the view with an autotext token",
      "command": "RenameNavigatorItem",
      "creates": false,
      "params": { "navigatorItemId": { "guid": "${view}" }, "newName": "TapirCheck <SourceItemName> view" },
      "expect": [
        { "path": "success", "eq": true, "name": "reported as applied" }
      ]
    },
    {
      "id": "the view has a custom name",
      "command": "GetNavigatorItemTree",
      "creates": false,
      "params": { "navigatorMapId": "PublicViewMap" },
      "expect": [
        { "path": "navigatorItemTree.children[1].navigatorItem.name", "eq": "TapirCheck autotext folder", "name": "second item is the folder" },
        { "path": "navigatorItemTree.children[1].navigatorItem.children[0].navigatorItem.customName", "eq": true },
        { "path": "navigatorItemTree.children[1].navigatorItem.children[0].navigatorItem.name", "contains": "TapirCheck", "name": "renamed" },
        { "path": "navigatorItemTree.children[1].navigatorItem.children[0].navigatorItem.autoTextedName", "eq": "TapirCheck <SourceItemName> view", "name": "autotext kept" }
      ]
    },
    {
      "id": "rename the view without autotext",
      "command": "RenameNavigatorItem",
      "creates": false,
      "params": { "navigatorItemId": { "guid": "${view}" }, "newName": "TapirCheck plain view" },
      "expect": [
        { "path": "success", "eq": true }
      ]
    },
    {
      "id": "a name without autotext has no autoTextedName",
      "command": "GetNavigatorItemTree",
      "creates": false,
      "params": { "navigatorMapId": "PublicViewMap" },
      "expect": [
        { "path": "navigatorItemTree.children[1].navigatorItem.children[0].navigatorItem.name", "eq": "TapirCheck plain view" },
        { "path": "navigatorItemTree.children[1].navigatorItem.children[0].navigatorItem.autoTextedName", "exists": false }
      ]
    },
    {
      "id": "drop the custom name",
      "command": "RenameNavigatorItem",
      "creates": false,
      "params": { "navigatorItemId": { "guid": "${view}" }, "customName": false },
      "expect": [
        { "path": "success", "eq": true }
      ]
    },
    {
      "id": "the view follows its source again",
      "command": "GetNavigatorItemTree",
      "creates": false,
      "params": { "navigatorMapId": "PublicViewMap" },
      "expect": [
        { "path": "navigatorItemTree.children[1].navigatorItem.children[0].navigatorItem.customName", "eq": false }
      ]
    }
  ],
  "teardown": [
    { "command": "DeleteNavigatorItems", "params": { "navigatorItemIds": [ { "navigatorItemId": { "guid": "${view}" } } ] } },
    { "command": "DeleteNavigatorItems", "params": { "navigatorItemIds": [ { "navigatorItemId": { "guid": "${folder}" } } ] } }
  ]
}
