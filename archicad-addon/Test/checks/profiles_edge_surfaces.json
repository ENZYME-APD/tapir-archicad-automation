{
  "title": "CreateProfiles sets a custom surface per profile edge, GetProfiles reads it back (#2586)",
  "minTapir": "2.0.1",
  "minArchicad": "27",
  "requiresEmpty": [],
  "steps": [
    {
      "id": "two surfaces",
      "command": "GetAttributesByType",
      "creates": false,
      "params": {"attributeType": "Surface"},
      "save": {"s1": "attributes[0].attributeId.guid", "s2": "attributes[1].attributeId.guid"},
      "expect": [
        {"path": "attributes[1].attributeId.guid", "exists": true, "name": "the project has two surfaces"}
      ]
    },
    {
      "id": "a building material",
      "command": "GetAttributesByType",
      "creates": false,
      "params": {"attributeType": "BuildingMaterial"},
      "save": {"bm": "attributes[0].attributeId.guid"}
    },
    {
      "id": "create from newSkins: the bottom edge (index 1) gets surface s1",
      "command": "CreateProfiles",
      "creates": false,
      "params": {
        "profileDataArray": [
          {
            "name": "TapirCheck Profile 2586 edge surfaces",
            "wallType": true,
            "newSkins": [
              {
                "contours": [{"polygonCoordinates": [{"x": 0.0, "y": 0.0}, {"x": 0.2, "y": 0.0}, {"x": 0.2, "y": 0.25}, {"x": 0.0, "y": 0.25}]}],
                "buildingMaterialId": {"attributeId": {"guid": "${bm}"}},
                "isCore": true,
                "edgeOverrides": [
                  {"edgeIndex": 1, "surfaceId": {"attributeId": {"guid": "${s1}"}}}
                ]
              }
            ]
          }
        ]
      },
      "save": {"p1": "attributeIds[0].attributeId.guid"},
      "expect": [
        {"path": "attributeIds", "len": 1},
        {"path": "attributeIds[0].error", "exists": false, "name": "no error"}
      ]
    },
    {
      "id": "read back the edge surfaces",
      "command": "GetProfiles",
      "creates": false,
      "params": {"attributeIds": [{"attributeId": {"guid": "${p1}"}}], "fields": ["skins"]},
      "save": {"skin": "profiles[0].skins[0].skinId"},
      "expect": [
        {"path": "profiles[0].skins", "len": 1},
        {"path": "profiles[0].skins[0].edges[1].surfaceFromBuildingMaterial", "eq": false, "name": "edge 1 has a custom surface"},
        {"path": "profiles[0].skins[0].edges[1].surfaceId.attributeId.guid", "eq": "${s1}", "name": "edge 1 surface is s1"},
        {"path": "profiles[0].skins[0].edges[2].surfaceFromBuildingMaterial", "eq": true, "name": "edge 2 takes the building material's surface"},
        {"path": "profiles[0].skins[0].edges[2].surfaceId", "exists": false, "name": "edge 2 has no custom surface"},
        {"path": "profiles[0].skins[0].edges[2].buildingMaterialId", "exists": false, "name": "edge 2 reports no building material of its own"}
      ]
    },
    {
      "id": "skinOverrides: edge 2 gets surface s2, edge 1 goes back to the building material's surface",
      "command": "CreateProfiles",
      "creates": false,
      "params": {
        "profileDataArray": [
          {
            "attributeId": {"guid": "${p1}"},
            "name": "TapirCheck Profile 2586 edge surfaces",
            "skinOverrides": [
              {
                "skinId": "${skin}",
                "edgeOverrides": [
                  {"edgeIndex": 2, "surfaceId": {"attributeId": {"guid": "${s2}"}}},
                  {"edgeIndex": 1, "surfaceFromBuildingMaterial": true}
                ]
              }
            ]
          }
        ],
        "overwriteExisting": true
      },
      "expect": [
        {"path": "attributeIds", "len": 1},
        {"path": "attributeIds[0].error", "exists": false, "name": "no error"}
      ]
    },
    {
      "id": "read back the changed edge surfaces",
      "command": "GetProfiles",
      "creates": false,
      "params": {"attributeIds": [{"attributeId": {"guid": "${p1}"}}], "fields": ["skins"]},
      "expect": [
        {"path": "profiles[0].skins", "len": 1},
        {"path": "profiles[0].skins[0].edges[2].surfaceFromBuildingMaterial", "eq": false, "name": "edge 2 has a custom surface"},
        {"path": "profiles[0].skins[0].edges[2].surfaceId.attributeId.guid", "eq": "${s2}", "name": "edge 2 surface is s2"},
        {"path": "profiles[0].skins[0].edges[1].surfaceFromBuildingMaterial", "eq": true, "name": "edge 1 back to the building material's surface"},
        {"path": "profiles[0].skins[0].edges[1].surfaceId", "exists": false, "name": "edge 1 no longer reports a custom surface"},
        {"path": "profiles[0].skins[0].edges[1].buildingMaterialId", "exists": false, "name": "edge 1's old surface index is not reported as a building material"}
      ]
    }
  ],
  "teardown": [
    {
      "command": "DeleteAttributes",
      "params": {"attributesToDelete": [{"attributeType": "Profile", "attributeId": {"attributeId": {"guid": "${p1}"}}}]}
    }
  ]
}
