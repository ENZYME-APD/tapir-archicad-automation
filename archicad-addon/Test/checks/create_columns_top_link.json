{
  "title": "CreateColumns links the column's top to a story with relativeTopStory and topOffset, as ModifyColumns does (#2552)",
  "minTapir": "2.0.1",
  "steps": [
    {
      "id": "column created linked to the story above, 15 cm below its level",
      "command": "CreateColumns",
      "params": {
        "columnsData": [
          {
            "coordinates": { "x": 960.0, "y": 760.0, "z": 0.0 },
            "floorIndex": 0,
            "width": 0.3,
            "depth": 0.3,
            "relativeTopStory": 1,
            "topOffset": -0.15
          }
        ]
      },
      "save": { "linked": "elements[0].elementId.guid" },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "linked column created" }
      ]
    },
    {
      "id": "reference column: explicit height at creation, linked afterwards by ModifyColumns",
      "command": "CreateColumns",
      "params": {
        "columnsData": [
          {
            "coordinates": { "x": 963.0, "y": 760.0, "z": 0.0 },
            "floorIndex": 0,
            "width": 0.3,
            "depth": 0.3,
            "height": 3.0
          }
        ]
      },
      "save": { "reference": "elements[0].elementId.guid" },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "reference column created" }
      ]
    },
    {
      "id": "link the reference column with ModifyColumns",
      "command": "ModifyColumns",
      "creates": false,
      "params": {
        "columnsWithDetails": [
          { "elementId": { "guid": "${reference}" }, "relativeTopStory": 1, "topOffset": -0.15 }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "reference column linked" }
      ]
    },
    {
      "id": "read both columns",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${linked}" } }, { "elementId": { "guid": "${reference}" } } ] },
      "save": { "linkedHeight": "detailsOfElements[0].details.height", "referenceHeight": "detailsOfElements[1].details.height" },
      "expect": [
        { "path": "detailsOfElements[0].details.relativeTopStory", "eq": 1, "name": "created column is linked to the story above" },
        { "path": "detailsOfElements[0].details.topOffset", "approx": -0.15, "name": "created column keeps the top offset" },
        { "path": "detailsOfElements[1].details.relativeTopStory", "eq": 1 },
        { "path": "detailsOfElements[1].details.topOffset", "approx": -0.15 }
      ]
    },
    {
      "id": "same height as the column linked by ModifyColumns",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${linked}" } } ] },
      "expect": [
        { "expr": "${linkedHeight} - ${referenceHeight}", "approx": 0, "name": "height computed from the story levels and topOffset" },
        { "expr": "${linkedHeight}", "gt": 0, "name": "positive height" }
      ]
    },
    {
      "id": "height together with a link, and a link to a story that does not exist, are refused",
      "command": "CreateColumns",
      "creates": false,
      "params": {
        "columnsData": [
          {
            "coordinates": { "x": 966.0, "y": 760.0, "z": 0.0 },
            "floorIndex": 0,
            "height": 3.0,
            "relativeTopStory": 1
          },
          {
            "coordinates": { "x": 969.0, "y": 760.0, "z": 0.0 },
            "floorIndex": 0,
            "relativeTopStory": 999
          }
        ]
      },
      "expect": [
        { "path": "elements", "len": 2, "name": "one result per item" },
        { "path": "elements[0].error.code", "exists": true, "name": "height with a link refused" },
        { "path": "elements[1].error.code", "exists": true, "name": "missing story refused" }
      ]
    },
    {
      "id": "an explicit height still unlinks the top",
      "command": "CreateColumns",
      "params": {
        "columnsData": [
          {
            "coordinates": { "x": 972.0, "y": 760.0, "z": 0.0 },
            "floorIndex": 0,
            "height": 2.5,
            "relativeTopStory": 0
          }
        ]
      },
      "save": { "explicit": "elements[0].elementId.guid" },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true }
      ]
    },
    {
      "id": "read the column with an explicit height",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${explicit}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.relativeTopStory", "eq": 0 },
        { "path": "detailsOfElements[0].details.height", "approx": 2.5 }
      ]
    }
  ]
}
