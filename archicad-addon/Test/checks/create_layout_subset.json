{
  "title": "CreateLayoutSubset answers the id of every subset it creates: without a parent, under a subset and under the Layout Book item (#2627)",
  "minTapir": "1.8.1",
  "minArchicad": "27",
  "steps": [
    {
      "id": "Layout Book item",
      "command": "GetNavigatorItemTree",
      "creates": false,
      "params": { "navigatorMapId": "LayoutBook" },
      "save": { "bookRoot": "navigatorItemTree.navigatorItemId.guid" }
    },
    {
      "id": "subset without a parent",
      "command": "CreateLayoutSubset",
      "creates": false,
      "params": { "subsetsData": [ { "name": "Tapir check subset no parent" } ] },
      "save": { "subsetA": "navigatorItems[0].navigatorItemId.guid" },
      "expect": [
        { "path": "navigatorItems", "len": 1, "name": "one result" },
        { "path": "navigatorItems[0].error", "exists": false, "name": "no error" },
        { "path": "navigatorItems[0].navigatorItemId.guid", "exists": true, "name": "id of the new subset" }
      ]
    },
    {
      "id": "subset under the first subset",
      "command": "CreateLayoutSubset",
      "creates": false,
      "params": {
        "subsetsData": [
          { "name": "Tapir check subset in subset", "parentNavigatorItemId": { "guid": "${subsetA}" } }
        ]
      },
      "save": { "subsetB": "navigatorItems[0].navigatorItemId.guid" },
      "expect": [
        { "path": "navigatorItems[0].error", "exists": false, "name": "no error" },
        { "path": "navigatorItems[0].navigatorItemId.guid", "exists": true, "name": "id of the nested subset" }
      ]
    },
    {
      "id": "subset under the Layout Book item",
      "command": "CreateLayoutSubset",
      "creates": false,
      "params": {
        "subsetsData": [
          { "name": "Tapir check subset in book", "parentNavigatorItemId": { "guid": "${bookRoot}" } }
        ]
      },
      "save": { "subsetC": "navigatorItems[0].navigatorItemId.guid" },
      "expect": [
        { "path": "navigatorItems[0].error", "exists": false, "name": "no error" },
        { "path": "navigatorItems[0].navigatorItemId.guid", "exists": true, "name": "id of the subset in the book" }
      ]
    },
    {
      "id": "the ids are the created subsets",
      "command": "GetLayoutSubsetSettings",
      "creates": false,
      "params": {
        "navigatorItemIds": [
          { "navigatorItemId": { "guid": "${subsetA}" } },
          { "navigatorItemId": { "guid": "${subsetB}" } },
          { "navigatorItemId": { "guid": "${subsetC}" } }
        ]
      },
      "expect": [
        { "path": "subsetSettings", "len": 3, "name": "one result per subset" },
        { "path": "subsetSettings[0].name", "eq": "Tapir check subset no parent" },
        { "path": "subsetSettings[1].name", "eq": "Tapir check subset in subset" },
        { "path": "subsetSettings[2].name", "eq": "Tapir check subset in book" }
      ]
    },
    {
      "id": "each subset is where it was asked for",
      "command": "GetNavigatorParentItems",
      "creates": false,
      "params": {
        "navigatorItemIds": [
          { "navigatorItemId": { "guid": "${subsetA}" } },
          { "navigatorItemId": { "guid": "${subsetB}" } },
          { "navigatorItemId": { "guid": "${subsetC}" } }
        ]
      },
      "expect": [
        { "path": "parentItems[0].type", "eq": "BookItem", "name": "no parent: in the Layout Book" },
        { "path": "parentItems[1].type", "eq": "SubSetItem", "name": "nested: in a subset" },
        { "path": "parentItems[1].name", "contains": "Tapir check subset no parent", "name": "nested: in the first subset" },
        { "path": "parentItems[2].type", "eq": "BookItem", "name": "in the Layout Book item" }
      ]
    }
  ],
  "teardown": [
    { "command": "DeleteNavigatorItems", "params": { "navigatorItemIds": [ { "navigatorItemId": { "guid": "${subsetB}" } } ] } },
    { "command": "DeleteNavigatorItems", "params": { "navigatorItemIds": [ { "navigatorItemId": { "guid": "${subsetA}" } } ] } },
    { "command": "DeleteNavigatorItems", "params": { "navigatorItemIds": [ { "navigatorItemId": { "guid": "${subsetC}" } } ] } }
  ]
}
