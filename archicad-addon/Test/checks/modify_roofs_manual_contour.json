{
  "title": "ModifyRoofs writes a multi-plane roof's contour without moving its pivot polygon, and GetDetailsOfElements reads the overhang mode (#2582)",
  "minTapir": "2.0.1",
  "requiresEmpty": [ "Roof" ],
  "steps": [
    {
      "id": "a multi-plane and a single-plane roof",
      "command": "CreateRoofs",
      "params": {
        "roofsData": [
          {
            "level": 0.0,
            "floorIndex": 0,
            "thickness": 0.2,
            "polygonCoordinates": [
              { "x": 940.0, "y": 900.0 },
              { "x": 948.0, "y": 900.0 },
              { "x": 948.0, "y": 906.0 },
              { "x": 940.0, "y": 906.0 }
            ],
            "eavesOverhang": 0.3,
            "levels": [ { "levelHeight": 10.0, "levelAngle": 0.5 } ]
          },
          {
            "level": 0.0,
            "floorIndex": 0,
            "thickness": 0.2,
            "polygonCoordinates": [
              { "x": 960.0, "y": 900.0 },
              { "x": 966.0, "y": 900.0 },
              { "x": 966.0, "y": 904.0 },
              { "x": 960.0, "y": 904.0 }
            ],
            "pivotLine": {
              "begCoordinate": { "x": 960.0, "y": 900.0 },
              "endCoordinate": { "x": 966.0, "y": 900.0 }
            },
            "angle": 0.5
          }
        ]
      },
      "save": {
        "r1": "elements[0].elementId.guid",
        "r2": "elements[1].elementId.guid"
      },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "multi-plane roof created" },
        { "path": "elements[1].elementId.guid", "exists": true, "name": "single-plane roof created" }
      ]
    },
    {
      "id": "the new roof's overhang is an offset from the pivot polygon",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${r1}" } } ] },
      "save": {
        "px0": "detailsOfElements[0].details.pivotPolygonOutline[0].x",
        "py0": "detailsOfElements[0].details.pivotPolygonOutline[0].y",
        "px2": "detailsOfElements[0].details.pivotPolygonOutline[2].x",
        "py2": "detailsOfElements[0].details.pivotPolygonOutline[2].y",
        "cx0": "detailsOfElements[0].details.polygonOutline[0].x",
        "cx1": "detailsOfElements[0].details.polygonOutline[1].x",
        "cx2": "detailsOfElements[0].details.polygonOutline[2].x",
        "cx3": "detailsOfElements[0].details.polygonOutline[3].x"
      },
      "expect": [
        { "path": "detailsOfElements[0].details.roofClass", "eq": "MultiPlane" },
        { "path": "detailsOfElements[0].details.overhangType", "eq": "Offset", "name": "overhang Offset" },
        { "path": "detailsOfElements[0].details.polygonOutline", "len": 5, "name": "four-sided contour" },
        { "expr": "${cx0} + ${cx1} + ${cx2} + ${cx3}", "approx": 3776.0, "tol": 0.001, "name": "contour 0.3 m outside the pivot polygon in x" }
      ]
    },
    {
      "id": "the contour with its west edge on the pivot polygon; refused items",
      "command": "ModifyRoofs",
      "creates": false,
      "params": {
        "roofsWithDetails": [
          {
            "elementId": { "guid": "${r1}" },
            "contourPolygon": {
              "polygonOutline": [
                { "x": 940.0, "y": 899.7 },
                { "x": 948.3, "y": 899.7 },
                { "x": 948.3, "y": 906.3 },
                { "x": 940.0, "y": 906.3 }
              ]
            }
          },
          {
            "elementId": { "guid": "${r2}" },
            "contourPolygon": {
              "polygonOutline": [
                { "x": 960.0, "y": 900.0 },
                { "x": 966.0, "y": 900.0 },
                { "x": 966.0, "y": 904.0 }
              ]
            }
          },
          {
            "elementId": { "guid": "${r1}" },
            "eavesOverhang": 0.5,
            "contourPolygon": {
              "polygonOutline": [
                { "x": 940.0, "y": 899.7 },
                { "x": 948.3, "y": 899.7 },
                { "x": 948.3, "y": 906.3 }
              ]
            }
          }
        ]
      },
      "expect": [
        { "path": "executionResults", "len": 3, "name": "one result per item" },
        { "path": "executionResults[0].success", "eq": true, "name": "contour written and read back" },
        { "path": "executionResults[1].success", "eq": false, "name": "contourPolygon on a single-plane roof refused" },
        { "path": "executionResults[2].success", "eq": false, "name": "contourPolygon with eavesOverhang refused" }
      ]
    },
    {
      "id": "read the manual contour",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${r1}" } } ] },
      "save": {
        "px0b": "detailsOfElements[0].details.pivotPolygonOutline[0].x",
        "py0b": "detailsOfElements[0].details.pivotPolygonOutline[0].y",
        "px2b": "detailsOfElements[0].details.pivotPolygonOutline[2].x",
        "py2b": "detailsOfElements[0].details.pivotPolygonOutline[2].y",
        "mx0": "detailsOfElements[0].details.polygonOutline[0].x",
        "mx1": "detailsOfElements[0].details.polygonOutline[1].x",
        "mx2": "detailsOfElements[0].details.polygonOutline[2].x",
        "mx3": "detailsOfElements[0].details.polygonOutline[3].x"
      },
      "expect": [
        { "path": "detailsOfElements[0].details.overhangType", "eq": "Manual", "name": "overhang Manual" },
        { "path": "detailsOfElements[0].details.polygonOutline", "len": 5, "name": "still four-sided" },
        { "expr": "${mx0} + ${mx1} + ${mx2} + ${mx3}", "approx": 3776.6, "tol": 0.001, "name": "west edge of the contour moved to x = 940" },
        { "path": "detailsOfElements[0].details.pivotPolygonOutline", "len": 5, "name": "pivot polygon still four-sided" },
        { "expr": "${px0b} - ${px0}", "approx": 0, "tol": 0.0001, "name": "pivot polygon kept (vertex 0 x)" },
        { "expr": "${py0b} - ${py0}", "approx": 0, "tol": 0.0001, "name": "pivot polygon kept (vertex 0 y)" },
        { "expr": "${px2b} - ${px2}", "approx": 0, "tol": 0.0001, "name": "pivot polygon kept (vertex 2 x)" },
        { "expr": "${py2b} - ${py2}", "approx": 0, "tol": 0.0001, "name": "pivot polygon kept (vertex 2 y)" }
      ]
    },
    {
      "id": "back to an offset overhang",
      "command": "ModifyRoofs",
      "creates": false,
      "params": {
        "roofsWithDetails": [
          { "elementId": { "guid": "${r1}" }, "eavesOverhang": 0.3 }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "eavesOverhang written" }
      ]
    },
    {
      "id": "read the offset contour",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${r1}" } } ] },
      "save": {
        "ox0": "detailsOfElements[0].details.polygonOutline[0].x",
        "ox1": "detailsOfElements[0].details.polygonOutline[1].x",
        "ox2": "detailsOfElements[0].details.polygonOutline[2].x",
        "ox3": "detailsOfElements[0].details.polygonOutline[3].x"
      },
      "expect": [
        { "path": "detailsOfElements[0].details.overhangType", "eq": "Offset", "name": "overhang Offset again" },
        { "expr": "${ox0} + ${ox1} + ${ox2} + ${ox3}", "approx": 3776.0, "tol": 0.001, "name": "contour made from the pivot polygon again" }
      ]
    }
  ]
}
