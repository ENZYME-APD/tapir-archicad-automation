{
  "title": "CreateCameras adds cameras to the path of a Camera Set with their positions, two-point perspective, sun and pen (#2657)",
  "minTapir": "2.0.1",
  "steps": [
    {
      "id": "create a Camera Set",
      "command": "CreateCameraSets",
      "params": {
        "cameraSets": [
          { "name": "Tapir check cameras" }
        ]
      },
      "save": {
        "set": "elements[0].elementId.guid"
      },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "set created" }
      ]
    },
    {
      "id": "create two cameras in the set, and one in a set that does not exist",
      "command": "CreateCameras",
      "params": {
        "cameras": [
          {
            "cameraSetElementId": { "guid": "${set}" },
            "cameraPosition": { "x": 701.25, "y": 702.5, "z": 1.75 },
            "targetPosition": { "x": 711.25, "y": 702.5, "z": 1.25 }
          },
          {
            "cameraSetElementId": { "guid": "${set}" },
            "cameraPosition": { "x": 721.5, "y": 703.75, "z": 2.25 },
            "targetPosition": { "x": 721.5, "y": 713.75, "z": 1.5 },
            "isTwoPointPersp": true,
            "sun": { "sunPositionOption": "DateAndTime", "year": 2026, "month": 6, "day": 21, "hour": 14, "minute": 30, "second": 0 },
            "pen": 7
          },
          {
            "cameraSetElementId": { "guid": "00000000-0000-0000-0000-00000000BEEF" },
            "cameraPosition": { "x": 731.0, "y": 700.0, "z": 1.5 },
            "targetPosition": { "x": 741.0, "y": 700.0, "z": 1.5 }
          }
        ]
      },
      "save": {
        "cam1": "elements[0].elementId.guid",
        "cam2": "elements[1].elementId.guid"
      },
      "expect": [
        { "path": "elements", "len": 3 },
        { "path": "elements[0].elementId.guid", "exists": true, "name": "camera 1 created" },
        { "path": "elements[1].elementId.guid", "exists": true, "name": "camera 2 created" },
        { "path": "elements[2].error", "exists": true, "name": "no camera without a Camera Set" }
      ]
    },
    {
      "id": "both are cameras",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": {
        "elements": [
          { "elementId": { "guid": "${cam1}" } },
          { "elementId": { "guid": "${cam2}" } }
        ]
      },
      "expect": [
        { "path": "detailsOfElements[0].type", "eq": "Camera" },
        { "path": "detailsOfElements[1].type", "eq": "Camera" }
      ]
    },
    {
      "id": "GetCameras lists them with what was given",
      "command": "GetCameras",
      "creates": false,
      "params": {},
      "expect": [
        { "path": "cameraSets[*].cameraSetElementId.guid", "contains": "${set}" },
        { "path": "cameraSets[*].cameras[*].cameraElementId.guid", "contains": "${cam1}" },
        { "path": "cameraSets[*].cameras[*].cameraElementId.guid", "contains": "${cam2}" },
        { "path": "cameraSets[*].cameras[*].perspective.cameraPosition.x", "contains": 701.25, "name": "camera 1 x" },
        { "path": "cameraSets[*].cameras[*].perspective.cameraPosition.z", "contains": 1.75, "name": "camera 1 height" },
        { "path": "cameraSets[*].cameras[*].perspective.targetPosition.x", "contains": 711.25, "name": "target 1 x" },
        { "path": "cameraSets[*].cameras[*].perspective.targetPosition.z", "contains": 1.25, "name": "target 1 height" },
        { "path": "cameraSets[*].cameras[*].perspective.cameraPosition.y", "contains": 703.75, "name": "camera 2 y" },
        { "path": "cameraSets[*].cameras[*].perspective.cameraPosition.z", "contains": 2.25, "name": "camera 2 height" },
        { "path": "cameraSets[*].cameras[*].perspective.targetPosition.y", "contains": 713.75, "name": "target 2 y" },
        { "path": "cameraSets[*].cameras[*].perspective.isTwoPointPersp", "contains": true, "name": "camera 2 two-point" },
        { "path": "cameraSets[*].cameras[*].perspective.sun.sunPositionOption", "contains": "DateAndTime", "name": "camera 2 sun by date" },
        { "path": "cameraSets[*].cameras[*].perspective.sun.month", "contains": 6, "name": "camera 2 sun month" },
        { "path": "cameraSets[*].cameras[*].perspective.sun.minute", "contains": 30, "name": "camera 2 sun minute" },
        { "path": "cameraSets[*].cameras[*].pen", "contains": 7, "name": "camera 2 pen" }
      ]
    },
    {
      "id": "a third camera joins the existing path",
      "command": "CreateCameras",
      "params": {
        "cameras": [
          {
            "cameraSetElementId": { "guid": "${set}" },
            "cameraPosition": { "x": 741.75, "y": 704.25, "z": 1.5 },
            "targetPosition": { "x": 751.75, "y": 704.25, "z": 1.5 }
          }
        ]
      },
      "save": {
        "cam3": "elements[0].elementId.guid"
      },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "camera 3 created" }
      ]
    },
    {
      "id": "GetCameras lists the third camera too",
      "command": "GetCameras",
      "creates": false,
      "params": {},
      "expect": [
        { "path": "cameraSets[*].cameras[*].cameraElementId.guid", "contains": "${cam1}" },
        { "path": "cameraSets[*].cameras[*].cameraElementId.guid", "contains": "${cam2}" },
        { "path": "cameraSets[*].cameras[*].cameraElementId.guid", "contains": "${cam3}" },
        { "path": "cameraSets[*].cameras[*].perspective.cameraPosition.x", "contains": 741.75, "name": "camera 3 x" }
      ]
    },
    {
      "id": "DeleteElements deletes camera 2",
      "command": "DeleteElements",
      "creates": false,
      "params": {
        "elements": [
          { "elementId": { "guid": "${cam2}" } }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true }
      ]
    },
    {
      "id": "cameras 1 and 3 are still listed",
      "command": "GetCameras",
      "creates": false,
      "params": {},
      "expect": [
        { "path": "cameraSets[*].cameras[*].cameraElementId.guid", "contains": "${cam1}" },
        { "path": "cameraSets[*].cameras[*].cameraElementId.guid", "contains": "${cam3}" }
      ]
    }
  ]
}
