{
  "title": "CreateBeams makes a beam with segmentCount segments, each with its own cross section and length, as when beams are merged (#2678)",
  "minTapir": "2.0.1",
  "requiresEmpty": [ "Beam" ],
  "steps": [
    {
      "id": "three segments, each with its own cross section and fixed length",
      "command": "CreateBeams",
      "params": {
        "beamsData": [
          {
            "begCoordinate": { "x": 660.0, "y": 640.0 },
            "endCoordinate": { "x": 669.0, "y": 640.0 },
            "zCoordinate": 3.0,
            "floorIndex": 0,
            "offset": 0.0,
            "profileAngle": 0.0,
            "circleBased": false,
            "isWidthAndHeightLinked": false,
            "width": 0.3,
            "height": 0.5,
            "segmentCount": 3,
            "segments": [
              { "geometry": { "width": 0.2, "height": 0.4, "length": { "lengthType": "Fixed", "fixedLength": 2.0 } } },
              { "geometry": { "width": 0.3, "height": 0.6, "length": { "lengthType": "Fixed", "fixedLength": 3.0 } } },
              { "geometry": { "width": 0.25, "height": 0.45, "length": { "lengthType": "Fixed", "fixedLength": 4.0 } } }
            ]
          }
        ]
      },
      "save": { "merged": "elements[0].elementId.guid" },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "three-segment beam created" }
      ]
    },
    {
      "id": "the beam has three segments with their own cross sections and lengths",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${merged}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.segments", "len": 3, "name": "segmentCount kept" },
        { "path": "detailsOfElements[0].details.segments[0].geometry.width", "approx": 0.2, "tol": 0.0001 },
        { "path": "detailsOfElements[0].details.segments[0].geometry.height", "approx": 0.4, "tol": 0.0001 },
        { "path": "detailsOfElements[0].details.segments[1].geometry.width", "approx": 0.3, "tol": 0.0001 },
        { "path": "detailsOfElements[0].details.segments[1].geometry.height", "approx": 0.6, "tol": 0.0001, "name": "an added segment takes its own height" },
        { "path": "detailsOfElements[0].details.segments[2].geometry.width", "approx": 0.25, "tol": 0.0001 },
        { "path": "detailsOfElements[0].details.segments[2].geometry.height", "approx": 0.45, "tol": 0.0001 },
        { "path": "detailsOfElements[0].details.segments[0].geometry.length.lengthType", "eq": "Fixed" },
        { "path": "detailsOfElements[0].details.segments[1].geometry.length.fixedLength", "approx": 3.0, "tol": 0.0001 },
        { "path": "detailsOfElements[0].details.segments[2].geometry.length.fixedLength", "approx": 4.0, "tol": 0.0001 }
      ]
    },
    {
      "id": "its BeamSegment subelements",
      "command": "GetSubelementsOfHierarchicalElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${merged}" } } ] },
      "expect": [
        { "path": "subelements[0].beamSegments", "len": 3, "name": "three BeamSegment subelements" }
      ]
    },
    {
      "id": "two segments without their own values share the length; the cross section given for all applies to both",
      "command": "CreateBeams",
      "params": {
        "beamsData": [
          {
            "begCoordinate": { "x": 660.0, "y": 645.0 },
            "endCoordinate": { "x": 666.0, "y": 645.0 },
            "zCoordinate": 3.0,
            "floorIndex": 0,
            "circleBased": false,
            "isWidthAndHeightLinked": false,
            "width": 0.22,
            "height": 0.44,
            "segmentCount": 2
          }
        ]
      },
      "save": { "two": "elements[0].elementId.guid" },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true }
      ]
    },
    {
      "id": "read the two-segment beam",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${two}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.segments", "len": 2 },
        { "path": "detailsOfElements[0].details.segments[1].geometry.width", "approx": 0.22, "tol": 0.0001, "name": "width reaches the added segment" },
        { "path": "detailsOfElements[0].details.segments[1].geometry.length.lengthType", "eq": "Proportional" }
      ]
    },
    {
      "id": "a segments item past segmentCount is refused",
      "command": "CreateBeams",
      "params": {
        "beamsData": [
          {
            "begCoordinate": { "x": 660.0, "y": 650.0 },
            "endCoordinate": { "x": 666.0, "y": 650.0 },
            "zCoordinate": 3.0,
            "floorIndex": 0,
            "segmentCount": 2,
            "segments": [ { "segmentIndex": 2, "geometry": { "width": 0.3 } } ]
          }
        ]
      },
      "expect": [
        { "path": "elements[0].error", "exists": true, "name": "segment 2 of a two-segment beam refused" }
      ]
    }
  ]
}
