{
  "title": "Arrowheads (startArrow/endArrow) of Lines, Polylines, Arcs and Splines: set by CreateLineElements, CreatePolylines, CreateArcs, CreateSplines and SetDetailsOfElements, read back by GetDetailsOfElements; a Circle refuses them",
  "minTapir": "2.0.1",
  "requiresEmpty": [ "Line", "PolyLine", "Arc", "Circle", "Spline" ],
  "steps": [
    {
      "id": "a line with an arrowhead at its end only",
      "command": "CreateLineElements",
      "params": {
        "linesData": [
          {
            "begCoordinate": { "x": 850.0, "y": 800.0 },
            "endCoordinate": { "x": 856.0, "y": 800.0 },
            "startArrow": { "visible": false },
            "endArrow": { "type": "FullArrow30", "size": 3.0, "pen": 1 },
            "floorInd": 0
          }
        ]
      },
      "save": { "l1": "elements[0].elementId.guid" },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "line created" }
      ]
    },
    {
      "id": "read the line's arrowheads back",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${l1}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].type", "eq": "Line" },
        { "path": "detailsOfElements[0].details.startArrow.visible", "eq": false, "name": "no arrowhead at the start" },
        { "path": "detailsOfElements[0].details.endArrow.visible", "eq": true, "name": "arrowhead at the end" },
        { "path": "detailsOfElements[0].details.endArrow.type", "eq": "FullArrow30", "name": "end arrowhead type applied" },
        { "path": "detailsOfElements[0].details.endArrow.size", "approx": 3.0, "name": "end arrowhead size applied" },
        { "path": "detailsOfElements[0].details.endArrow.pen", "eq": 1, "name": "end arrowhead pen applied" },
        { "path": "detailsOfElements[0].details.endCoordinate.x", "approx": 856.0, "name": "geometry kept" }
      ]
    },
    {
      "id": "a polyline with the same arrowhead at both ends",
      "command": "CreatePolylines",
      "params": {
        "polylinesData": [
          {
            "coordinates": [ { "x": 850.0, "y": 810.0 }, { "x": 854.0, "y": 810.0 }, { "x": 854.0, "y": 813.0 } ],
            "startArrow": { "type": "ClosedArrow45", "size": 2.5 },
            "endArrow": { "type": "ClosedArrow45", "size": 2.5 },
            "floorInd": 0
          }
        ]
      },
      "save": { "p1": "elements[0].elementId.guid" },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "polyline created" }
      ]
    },
    {
      "id": "read the polyline's arrowheads back",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${p1}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].type", "eq": "PolyLine" },
        { "path": "detailsOfElements[0].details.startArrow.visible", "eq": true, "name": "a given arrowhead is shown (start)" },
        { "path": "detailsOfElements[0].details.endArrow.visible", "eq": true, "name": "a given arrowhead is shown (end)" },
        { "path": "detailsOfElements[0].details.startArrow.type", "eq": "ClosedArrow45" },
        { "path": "detailsOfElements[0].details.endArrow.type", "eq": "ClosedArrow45" },
        { "path": "detailsOfElements[0].details.startArrow.size", "approx": 2.5 },
        { "path": "detailsOfElements[0].details.endArrow.size", "approx": 2.5 }
      ]
    },
    {
      "id": "an arc with the double-line arrowhead at its start",
      "command": "CreateArcs",
      "params": {
        "arcsData": [
          {
            "origin": { "x": 870.0, "y": 800.0 },
            "radius": 3.0,
            "begAngle": 0.0,
            "endAngle": 1.5707963267948966,
            "startArrow": { "type": "BandArrow", "size": 2.0 },
            "endArrow": { "visible": false },
            "floorInd": 0
          }
        ]
      },
      "save": { "a1": "elements[0].elementId.guid" },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "arc created" }
      ]
    },
    {
      "id": "read the arc's arrowheads back",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${a1}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].type", "eq": "Arc" },
        { "path": "detailsOfElements[0].details.startArrow.visible", "eq": true },
        { "path": "detailsOfElements[0].details.startArrow.type", "eq": "BandArrow", "name": "double-line arrowhead applied" },
        { "path": "detailsOfElements[0].details.startArrow.size", "approx": 2.0 },
        { "path": "detailsOfElements[0].details.endArrow.visible", "eq": false, "name": "no arrowhead at the end" }
      ]
    },
    {
      "id": "a spline with a circle at its end",
      "command": "CreateSplines",
      "params": {
        "splinesData": [
          {
            "coordinates": [ { "x": 880.0, "y": 800.0 }, { "x": 882.0, "y": 802.0 }, { "x": 884.0, "y": 800.0 } ],
            "startArrow": { "visible": false },
            "endArrow": { "type": "EmptyCircle", "size": 2.0 },
            "floorInd": 0
          }
        ]
      },
      "save": { "s1": "elements[0].elementId.guid" },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "spline created" }
      ]
    },
    {
      "id": "read the spline's arrowheads back",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${s1}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].type", "eq": "Spline" },
        { "path": "detailsOfElements[0].details.startArrow.visible", "eq": false },
        { "path": "detailsOfElements[0].details.endArrow.visible", "eq": true },
        { "path": "detailsOfElements[0].details.endArrow.type", "eq": "EmptyCircle" }
      ]
    },
    {
      "id": "a circle",
      "command": "CreateCircles",
      "params": {
        "circlesData": [ { "origin": { "x": 890.0, "y": 800.0 }, "radius": 1.0, "floorInd": 0 } ]
      },
      "save": { "c1": "elements[0].elementId.guid" },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "circle created" }
      ]
    },
    {
      "id": "change the arrowheads of the line, polyline, arc and spline; a circle refuses one",
      "command": "SetDetailsOfElements",
      "creates": false,
      "params": {
        "elementsWithDetails": [
          { "elementId": { "guid": "${l1}" }, "details": { "typeSpecificDetails": { "startArrow": { "type": "FullArrow30" }, "endArrow": { "visible": false } } } },
          { "elementId": { "guid": "${p1}" }, "details": { "typeSpecificDetails": { "endArrow": { "size": 4.0 } } } },
          { "elementId": { "guid": "${a1}" }, "details": { "typeSpecificDetails": { "endArrow": { "visible": true } } } },
          { "elementId": { "guid": "${s1}" }, "details": { "typeSpecificDetails": { "endArrow": { "visible": false } } } },
          { "elementId": { "guid": "${c1}" }, "details": { "typeSpecificDetails": { "startArrow": { "visible": true } } } }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "line changed" },
        { "path": "executionResults[1].success", "eq": true, "name": "polyline changed" },
        { "path": "executionResults[2].success", "eq": true, "name": "arc changed" },
        { "path": "executionResults[3].success", "eq": true, "name": "spline changed" },
        { "path": "executionResults[4].success", "eq": false, "name": "a circle has no ends" }
      ]
    },
    {
      "id": "read the changed arrowheads back",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": {
        "elements": [
          { "elementId": { "guid": "${l1}" } },
          { "elementId": { "guid": "${p1}" } },
          { "elementId": { "guid": "${a1}" } },
          { "elementId": { "guid": "${s1}" } }
        ]
      },
      "expect": [
        { "path": "detailsOfElements[0].details.startArrow.visible", "eq": true, "name": "line: start arrowhead shown" },
        { "path": "detailsOfElements[0].details.startArrow.type", "eq": "FullArrow30", "name": "line: start arrowhead type" },
        { "path": "detailsOfElements[0].details.endArrow.visible", "eq": false, "name": "line: end arrowhead hidden" },
        { "path": "detailsOfElements[0].details.endCoordinate.x", "approx": 856.0, "name": "line: geometry kept" },
        { "path": "detailsOfElements[1].details.endArrow.size", "approx": 4.0, "name": "polyline: end arrowhead size changed" },
        { "path": "detailsOfElements[1].details.endArrow.type", "eq": "ClosedArrow45", "name": "polyline: end arrowhead type kept" },
        { "path": "detailsOfElements[1].details.startArrow.visible", "eq": true, "name": "polyline: start arrowhead kept" },
        { "path": "detailsOfElements[1].details.coordinates", "len": 3, "name": "polyline: geometry kept" },
        { "path": "detailsOfElements[2].details.endArrow.visible", "eq": true, "name": "arc: end arrowhead shown" },
        { "path": "detailsOfElements[2].details.startArrow.type", "eq": "BandArrow", "name": "arc: start arrowhead kept" },
        { "path": "detailsOfElements[3].details.endArrow.visible", "eq": false, "name": "spline: end arrowhead hidden" }
      ]
    }
  ]
}
