{
  "title": "GetGDLParametersOfElements: the posts and the top rail of a railing (#2572 part 2)",
  "minTapir": "2.0.1",
  "steps": [
    {
      "id": "create a one-segment railing on story 0",
      "command": "CreateRailings",
      "params": {
        "railingsData": [
          {
            "coordinates": [
              { "x": 790.0, "y": 790.0 },
              { "x": 794.0, "y": 790.0 }
            ],
            "floorIndex": 0,
            "bottomOffset": 0.0,
            "height": 1.0
          }
        ]
      },
      "save": { "r": "elements[0].elementId.guid" },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "railing created" }
      ]
    },
    {
      "id": "list the railing's components",
      "command": "GetSubelementsOfHierarchicalElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${r}" } } ] },
      "save": {
        "post": "subelements[0].railingPosts[0].elementId.guid",
        "toprail": "subelements[0].railingToprails[0].elementId.guid"
      },
      "expect": [
        { "path": "subelements[0].railingPosts[0].elementId.guid", "exists": true, "name": "the railing has a post" },
        { "path": "subelements[0].railingToprails[0].elementId.guid", "exists": true, "name": "the railing has a top rail" }
      ]
    },
    {
      "id": "GDL parameters of a post and of the top rail",
      "command": "GetGDLParametersOfElements",
      "creates": false,
      "params": {
        "elements": [
          { "elementId": { "guid": "${post}" } },
          { "elementId": { "guid": "${toprail}" } }
        ]
      },
      "expect": [
        { "path": "gdlParametersOfElements", "len": 2, "name": "one answer per component" },
        { "path": "gdlParametersOfElements[0].parameters[0].name", "exists": true, "name": "the post has GDL parameters" },
        { "path": "gdlParametersOfElements[0].parameters[0].type", "exists": true, "name": "the post's parameters have a type" },
        { "path": "gdlParametersOfElements[1].parameters[0].name", "exists": true, "name": "the top rail has GDL parameters" }
      ]
    },
    {
      "id": "the railing itself still answers as before",
      "command": "GetGDLParametersOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${r}" } } ] },
      "expect": [
        { "path": "gdlParametersOfElements", "len": 1, "name": "one answer for the railing" }
      ]
    }
  ]
}
