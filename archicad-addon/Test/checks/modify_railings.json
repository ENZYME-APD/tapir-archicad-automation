{
  "title": "ModifyRailings: story visibility and floor plan pens written, read back, 3D geometry kept",
  "minTapir": "2.0.0",
  "steps": [
    {
      "id": "create a railing on story 0",
      "command": "CreateRailings",
      "params": {
        "railingsData": [
          {
            "coordinates": [
              { "x": 760.0, "y": 760.0 },
              { "x": 764.0, "y": 760.0 },
              { "x": 764.0, "y": 763.0 }
            ],
            "floorIndex": 0,
            "bottomOffset": 0.2,
            "height": 1.1
          }
        ]
      },
      "save": { "r": "elements[0].elementId.guid" },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "railing created" }
      ]
    },
    {
      "id": "read the new railing",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${r}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.height", "approx": 1.1, "name": "height as created" },
        { "path": "detailsOfElements[0].details.referenceLine", "len": 3, "name": "one node per point" },
        { "path": "detailsOfElements[0].details.visibility", "exists": true, "name": "visibility is read" },
        { "path": "detailsOfElements[0].details.referenceLinePen", "exists": true, "name": "reference line pen is read" },
        { "path": "detailsOfElements[0].details.contourPen", "exists": true, "name": "contour pen is read" }
      ]
    },
    {
      "id": "ModifyRailings: home and one story up, reference line pen 21",
      "command": "ModifyRailings",
      "creates": false,
      "params": {
        "railingsWithDetails": [
          {
            "elementId": { "guid": "${r}" },
            "visibility": { "showOnHome": true, "showAllAbove": false, "showAllBelow": false, "showRelAbove": 1, "showRelBelow": 0 },
            "referenceLinePen": 21
          }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "visibility and reference line pen change accepted" }
      ]
    },
    {
      "id": "railing after the visibility and reference line pen change",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${r}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.isAutoOnStoryVisibility", "eq": false, "name": "automatic visibility turned off" },
        { "path": "detailsOfElements[0].details.visibility.showOnHome", "eq": true, "name": "shown on the home story" },
        { "path": "detailsOfElements[0].details.visibility.showRelAbove", "eq": 1, "name": "shown one story up" },
        { "path": "detailsOfElements[0].details.visibility.showAllAbove", "eq": false, "name": "not shown on all stories above" },
        { "path": "detailsOfElements[0].details.visibility.showRelBelow", "eq": 0, "name": "not shown below" },
        { "path": "detailsOfElements[0].details.referenceLinePen", "eq": 21, "name": "reference line pen changed" },
        { "path": "detailsOfElements[0].details.height", "approx": 1.1, "name": "height unchanged" },
        { "path": "detailsOfElements[0].details.segmentHeights[0]", "approx": 1.1, "name": "first segment height unchanged" },
        { "path": "detailsOfElements[0].details.segmentHeights[1]", "approx": 1.1, "name": "second segment height unchanged" },
        { "path": "detailsOfElements[0].details.bottomOffset", "approx": 0.2, "name": "bottom offset unchanged" },
        { "path": "detailsOfElements[0].floorIndex", "eq": 0, "name": "home story unchanged" },
        { "path": "detailsOfElements[0].details.referenceLine", "len": 3, "name": "node count unchanged" },
        { "path": "detailsOfElements[0].details.referenceLine[0].x", "approx": 760.0, "name": "first node x unchanged" },
        { "path": "detailsOfElements[0].details.referenceLine[0].y", "approx": 760.0, "name": "first node y unchanged" },
        { "path": "detailsOfElements[0].details.referenceLine[2].x", "approx": 764.0, "name": "last node x unchanged" },
        { "path": "detailsOfElements[0].details.referenceLine[2].y", "approx": 763.0, "name": "last node y unchanged" }
      ]
    },
    {
      "id": "ModifyRailings: contour pen 22 only",
      "command": "ModifyRailings",
      "creates": false,
      "params": {
        "railingsWithDetails": [
          { "elementId": { "guid": "${r}" }, "contourPen": 22 }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "contour pen change accepted" }
      ]
    },
    {
      "id": "railing after the contour pen change",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${r}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.contourPen", "eq": 22, "name": "contour pen changed" },
        { "path": "detailsOfElements[0].details.referenceLinePen", "eq": 21, "name": "reference line pen kept" },
        { "path": "detailsOfElements[0].details.visibility.showRelAbove", "eq": 1, "name": "visibility kept" },
        { "path": "detailsOfElements[0].details.isAutoOnStoryVisibility", "eq": false, "name": "automatic visibility still off" },
        { "path": "detailsOfElements[0].details.height", "approx": 1.1, "name": "height unchanged" },
        { "path": "detailsOfElements[0].details.referenceLine[1].x", "approx": 764.0, "name": "middle node x unchanged" },
        { "path": "detailsOfElements[0].details.referenceLine[1].y", "approx": 760.0, "name": "middle node y unchanged" }
      ]
    },
    {
      "id": "ModifyRailings: automatic visibility back on",
      "command": "ModifyRailings",
      "creates": false,
      "params": {
        "railingsWithDetails": [
          { "elementId": { "guid": "${r}" }, "isAutoOnStoryVisibility": true }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "automatic visibility change accepted" }
      ]
    },
    {
      "id": "railing after the automatic visibility change",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${r}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.isAutoOnStoryVisibility", "eq": true, "name": "automatic visibility on" },
        { "path": "detailsOfElements[0].details.contourPen", "eq": 22, "name": "contour pen kept" },
        { "path": "detailsOfElements[0].details.referenceLinePen", "eq": 21, "name": "reference line pen kept" },
        { "path": "detailsOfElements[0].details.segmentHeights[1]", "approx": 1.1, "name": "segment height unchanged" },
        { "path": "detailsOfElements[0].details.referenceLine", "len": 3, "name": "node count unchanged" }
      ]
    },
    {
      "id": "create a stair",
      "command": "CreateStairs",
      "params": {
        "stairsData": [
          {
            "baseLinePoints": [
              { "x": 780.0, "y": 760.0 },
              { "x": 786.0, "y": 760.0 }
            ],
            "baselinePosition": "Center",
            "zCoordinate": 0.0,
            "floorIndex": 0,
            "totalHeight": 2.8,
            "flightWidth": 1.2,
            "stepNum": 16,
            "riserHeight": 0.175,
            "treadDepth": 0.28
          }
        ]
      },
      "save": { "s": "elements[0].elementId.guid" },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "stair created" }
      ]
    },
    {
      "id": "ModifyRailings: pen of a stair",
      "command": "ModifyRailings",
      "creates": false,
      "params": {
        "railingsWithDetails": [
          { "elementId": { "guid": "${s}" }, "contourPen": 5 }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": false, "name": "a stair refused" }
      ]
    }
  ]
}
