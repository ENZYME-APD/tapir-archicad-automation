{
  "title": "ModifyRailings: one segment and one node of a two-segment railing, the rest kept (#2446)",
  "minTapir": "1.8.1",
  "steps": [
    {
      "id": "create a two-segment railing on story 0",
      "command": "CreateRailings",
      "params": {
        "railingsData": [
          {
            "coordinates": [
              { "x": 760.0, "y": 760.0 },
              { "x": 764.0, "y": 760.0 },
              { "x": 764.0, "y": 763.0 }
            ],
            "floorIndex": 0,
            "bottomOffset": 0.0,
            "height": 1.0
          }
        ]
      },
      "save": { "r": "elements[0].elementId.guid" },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "railing created" }
      ]
    },
    {
      "id": "segments and nodes before the change",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${r}" } } ] },
      "save": {
        "lat0": "detailsOfElements[0].details.segments[0].lateralOffset",
        "post0": "detailsOfElements[0].details.nodes[0].postOffset",
        "elev0": "detailsOfElements[0].details.nodes[0].elevation",
        "post2": "detailsOfElements[0].details.nodes[2].postOffset"
      },
      "expect": [
        { "path": "detailsOfElements[0].details.segments", "len": 2, "name": "two segments listed" },
        { "path": "detailsOfElements[0].details.nodes", "len": 3, "name": "three nodes listed" },
        { "path": "detailsOfElements[0].details.segments[0].height", "approx": 1.0, "name": "first segment height as created" },
        { "path": "detailsOfElements[0].details.segments[1].height", "approx": 1.0, "name": "second segment height as created" },
        { "path": "detailsOfElements[0].details.segments[1].elementId.guid", "exists": true, "name": "segment has its own guid" },
        { "path": "detailsOfElements[0].details.nodes[1].elementId.guid", "exists": true, "name": "node has its own guid" },
        { "path": "detailsOfElements[0].details.nodes[1].unifyPatterns", "exists": true, "name": "node tells whether the pattern continues" }
      ]
    },
    {
      "id": "ModifyRailings: second segment and the node between the segments",
      "command": "ModifyRailings",
      "creates": false,
      "params": {
        "railingsWithDetails": [
          {
            "elementId": { "guid": "${r}" },
            "segments": [ { "index": 1, "height": 0.8, "lateralOffset": 0.05 } ],
            "nodes": [ { "index": 1, "postOffset": 0.1, "unifyPatterns": false } ]
          }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "segment and node change accepted" }
      ]
    },
    {
      "id": "railing after the segment and node change",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${r}" } } ] },
      "save": {
        "lat0After": "detailsOfElements[0].details.segments[0].lateralOffset",
        "post0After": "detailsOfElements[0].details.nodes[0].postOffset",
        "elev0After": "detailsOfElements[0].details.nodes[0].elevation",
        "post2After": "detailsOfElements[0].details.nodes[2].postOffset"
      },
      "expect": [
        { "path": "detailsOfElements[0].details.segments[1].height", "approx": 0.8, "name": "second segment got its height" },
        { "path": "detailsOfElements[0].details.segments[1].lateralOffset", "approx": 0.05, "name": "second segment got its lateral offset" },
        { "path": "detailsOfElements[0].details.segmentHeights[1]", "approx": 0.8, "name": "segmentHeights agrees" },
        { "path": "detailsOfElements[0].details.nodes[1].postOffset", "approx": 0.1, "name": "middle node got its post offset" },
        { "path": "detailsOfElements[0].details.nodes[1].unifyPatterns", "eq": false, "name": "pattern cropped at the middle node" },
        { "path": "detailsOfElements[0].details.segments[0].height", "approx": 1.0, "name": "first segment height kept" },
        { "expr": "${lat0After} - ${lat0}", "approx": 0, "name": "first segment lateral offset kept" },
        { "expr": "${post0After} - ${post0}", "approx": 0, "name": "first node post offset kept" },
        { "expr": "${elev0After} - ${elev0}", "approx": 0, "name": "first node elevation kept" },
        { "expr": "${post2After} - ${post2}", "approx": 0, "name": "last node post offset kept" },
        { "path": "detailsOfElements[0].details.referenceLine", "len": 3, "name": "node count unchanged" },
        { "path": "detailsOfElements[0].details.referenceLine[1].x", "approx": 764.0, "name": "reference line kept" },
        { "path": "detailsOfElements[0].details.height", "approx": 1.0, "name": "railing default height kept" }
      ]
    },
    {
      "id": "ModifyRailings: the pattern continues across the node again",
      "command": "ModifyRailings",
      "creates": false,
      "params": {
        "railingsWithDetails": [
          { "elementId": { "guid": "${r}" }, "nodes": [ { "index": 1, "unifyPatterns": true } ] }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "pattern change accepted" }
      ]
    },
    {
      "id": "railing after the pattern change",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${r}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.nodes[1].unifyPatterns", "eq": true, "name": "pattern continues across the middle node" },
        { "path": "detailsOfElements[0].details.nodes[1].postOffset", "approx": 0.1, "name": "post offset of the middle node kept" },
        { "path": "detailsOfElements[0].details.segments[1].height", "approx": 0.8, "name": "second segment height kept" },
        { "path": "detailsOfElements[0].details.segments[0].height", "approx": 1.0, "name": "first segment height still kept" }
      ]
    },
    {
      "id": "ModifyRailings: bad segment and node indices",
      "command": "ModifyRailings",
      "creates": false,
      "params": {
        "railingsWithDetails": [
          { "elementId": { "guid": "${r}" }, "segments": [ { "index": 2, "height": 0.5 } ] },
          { "elementId": { "guid": "${r}" }, "nodes": [ { "index": 3, "postOffset": 0.2 } ] },
          { "elementId": { "guid": "${r}" }, "segments": [ { "index": 0 } ] }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": false, "name": "a segment the railing does not have refused" },
        { "path": "executionResults[1].success", "eq": false, "name": "a node the railing does not have refused" },
        { "path": "executionResults[2].success", "eq": false, "name": "a segment with no fields refused" }
      ]
    },
    {
      "id": "the refused items changed nothing",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${r}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.segments[0].height", "approx": 1.0, "name": "first segment height unchanged" },
        { "path": "detailsOfElements[0].details.segments[1].height", "approx": 0.8, "name": "second segment height unchanged" },
        { "path": "detailsOfElements[0].details.nodes[1].postOffset", "approx": 0.1, "name": "middle node post offset unchanged" }
      ]
    }
  ]
}
