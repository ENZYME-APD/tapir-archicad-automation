{
  "title": "CreateProfiles adds and renames offset modifiers of a Profile, read back with GetProfiles",
  "minTapir": "2.0.1",
  "minArchicad": "27",
  "requiresEmpty": [],
  "steps": [
    {
      "id": "a building material",
      "command": "GetAttributesByType",
      "creates": false,
      "params": {"attributeType": "BuildingMaterial"},
      "save": {"bm": "attributes[0].attributeId.guid"}
    },
    {
      "id": "create a 0.3 x 2.7 wall profile from newSkins",
      "command": "CreateProfiles",
      "creates": false,
      "params": {
        "profileDataArray": [
          {
            "name": "TapirCheck Profile 2586 modifiers",
            "wallType": true,
            "newSkins": [
              {
                "contours": [{"polygonCoordinates": [{"x": 0.0, "y": 0.0}, {"x": 0.3, "y": 0.0}, {"x": 0.3, "y": 2.7}, {"x": 0.0, "y": 2.7}]}],
                "buildingMaterialId": {"attributeId": {"guid": "${bm}"}},
                "isCore": true
              }
            ]
          }
        ]
      },
      "save": {"p": "attributeIds[0].attributeId.guid"},
      "expect": [
        {"path": "attributeIds", "len": 1},
        {"path": "attributeIds[0].error", "exists": false, "name": "no error"}
      ]
    },
    {
      "id": "read the skin: no modifiers yet, edge 2 is the right side (x = 0.3)",
      "command": "GetProfiles",
      "creates": false,
      "params": {"attributeIds": [{"attributeId": {"guid": "${p}"}}], "fields": ["width", "skins", "skinOutlines", "profileModifiers"]},
      "save": {"skin": "profiles[0].skins[0].skinId"},
      "expect": [
        {"path": "profiles", "len": 1},
        {"path": "profiles[0].skins", "len": 1},
        {"path": "profiles[0].profileModifiers", "len": 0, "name": "no modifiers yet"},
        {"path": "profiles[0].skins[0].outlineCoords[2].x", "approx": 0.3, "tol": 0.0001},
        {"path": "profiles[0].skins[0].outlineCoords[2].y", "approx": 0.0, "tol": 0.0001},
        {"path": "profiles[0].skins[0].outlineCoords[3].x", "approx": 0.3, "tol": 0.0001},
        {"path": "profiles[0].skins[0].outlineCoords[3].y", "approx": 2.7, "tol": 0.0001}
      ]
    },
    {
      "id": "add a 'Thickness' modifier moving the right side",
      "command": "CreateProfiles",
      "creates": false,
      "params": {
        "overwriteExisting": true,
        "profileDataArray": [
          {
            "attributeId": {"guid": "${p}"},
            "name": "TapirCheck Profile 2586 modifiers",
            "newProfileModifiers": [
              {
                "name": "Thickness",
                "edges": [{"skinId": "${skin}", "edgeIndex": 2}],
                "begin": {"type": "Fixed", "position": {"x": 0.0, "y": 1.35}},
                "end": {"type": "Edge", "skinId": "${skin}", "edgeIndex": 2},
                "projectionAngle": 0.0
              }
            ]
          }
        ]
      },
      "expect": [
        {"path": "attributeIds", "len": 1},
        {"path": "attributeIds[0].error", "exists": false, "name": "no error"}
      ]
    },
    {
      "id": "read back the modifier, its edge, anchors and value",
      "command": "GetProfiles",
      "creates": false,
      "params": {"attributeIds": [{"attributeId": {"guid": "${p}"}}], "fields": ["width", "height", "skins", "profileModifiers"]},
      "save": {"m": "profiles[0].profileModifiers[0].modifierId"},
      "expect": [
        {"path": "profiles[0].profileModifiers", "len": 1, "name": "one modifier"},
        {"path": "profiles[0].profileModifiers[0].name", "eq": "Thickness"},
        {"path": "profiles[0].profileModifiers[0].modifierId", "exists": true},
        {"path": "profiles[0].profileModifiers[0].value", "approx": 0.3, "tol": 0.0001, "name": "measures the wall thickness"},
        {"path": "profiles[0].profileModifiers[0].edges", "len": 1},
        {"path": "profiles[0].profileModifiers[0].edges[0].edgeIndex", "eq": 2},
        {"path": "profiles[0].profileModifiers[0].edges[0].skinId", "exists": true},
        {"path": "profiles[0].profileModifiers[0].begin.type", "eq": "Fixed"},
        {"path": "profiles[0].profileModifiers[0].begin.position.x", "approx": 0.0, "tol": 0.0001},
        {"path": "profiles[0].profileModifiers[0].begin.position.y", "approx": 1.35, "tol": 0.0001},
        {"path": "profiles[0].profileModifiers[0].end.type", "eq": "Edge"},
        {"path": "profiles[0].profileModifiers[0].end.edgeIndex", "eq": 2},
        {"path": "profiles[0].profileModifiers[0].projectionAngle", "approx": 0.0, "tol": 0.0001},
        {"path": "profiles[0].width", "approx": 0.3, "tol": 0.0001, "name": "width kept"},
        {"path": "profiles[0].height", "approx": 2.7, "tol": 0.0001, "name": "height kept"},
        {"path": "profiles[0].skins", "len": 1, "name": "skin kept"}
      ]
    },
    {
      "id": "bad input: a second modifier with the same name",
      "command": "CreateProfiles",
      "creates": false,
      "params": {
        "overwriteExisting": true,
        "profileDataArray": [
          {
            "attributeId": {"guid": "${p}"},
            "name": "TapirCheck Profile 2586 modifiers",
            "newProfileModifiers": [
              {
                "name": "Thickness",
                "edges": [{"skinId": "${skin}", "edgeIndex": 3}],
                "begin": {"type": "Fixed", "position": {"x": 0.15, "y": 0.0}},
                "end": {"type": "Edge", "skinId": "${skin}", "edgeIndex": 3}
              }
            ]
          }
        ]
      },
      "expect": [
        {"path": "attributeIds", "len": 1},
        {"path": "attributeIds[0].error", "exists": true, "name": "failed"}
      ]
    },
    {
      "id": "bad input: edge 0 is not an edge of the drawn shape",
      "command": "CreateProfiles",
      "creates": false,
      "params": {
        "overwriteExisting": true,
        "profileDataArray": [
          {
            "attributeId": {"guid": "${p}"},
            "name": "TapirCheck Profile 2586 modifiers",
            "newProfileModifiers": [
              {
                "name": "Bad edge",
                "edges": [{"skinId": "${skin}", "edgeIndex": 0}],
                "begin": {"type": "Fixed", "position": {"x": 0.0, "y": 0.0}},
                "end": {"type": "Fixed", "position": {"x": 0.3, "y": 0.0}}
              }
            ]
          }
        ]
      },
      "expect": [
        {"path": "attributeIds[0].error", "exists": true, "name": "failed"}
      ]
    },
    {
      "id": "bad input: a skin the profile does not have",
      "command": "CreateProfiles",
      "creates": false,
      "params": {
        "overwriteExisting": true,
        "profileDataArray": [
          {
            "attributeId": {"guid": "${p}"},
            "name": "TapirCheck Profile 2586 modifiers",
            "newProfileModifiers": [
              {
                "name": "Bad skin",
                "edges": [{"skinId": "00000000-0000-0000-0000-00000000BEEF", "edgeIndex": 2}],
                "begin": {"type": "Fixed", "position": {"x": 0.0, "y": 0.0}},
                "end": {"type": "Fixed", "position": {"x": 0.3, "y": 0.0}}
              }
            ]
          }
        ]
      },
      "expect": [
        {"path": "attributeIds[0].error", "exists": true, "name": "failed"}
      ]
    },
    {
      "id": "the failed calls changed nothing",
      "command": "GetProfiles",
      "creates": false,
      "params": {"attributeIds": [{"attributeId": {"guid": "${p}"}}], "fields": ["profileModifiers"]},
      "expect": [
        {"path": "profiles[0].profileModifiers", "len": 1, "name": "still one modifier"},
        {"path": "profiles[0].profileModifiers[0].name", "eq": "Thickness"}
      ]
    },
    {
      "id": "rename the modifier",
      "command": "CreateProfiles",
      "creates": false,
      "params": {
        "overwriteExisting": true,
        "profileDataArray": [
          {
            "attributeId": {"guid": "${p}"},
            "name": "TapirCheck Profile 2586 modifiers",
            "renameProfileModifiers": [{"modifierId": "${m}", "name": "Wall thickness"}]
          }
        ]
      },
      "expect": [
        {"path": "attributeIds[0].error", "exists": false, "name": "no error"}
      ]
    },
    {
      "id": "bad input: rename a modifier the profile does not have",
      "command": "CreateProfiles",
      "creates": false,
      "params": {
        "overwriteExisting": true,
        "profileDataArray": [
          {
            "attributeId": {"guid": "${p}"},
            "name": "TapirCheck Profile 2586 modifiers",
            "renameProfileModifiers": [{"modifierId": "00000000-0000-0000-0000-00000000BEEF", "name": "Nothing"}]
          }
        ]
      },
      "expect": [
        {"path": "attributeIds[0].error", "exists": true, "name": "failed"}
      ]
    },
    {
      "id": "overwrite without modifier changes keeps the renamed modifier",
      "command": "CreateProfiles",
      "creates": false,
      "params": {
        "overwriteExisting": true,
        "profileDataArray": [
          {"attributeId": {"guid": "${p}"}, "name": "TapirCheck Profile 2586 modifiers", "beamType": true}
        ]
      },
      "expect": [
        {"path": "attributeIds[0].error", "exists": false, "name": "no error"}
      ]
    },
    {
      "id": "read back the renamed modifier",
      "command": "GetProfiles",
      "creates": false,
      "params": {"attributeIds": [{"attributeId": {"guid": "${p}"}}], "fields": ["profileModifiers"]},
      "expect": [
        {"path": "profiles[0].profileModifiers", "len": 1, "name": "one modifier"},
        {"path": "profiles[0].profileModifiers[0].name", "eq": "Wall thickness", "name": "renamed"},
        {"path": "profiles[0].profileModifiers[0].value", "approx": 0.3, "tol": 0.0001},
        {"path": "profiles[0].profileModifiers[0].edges[0].edgeIndex", "eq": 2}
      ]
    }
  ],
  "teardown": [
    {
      "command": "DeleteAttributes",
      "params": {"attributesToDelete": [{"attributeType": "Profile", "attributeId": {"attributeId": {"guid": "${p}"}}}]}
    }
  ]
}
