{
  "title": "The mepSystemId that GetMEPRoutingElements and GetMEPDistributionSystems return is {\"guid\"}, and ModifyMEPRoutingElements takes it back (#2624)",
  "minTapir": "2.0.1",
  "minArchicad": "28",
  "steps": [
    {
      "id": "floor plan",
      "command": "ChangeWindow",
      "creates": false,
      "params": { "windowType": "FloorPlan", "storyIndex": 0 }
    },
    {
      "id": "two piping MEP Systems",
      "command": "CreateMEPSystems",
      "creates": false,
      "params": {
        "mepSystemDataArray": [
          { "name": "Tapir Check 2624 Hot Water", "domain": "Piping" },
          { "name": "Tapir Check 2624 Cold Water", "domain": "Piping" }
        ]
      },
      "save": { "sysA": "attributeIds[0].attributeId.guid", "sysB": "attributeIds[1].attributeId.guid" }
    },
    {
      "id": "a pipe in each system",
      "command": "CreateMEPRoutingElements",
      "params": {
        "routingElementsData": [
          {
            "domain": "Piping",
            "mepSystemId": { "guid": "${sysA}" },
            "nodeCoordinates": [ { "x": 60.0, "y": -40.0, "z": 3.0 }, { "x": 65.0, "y": -40.0, "z": 3.0 } ]
          },
          {
            "domain": "Piping",
            "mepSystemId": { "guid": "${sysB}" },
            "nodeCoordinates": [ { "x": 60.0, "y": -42.0, "z": 3.0 }, { "x": 65.0, "y": -42.0, "z": 3.0 } ]
          }
        ]
      },
      "save": { "pipeA": "elements[0].elementId.guid", "pipeB": "elements[1].elementId.guid" }
    },
    {
      "id": "read the first pipe's system",
      "command": "GetMEPRoutingElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${pipeA}" } } ] },
      "save": { "readSystem": "routingElements[0].mepSystemId.guid" },
      "expect": [
        { "path": "routingElements[0].mepSystemId.guid", "exists": true, "name": "mepSystemId is {\"guid\"} (AttributeId)" },
        { "path": "routingElements[0].mepSystemId.attributeId", "exists": false, "name": "mepSystemId is not wrapped in attributeId" }
      ]
    },
    {
      "id": "the system read is the first one",
      "command": "GetMEPSystems",
      "creates": false,
      "params": { "attributeIds": [ { "attributeId": { "guid": "${readSystem}" } } ] },
      "expect": [
        { "path": "mepSystems[0].name", "eq": "Tapir Check 2624 Hot Water", "name": "read guid is the MEP system" }
      ]
    },
    {
      "id": "write it to the second pipe",
      "command": "ModifyMEPRoutingElements",
      "creates": false,
      "params": {
        "routingElementsData": [
          { "elementId": { "guid": "${pipeB}" }, "mepSystemId": { "guid": "${readSystem}" } }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "Modify takes the system read" }
      ]
    },
    {
      "id": "the second pipe's system after",
      "command": "GetMEPRoutingElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${pipeB}" } } ] },
      "save": { "pipeBSystem": "routingElements[0].mepSystemId.guid" }
    },
    {
      "id": "is the first one",
      "command": "GetMEPSystems",
      "creates": false,
      "params": { "attributeIds": [ { "attributeId": { "guid": "${pipeBSystem}" } } ] },
      "expect": [
        { "path": "mepSystems[0].name", "eq": "Tapir Check 2624 Hot Water", "name": "system copied from one route to another" }
      ]
    },
    {
      "id": "distribution systems",
      "command": "GetMEPDistributionSystems",
      "creates": false,
      "params": {},
      "expect": [
        { "path": "distributionSystems[0].mepSystemId.attributeId", "exists": false, "name": "distribution system's mepSystemId not wrapped" }
      ]
    }
  ],
  "teardown": [
    {
      "command": "DeleteAttributes",
      "params": {
        "attributesToDelete": [
          { "attributeType": "MEPSystem", "attributeId": { "attributeId": { "guid": "${sysA}" } } },
          { "attributeType": "MEPSystem", "attributeId": { "attributeId": { "guid": "${sysB}" } } }
        ]
      }
    }
  ]
}
