{
  "title": "ModifyCurtainWalls writes the floor plan display settings GetDetailsOfElements reads, and keeps the geometry (#2529)",
  "minTapir": "2.0.1",
  "steps": [
    {
      "id": "a line type to set",
      "command": "GetAttributesByType",
      "creates": false,
      "params": { "attributeType": "Line" },
      "save": { "lt": "attributes[1].attributeId.guid" },
      "expect": [
        { "path": "attributes[1].attributeId.guid", "exists": true, "name": "the project has a second line type (not the solid default)" }
      ]
    },
    {
      "id": "a one-segment curtain wall on story 0",
      "command": "CreateCurtainWalls",
      "params": {
        "curtainWallsData": [
          {
            "coordinates": [
              { "x": 960.0, "y": 960.0 },
              { "x": 966.0, "y": 960.0 }
            ],
            "zCoordinate": 0.0,
            "floorIndex": 0,
            "height": 3.0,
            "primaryPattern": { "sizes": [ 1.5 ], "logic": "FixedSizes", "origin": "StartWithPattern" },
            "secondaryPattern": { "sizes": [ 1.5 ], "logic": "FixedSizes", "origin": "StartWithPattern" },
            "cells": [
              { "columnIndex": 0, "rowIndex": 0, "panelClassIndex": 1, "leftFrameClassIndex": 1, "bottomFrameClassIndex": 1, "crossingFrameType": "None" }
            ]
          }
        ]
      },
      "save": { "cw": "elements[0].elementId.guid" },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "curtain wall created" }
      ]
    },
    {
      "id": "automatic story visibility on first, which resets the custom story fields",
      "command": "ModifyCurtainWalls",
      "creates": false,
      "params": {
        "curtainWallsWithDetails": [
          { "elementId": { "guid": "${cw}" }, "isAutoOnStoryVisibility": true }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "automatic visibility accepted first" }
      ]
    },
    {
      "id": "home story only, cut only, entire element, projection modes",
      "command": "ModifyCurtainWalls",
      "creates": false,
      "params": {
        "curtainWallsWithDetails": [
          {
            "elementId": { "guid": "${cw}" },
            "visibility": { "showOnHome": true, "showAllAbove": false, "showAllBelow": false, "showRelAbove": 0, "showRelBelow": 0 },
            "displayOption": "CutOnly",
            "viewDepthLimitation": "EntireElement",
            "cutProjectionMode": "Projected",
            "uncutProjectionMode": "Hybrid",
            "overheadProjectionMode": "Projected"
          }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "display change accepted and read back" }
      ]
    },
    {
      "id": "read the display settings back",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${cw}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.isAutoOnStoryVisibility", "eq": false, "name": "automatic story visibility turned off" },
        { "path": "detailsOfElements[0].details.visibility.showOnHome", "eq": true, "name": "shown on the home story" },
        { "path": "detailsOfElements[0].details.visibility.showAllAbove", "eq": false, "name": "not on all stories above" },
        { "path": "detailsOfElements[0].details.visibility.showRelAbove", "eq": 0, "name": "no story above" },
        { "path": "detailsOfElements[0].details.visibility.showRelBelow", "eq": 0, "name": "no story below" },
        { "path": "detailsOfElements[0].details.displayOption", "eq": "CutOnly", "name": "display option set" },
        { "path": "detailsOfElements[0].details.viewDepthLimitation", "eq": "EntireElement", "name": "view depth set" },
        { "path": "detailsOfElements[0].details.cutProjectionMode", "eq": "Projected", "name": "cut projection set" },
        { "path": "detailsOfElements[0].details.uncutProjectionMode", "eq": "Hybrid", "name": "uncut projection set" },
        { "path": "detailsOfElements[0].details.overheadProjectionMode", "eq": "Projected", "name": "overhead projection set" },
        { "path": "detailsOfElements[0].details.height", "approx": 3.0, "name": "height unchanged" },
        { "path": "detailsOfElements[0].details.referenceLine[1].x", "approx": 966.0, "name": "reference line unchanged" },
        { "path": "detailsOfElements[0].floorIndex", "eq": 0, "name": "home story unchanged" }
      ]
    },
    {
      "id": "pens and line types of the cut, uncut and overhead lines",
      "command": "ModifyCurtainWalls",
      "creates": false,
      "params": {
        "curtainWallsWithDetails": [
          {
            "elementId": { "guid": "${cw}" },
            "usePanelTypesAttributes": false,
            "frameCutLinePen": 21,
            "frameCutLineTypeId": { "guid": "${lt}" },
            "panelCutLinePen": 22,
            "panelCutLineTypeId": { "guid": "${lt}" },
            "belowViewLinePen": 23,
            "belowViewLineTypeId": { "guid": "${lt}" },
            "aboveViewLinePen": 24,
            "aboveViewLineTypeId": { "guid": "${lt}" },
            "pen": 25
          }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "pen and line type change accepted and read back (the command compares every line type it wrote)" }
      ]
    },
    {
      "id": "read the pens and line types back",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${cw}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.usePanelTypesAttributes", "eq": false, "name": "panels use the curtain wall's attributes" },
        { "path": "detailsOfElements[0].details.frameCutLinePen", "eq": 21, "name": "frame cut line pen 21" },
        { "path": "detailsOfElements[0].details.frameCutLineTypeId.guid", "exists": true, "name": "frame cut line type read" },
        { "path": "detailsOfElements[0].details.panelCutLinePen", "eq": 22, "name": "panel cut line pen 22" },
        { "path": "detailsOfElements[0].details.panelCutLineTypeId.guid", "exists": true, "name": "panel cut line type read" },
        { "path": "detailsOfElements[0].details.belowViewLinePen", "eq": 23, "name": "uncut line pen 23" },
        { "path": "detailsOfElements[0].details.belowViewLineTypeId.guid", "exists": true, "name": "uncut line type read" },
        { "path": "detailsOfElements[0].details.aboveViewLinePen", "eq": 24, "name": "overhead line pen 24" },
        { "path": "detailsOfElements[0].details.aboveViewLineTypeId.guid", "exists": true, "name": "overhead line type read" },
        { "path": "detailsOfElements[0].details.pen", "eq": 25, "name": "curtain wall pen 25" },
        { "path": "detailsOfElements[0].details.displayOption", "eq": "CutOnly", "name": "display option kept" },
        { "path": "detailsOfElements[0].details.isAutoOnStoryVisibility", "eq": false, "name": "visibility kept: automatic still off" },
        { "path": "detailsOfElements[0].details.visibility.showOnHome", "eq": true, "name": "visibility kept: home story" },
        { "path": "detailsOfElements[0].details.height", "approx": 3.0, "name": "height unchanged" }
      ]
    },
    {
      "id": "an unknown line type is refused",
      "command": "ModifyCurtainWalls",
      "creates": false,
      "params": {
        "curtainWallsWithDetails": [
          { "elementId": { "guid": "${cw}" }, "frameCutLinePen": 30, "aboveViewLineTypeId": { "guid": "00000000-0000-0000-0000-00000000BEEF" } }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": false, "name": "unknown line type refused" }
      ]
    },
    {
      "id": "the refused item changed nothing",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${cw}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.frameCutLinePen", "eq": 21, "name": "frame cut line pen still 21" }
      ]
    },
    {
      "id": "automatic story visibility back on",
      "command": "ModifyCurtainWalls",
      "creates": false,
      "params": {
        "curtainWallsWithDetails": [
          { "elementId": { "guid": "${cw}" }, "isAutoOnStoryVisibility": true }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "automatic visibility accepted" }
      ]
    },
    {
      "id": "read the automatic visibility back",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${cw}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.isAutoOnStoryVisibility", "eq": true, "name": "automatic story visibility on" },
        { "path": "detailsOfElements[0].details.frameCutLinePen", "eq": 21, "name": "pens kept" }
      ]
    }
  ]
}
