{
  "title": "GetElementsInDrawOrder returns only elements the other commands can find by guid (#2492)",
  "minTapir": "2.0.1",
  "requiresEmpty": ["Wall"],
  "steps": [
    {
      "id": "two walls",
      "command": "CreateWalls",
      "params": {
        "wallsData": [
          { "begCoordinate": { "x": 700, "y": 700 }, "endCoordinate": { "x": 704, "y": 700 }, "zCoordinate": 0, "height": 2.5, "thickness": 0.2 },
          { "begCoordinate": { "x": 700, "y": 703 }, "endCoordinate": { "x": 704, "y": 703 }, "zCoordinate": 0, "height": 2.5, "thickness": 0.2 }
        ]
      },
      "expect": [
        { "path": "elements[1].elementId.guid", "exists": true, "name": "walls created" }
      ]
    },
    {
      "id": "a text",
      "command": "CreateTexts",
      "params": {
        "textsData": [
          { "coordinate": { "x": 700.0, "y": 706.0, "z": 0.0 }, "text": "TEST", "height": 2.5, "justification": "Left" }
        ]
      },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "text created" }
      ]
    },
    {
      "id": "every element in drawing order",
      "command": "GetElementsInDrawOrder",
      "creates": false,
      "params": {},
      "save": { "all": "elements" },
      "expect": [
        { "path": "elements[2].elementId.guid", "exists": true, "name": "the walls and the text are listed" }
      ]
    },
    {
      "id": "every listed guid resolves",
      "command": "API.GetTypesOfElements",
      "creates": false,
      "params": { "elements": "${all}" },
      "expect": [
        { "path": "typesOfElements[*].typeOfElement.elementType", "exists": true, "name": "no listed guid answers 'Element not found'" }
      ]
    }
  ]
}
