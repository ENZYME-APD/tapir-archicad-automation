{
  "title": "SetStories with any active story (#747)",
  "minTapir": "1.7.0",
  "steps": [
    {
      "id": "two stories",
      "command": "SetStories",
      "creates": false,
      "params": {
        "stories": [
          {
            "index": 0,
            "name": "S0",
            "level": 0.0,
            "dispOnSections": true
          },
          {
            "index": 1,
            "name": "S1",
            "level": 3.0,
            "dispOnSections": true
          }
        ]
      },
      "expect": [
        {
          "path": "success",
          "eq": true
        }
      ]
    },
    {
      "id": "two stories: read back",
      "command": "GetStories",
      "creates": false,
      "expect": [
        {
          "path": "stories[0].level",
          "approx": 0.0,
          "name": "story 0 level"
        },
        {
          "path": "stories[1].level",
          "approx": 3.0,
          "name": "story 1 level"
        }
      ]
    },
    {
      "id": "activate story 0",
      "command": "ChangeWindow",
      "creates": false,
      "params": {
        "windowType": "FloorPlan",
        "storyIndex": 0
      },
      "expect": [
        {
          "path": "success",
          "eq": true,
          "name": "accepted"
        }
      ]
    },
    {
      "id": "S0 active, lower S0",
