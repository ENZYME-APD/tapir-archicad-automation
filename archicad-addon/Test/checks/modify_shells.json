{
  "title": "ModifyShells sets the thickness and the flip of a Basic shell, keeps its reference surface and refuses a thickness on a Composite shell (#2424)",
  "minTapir": "1.8.1",
  "requiresEmpty": [ "Shell" ],
  "steps": [
    {
      "id": "a building material of the check",
      "command": "CreateBuildingMaterials",
      "creates": false,
      "params": { "buildingMaterialDataArray": [ { "name": "TapirCheck shell thickness material" } ] },
      "save": { "bm": "attributeIds[0].attributeId.guid" },
      "expect": [
        { "path": "attributeIds[0].attributeId.guid", "exists": true, "name": "material created" }
      ]
    },
    {
      "id": "a line type for the composite's separators",
      "command": "GetAttributesByType",
      "creates": false,
      "params": { "attributeType": "Line" },
      "save": { "lineType": "attributes[0].attributeId.guid" }
    },
    {
      "id": "a composite for shells",
      "command": "CreateComposites",
      "creates": false,
      "params": {
        "compositeDataArray": [
          {
            "name": "TapirCheck shell thickness composite",
            "useWith": [ "Shell" ],
            "skins": [
              { "type": "Core", "buildingMaterialId": { "attributeId": { "guid": "${bm}" } }, "framePen": 1, "thickness": 0.25 }
            ],
            "separators": [
              { "lineTypeId": { "attributeId": { "guid": "${lineType}" } }, "linePen": 1 },
              { "lineTypeId": { "attributeId": { "guid": "${lineType}" } }, "linePen": 1 }
            ]
          }
        ]
      },
      "save": { "comp": "attributeIds[0].attributeId.guid" },
      "expect": [
        { "path": "attributeIds[0].attributeId.guid", "exists": true, "name": "composite created" }
      ]
    },
    {
      "id": "flat basic extruded shell, 6 m x 4 m, 0.39 m thick",
      "command": "CreateShells",
      "params": {
        "shellsData": [
          {
            "shellClass": "Extruded",
            "floorIndex": 0,
            "thickness": 0.39,
            "isFlipped": false,
            "structureType": "Basic",
            "buildingMaterialId": { "guid": "${bm}" },
            "basePlane": { "origin": { "x": 870.0, "y": 800.0, "z": 3.0 } },
            "profile": {
              "coordinates": [ { "x": -3.0, "y": 0.0 }, { "x": 3.0, "y": 0.0 } ]
            },
            "extrusionVector": { "x": 0.0, "y": 4.0, "z": 0.0 }
          }
        ]
      },
      "save": { "s1": "elements[0].elementId.guid" },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "shell created" }
      ]
    },
    {
      "id": "read the new shell",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${s1}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.structureType", "eq": "Basic" },
        { "path": "detailsOfElements[0].details.thickness", "approx": 0.39 },
        { "path": "detailsOfElements[0].details.isFlipped", "eq": false, "name": "isFlipped read back" }
      ]
    },
    {
      "id": "the 0.39 m shell's box",
      "command": "Get3DBoundingBoxes",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${s1}" } } ] },
      "save": { "zMin0": "boundingBoxes3D[0].boundingBox3D.zMin", "zMax0": "boundingBoxes3D[0].boundingBox3D.zMax" },
      "expect": [
        { "expr": "${zMax0} - ${zMin0}", "approx": 0.39, "tol": 0.001, "name": "a flat shell's box is as high as it is thick" }
      ]
    },
    {
      "id": "0.24 m for the shell",
      "command": "ModifyShells",
      "creates": false,
      "params": { "shellsWithDetails": [ { "elementId": { "guid": "${s1}" }, "thickness": 0.24 } ] },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "thickness changed" }
      ]
    },
    {
      "id": "read the thinner shell on the same guid",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${s1}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.thickness", "approx": 0.24, "name": "new thickness read back" },
        { "path": "detailsOfElements[0].details.structureType", "eq": "Basic", "name": "still Basic" },
        { "path": "detailsOfElements[0].details.isFlipped", "eq": false, "name": "flip kept" },
        { "path": "detailsOfElements[0].details.shellClass", "eq": "Extruded", "name": "shell class kept" }
      ]
    },
    {
      "id": "the 0.24 m shell's box",
      "command": "Get3DBoundingBoxes",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${s1}" } } ] },
      "save": { "zMin1": "boundingBoxes3D[0].boundingBox3D.zMin", "zMax1": "boundingBoxes3D[0].boundingBox3D.zMax" },
      "expect": [
        { "expr": "${zMax1} - ${zMin1}", "approx": 0.24, "tol": 0.001, "name": "the box is 0.24 m high" },
        { "expr": "(${zMin1} - ${zMin0}) * (${zMax1} - ${zMax0})", "approx": 0.0, "tol": 0.00001, "name": "one face (the reference surface) stayed in place" },
        { "expr": "(${zMin1} - ${zMin0}) * (${zMin1} - ${zMin0}) + (${zMax1} - ${zMax0}) * (${zMax1} - ${zMax0})", "approx": 0.0225, "tol": 0.0005, "name": "the other face moved 0.15 m" }
      ]
    },
    {
      "id": "flip the shell",
      "command": "ModifyShells",
      "creates": false,
      "params": { "shellsWithDetails": [ { "elementId": { "guid": "${s1}" }, "isFlipped": true } ] },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "flipped" }
      ]
    },
    {
      "id": "read the flipped shell",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${s1}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.isFlipped", "eq": true, "name": "isFlipped written" },
        { "path": "detailsOfElements[0].details.thickness", "approx": 0.24, "name": "thickness kept" }
      ]
    },
    {
      "id": "the flipped shell's box",
      "command": "Get3DBoundingBoxes",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${s1}" } } ] },
      "save": { "zMin2": "boundingBoxes3D[0].boundingBox3D.zMin", "zMax2": "boundingBoxes3D[0].boundingBox3D.zMax" },
      "expect": [
        { "expr": "${zMax2} - ${zMin2}", "approx": 0.24, "tol": 0.001, "name": "still 0.24 m high" },
        { "expr": "(${zMin2} - ${zMin1}) * (${zMin2} - ${zMin1})", "approx": 0.0576, "tol": 0.001, "name": "the body moved 0.24 m to the other side of the reference surface" }
      ]
    },
    {
      "id": "make the shell Composite",
      "command": "ModifyShells",
      "creates": false,
      "params": {
        "shellsWithDetails": [
          { "elementId": { "guid": "${s1}" }, "structureType": "Composite", "compositeId": { "guid": "${comp}" } }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "shell made Composite" }
      ]
    },
    {
      "id": "a thickness on the Composite shell; then Basic with a thickness in one item",
      "command": "ModifyShells",
      "creates": false,
      "params": {
        "shellsWithDetails": [
          { "elementId": { "guid": "${s1}" }, "thickness": 0.3 },
          { "elementId": { "guid": "${s1}" }, "structureType": "Basic", "buildingMaterialId": { "guid": "${bm}" }, "thickness": 0.3 }
        ]
      },
      "expect": [
        { "path": "executionResults", "len": 2, "name": "one result per item" },
        { "path": "executionResults[0].success", "eq": false, "name": "thickness of a Composite shell refused" },
        { "path": "executionResults[0].error.message", "contains": "composite", "name": "the error names the composite" },
        { "path": "executionResults[1].success", "eq": true, "name": "made Basic and thickened in one item" }
      ]
    },
    {
      "id": "read the shell made Basic again",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${s1}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.structureType", "eq": "Basic" },
        { "path": "detailsOfElements[0].details.thickness", "approx": 0.3, "name": "thickness written with the structure" }
      ]
    }
  ],
  "teardown": [
    {
      "command": "DeleteAttributes",
      "params": { "attributesToDelete": [ { "attributeType": "Composite", "attributeId": { "attributeId": { "guid": "${comp}" } } } ] }
    },
    {
      "command": "DeleteAttributes",
      "params": { "attributesToDelete": [ { "attributeType": "BuildingMaterial", "attributeId": { "attributeId": { "guid": "${bm}" } } } ] }
    }
  ]
}
