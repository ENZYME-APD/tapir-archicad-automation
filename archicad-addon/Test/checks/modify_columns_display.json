{
  "title": "GetDetailsOfElements reads, and ModifyColumns writes, the floor plan display settings of a column (#2529)",
  "minTapir": "2.0.1",
  "requiresEmpty": [ "Column" ],
  "steps": [
    {
      "id": "a column away from the origin",
      "command": "CreateColumns",
      "params": {
        "columnsData": [
          {
            "coordinates": { "x": 900.0, "y": 900.0, "z": 0.0 },
            "floorIndex": 0,
            "height": 3.0
          }
        ]
      },
      "save": { "c1": "elements[0].elementId.guid" },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "column created" }
      ]
    },
    {
      "id": "two line types of the project",
      "command": "GetAttributesByType",
      "creates": false,
      "params": { "attributeType": "Line" },
      "save": { "lt1": "attributes[0].attributeId.guid", "lt2": "attributes[1].attributeId.guid" },
      "expect": [
        { "path": "attributes[1].attributeId.guid", "exists": true, "name": "at least two line types" }
      ]
    },
    {
      "id": "read the new display fields",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${c1}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.visibility.showOnHome", "exists": true },
        { "path": "detailsOfElements[0].details.isAutoOnStoryVisibility", "exists": true },
        { "path": "detailsOfElements[0].details.displayOption", "exists": true },
        { "path": "detailsOfElements[0].details.viewDepthLimitation", "exists": true },
        { "path": "detailsOfElements[0].details.contourPen", "exists": true },
        { "path": "detailsOfElements[0].details.veneerLinePen", "exists": true },
        { "path": "detailsOfElements[0].details.coreSymbolPen", "exists": true },
        { "path": "detailsOfElements[0].details.belowViewLinePen", "exists": true },
        { "path": "detailsOfElements[0].details.aboveViewLinePen", "exists": true },
        { "path": "detailsOfElements[0].details.hiddenLinePen", "exists": true }
      ]
    },
    {
      "id": "write the pens and line types",
      "command": "ModifyColumns",
      "creates": false,
      "params": {
        "columnsWithDetails": [
          {
            "elementId": { "guid": "${c1}" },
            "contourPen": 21,
            "veneerLinePen": 22,
            "coreSymbolPen": 23,
            "belowViewLinePen": 24,
            "aboveViewLinePen": 25,
            "hiddenLinePen": 26,
            "contourLineTypeId": { "guid": "${lt1}" },
            "hiddenLineTypeId": { "guid": "${lt2}" },
            "aboveViewLineTypeId": { "guid": "${lt2}" }
          }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "pens and line types written" }
      ]
    },
    {
      "id": "read the pens and line types back",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${c1}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.contourPen", "eq": 21 },
        { "path": "detailsOfElements[0].details.veneerLinePen", "eq": 22 },
        { "path": "detailsOfElements[0].details.coreSymbolPen", "eq": 23 },
        { "path": "detailsOfElements[0].details.belowViewLinePen", "eq": 24 },
        { "path": "detailsOfElements[0].details.aboveViewLinePen", "eq": 25 },
        { "path": "detailsOfElements[0].details.hiddenLinePen", "eq": 26 },
        { "path": "detailsOfElements[0].details.contourLineTypeId.guid", "eq": "${lt1}" },
        { "path": "detailsOfElements[0].details.hiddenLineTypeId.guid", "eq": "${lt2}" },
        { "path": "detailsOfElements[0].details.aboveViewLineTypeId.guid", "eq": "${lt2}" }
      ]
    },
    {
      "id": "write the display option and view depth",
      "command": "ModifyColumns",
      "creates": false,
      "params": {
        "columnsWithDetails": [
          {
            "elementId": { "guid": "${c1}" },
            "displayOption": "CutOnly",
            "viewDepthLimitation": "EntireElement"
          }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "display option written" }
      ]
    },
    {
      "id": "read the display option back",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${c1}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.displayOption", "eq": "CutOnly" },
        { "path": "detailsOfElements[0].details.viewDepthLimitation", "eq": "EntireElement" },
        { "path": "detailsOfElements[0].details.contourPen", "eq": 21, "name": "pens kept" }
      ]
    },
    {
      "id": "home story only",
      "command": "ModifyColumns",
      "creates": false,
      "params": {
        "columnsWithDetails": [
          {
            "elementId": { "guid": "${c1}" },
            "visibility": { "showOnHome": true, "showAllAbove": false, "showAllBelow": false, "showRelAbove": 0, "showRelBelow": 0 }
          }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "home story only written" }
      ]
    },
    {
      "id": "read the story visibility back",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${c1}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.isAutoOnStoryVisibility", "eq": false },
        { "path": "detailsOfElements[0].details.visibility.showOnHome", "eq": true },
        { "path": "detailsOfElements[0].details.visibility.showAllAbove", "eq": false },
        { "path": "detailsOfElements[0].details.visibility.showAllBelow", "eq": false },
        { "path": "detailsOfElements[0].details.visibility.showRelAbove", "eq": 0 },
        { "path": "detailsOfElements[0].details.visibility.showRelBelow", "eq": 0 }
      ]
    },
    {
      "id": "an unknown line type fails the item and changes nothing",
      "command": "ModifyColumns",
      "creates": false,
      "params": {
        "columnsWithDetails": [
          {
            "elementId": { "guid": "${c1}" },
            "contourPen": 30,
            "hiddenLineTypeId": { "guid": "00000000-0000-0000-0000-00000000BEEF" }
          }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": false, "name": "unknown line type refused" }
      ]
    },
    {
      "id": "the column is unchanged",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${c1}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.contourPen", "eq": 21, "name": "contour pen kept" },
        { "path": "detailsOfElements[0].details.hiddenLineTypeId.guid", "eq": "${lt2}", "name": "hidden line type kept" }
      ]
    }
  ]
}
