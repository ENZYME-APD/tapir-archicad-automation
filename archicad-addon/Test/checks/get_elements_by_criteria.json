{
  "title": "GetElementsByCriteria command",
  "minTapir": "1.7.3",
  "steps": [
    {
      "id": "create test wall",
      "command": "CreateWalls",
      "creates": true,
      "params": {
        "wallsData": [
          {
            "begCoordinate": {
              "x": 0.0,
              "y": 0.0
            },
            "endCoordinate": {
              "x": 5.0,
              "y": 0.0
            },
            "height": 3.0
          }
        ]
      },
      "save": {
        "wallId": "elements[0].elementId.guid"
      },
      "expect": [
        {
          "path": "elements[0].elementId.guid",
          "exists": true,
          "name": "wall created"
        }
      ]
    },
    {
      "id": "filter wall elements by criteria",
      "command": "GetElementsByCriteria",
      "creates": false,
      "params": {
        "types": [
          "Wall"
        ]
      },
      "expect": [
        {
          "path": "count",
          "eq": 1,
          "name": "one wall found"
        },
        {
          "path": "elements[0].elementId.guid",
          "exists": true,
          "name": "wall guid exists in result"
        }
      ]
    },
    {
      "id": "count-only criteria evaluation",
      "command": "GetElementsByCriteria",
      "creates": false,
      "params": {
        "types": [
          "Wall"
        ],
        "countOnly": true
      },
      "expect": [
        {
          "path": "count",
          "eq": 1,
          "name": "count is 1"
        }
      ]
    }
  ]
}
