{
  "title": "ModifyRoofs sets and clears the top, side and bottom surfaces and the custom surface of one edge, and keeps the rest (#2433)",
  "minTapir": "1.8.1",
  "requiresEmpty": [ "Roof" ],
  "steps": [
    {
      "id": "two surfaces of the project",
      "command": "GetAttributesByType",
      "creates": false,
      "params": { "attributeType": "Surface" },
      "save": {
        "surfA": "attributes[0].attributeId.guid",
        "surfB": "attributes[1].attributeId.guid"
      },
      "expect": [
        { "path": "attributes[1].attributeId.guid", "exists": true, "name": "the project has two surfaces" }
      ]
    },
    {
      "id": "a single-plane and a multi-plane roof",
      "command": "CreateRoofs",
      "params": {
        "roofsData": [
          {
            "level": 0.0,
            "floorIndex": 0,
            "thickness": 0.2,
            "polygonCoordinates": [
              { "x": 900.0, "y": 900.0 },
              { "x": 906.0, "y": 900.0 },
              { "x": 906.0, "y": 904.0 },
              { "x": 900.0, "y": 904.0 }
            ],
            "pivotLine": {
              "begCoordinate": { "x": 900.0, "y": 900.0 },
              "endCoordinate": { "x": 906.0, "y": 900.0 }
            },
            "angle": 0.5
          },
          {
            "level": 0.0,
            "floorIndex": 0,
            "thickness": 0.2,
            "polygonCoordinates": [
              { "x": 920.0, "y": 900.0 },
              { "x": 928.0, "y": 900.0 },
              { "x": 928.0, "y": 906.0 },
              { "x": 920.0, "y": 906.0 }
            ],
            "eavesOverhang": 0.3,
            "levels": [ { "levelHeight": 10.0, "levelAngle": 0.5 } ]
          }
        ]
      },
      "save": {
        "r1": "elements[0].elementId.guid",
        "r2": "elements[1].elementId.guid"
      },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "single-plane roof created" },
        { "path": "elements[1].elementId.guid", "exists": true, "name": "multi-plane roof created" }
      ]
    },
    {
      "id": "the single-plane roof has four edges",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${r1}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.roofClass", "eq": "SinglePlane" },
        { "path": "detailsOfElements[0].details.edgeSideMaterials", "len": 4, "name": "one edge surface per edge" }
      ]
    },
    {
      "id": "surfaces and one edge's custom surface; refused items",
      "command": "ModifyRoofs",
      "creates": false,
      "params": {
        "roofsWithDetails": [
          {
            "elementId": { "guid": "${r1}" },
            "topMaterial": { "overridden": true, "attributeId": { "guid": "${surfA}" } },
            "sideMaterial": { "overridden": true, "attributeId": { "guid": "${surfA}" } },
            "bottomMaterial": { "overridden": true, "attributeId": { "guid": "${surfB}" } },
            "edgeSideMaterials": [
              { "overridden": false },
              { "overridden": true, "attributeId": { "guid": "${surfB}" } },
              { "overridden": false },
              { "overridden": false }
            ]
          },
          {
            "elementId": { "guid": "${r2}" },
            "edgeSideMaterials": [
              { "overridden": false },
              { "overridden": false },
              { "overridden": false },
              { "overridden": false }
            ]
          },
          {
            "elementId": { "guid": "${r1}" },
            "edgeSideMaterials": [
              { "overridden": false },
              { "overridden": false }
            ]
          },
          {
            "elementId": { "guid": "${r1}" },
            "topMaterial": { "overridden": true }
          },
          {
            "elementId": { "guid": "${r1}" },
            "bottomMaterial": { "overridden": true, "attributeId": { "guid": "00000000-0000-0000-0000-00000000BEEF" } }
          }
        ]
      },
      "expect": [
        { "path": "executionResults", "len": 5, "name": "one result per item" },
        { "path": "executionResults[0].success", "eq": true, "name": "surfaces and edge surface written" },
        { "path": "executionResults[1].success", "eq": false, "name": "edgeSideMaterials on a multi-plane roof refused" },
        { "path": "executionResults[2].success", "eq": false, "name": "wrong edge count refused" },
        { "path": "executionResults[3].success", "eq": false, "name": "overridden surface without attributeId refused" },
        { "path": "executionResults[4].success", "eq": false, "name": "unknown surface refused" }
      ]
    },
    {
      "id": "read the surfaces",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${r1}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.topMaterial.overridden", "eq": true, "name": "top surface overridden" },
        { "path": "detailsOfElements[0].details.topMaterial.attributeId.guid", "eq": "${surfA}", "name": "top surface" },
        { "path": "detailsOfElements[0].details.sideMaterial.attributeId.guid", "eq": "${surfA}", "name": "side surface" },
        { "path": "detailsOfElements[0].details.bottomMaterial.attributeId.guid", "eq": "${surfB}", "name": "bottom surface (refused items changed nothing)" },
        { "path": "detailsOfElements[0].details.edgeSideMaterials", "len": 4, "name": "still four edges" },
        { "path": "detailsOfElements[0].details.edgeSideMaterials[1].overridden", "eq": true, "name": "edge 1 has a custom surface" },
        { "path": "detailsOfElements[0].details.edgeSideMaterials[1].attributeId.guid", "eq": "${surfB}", "name": "edge 1 surface" },
        { "path": "detailsOfElements[0].details.edgeSideMaterials[0].overridden", "eq": false, "name": "edge 0 has none" },
        { "path": "detailsOfElements[0].details.edgeSideMaterials[2].overridden", "eq": false, "name": "edge 2 has none" },
        { "path": "detailsOfElements[0].details.polygonOutline", "len": 5, "name": "outline kept" },
        { "path": "detailsOfElements[0].details.angle", "approx": 0.5, "name": "angle kept" }
      ]
    },
    {
      "id": "clear the top surface and the edge's custom surface",
      "command": "ModifyRoofs",
      "creates": false,
      "params": {
        "roofsWithDetails": [
          {
            "elementId": { "guid": "${r1}" },
            "topMaterial": { "overridden": false },
            "edgeSideMaterials": [
              { "overridden": false },
              { "overridden": false },
              { "overridden": false },
              { "overridden": false }
            ]
          }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "overrides cleared" }
      ]
    },
    {
      "id": "read the cleared surfaces",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${r1}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.topMaterial.overridden", "eq": false, "name": "top surface override cleared" },
        { "path": "detailsOfElements[0].details.edgeSideMaterials[1].overridden", "eq": false, "name": "edge 1 custom surface cleared" },
        { "path": "detailsOfElements[0].details.sideMaterial.attributeId.guid", "eq": "${surfA}", "name": "side surface kept" },
        { "path": "detailsOfElements[0].details.bottomMaterial.attributeId.guid", "eq": "${surfB}", "name": "bottom surface kept" }
      ]
    },
    {
      "id": "surfaces of the multi-plane roof, alone and with a new outline",
      "command": "ModifyRoofs",
      "creates": false,
      "params": {
        "roofsWithDetails": [
          {
            "elementId": { "guid": "${r2}" },
            "topMaterial": { "overridden": true, "attributeId": { "guid": "${surfB}" } }
          },
          {
            "elementId": { "guid": "${r2}" },
            "bottomMaterial": { "overridden": true, "attributeId": { "guid": "${surfA}" } },
            "polygonOutline": [
              { "x": 920.0, "y": 900.0 },
              { "x": 929.0, "y": 900.0 },
              { "x": 929.0, "y": 906.0 },
              { "x": 920.0, "y": 906.0 }
            ]
          }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "top surface written" },
        { "path": "executionResults[1].success", "eq": true, "name": "bottom surface written with the outline" }
      ]
    },
    {
      "id": "read the multi-plane roof",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${r2}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.roofClass", "eq": "MultiPlane" },
        { "path": "detailsOfElements[0].details.topMaterial.attributeId.guid", "eq": "${surfB}", "name": "top surface kept through the outline change" },
        { "path": "detailsOfElements[0].details.bottomMaterial.overridden", "eq": true, "name": "bottom surface overridden" },
        { "path": "detailsOfElements[0].details.bottomMaterial.attributeId.guid", "eq": "${surfA}", "name": "bottom surface" }
      ]
    }
  ]
}
