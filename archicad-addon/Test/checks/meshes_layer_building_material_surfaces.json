{
  "title": "CreateMeshes takes layerIndex; CreateMeshes, ModifyMeshes and GetDetailsOfElements write and read the building material and the top, side and bottom surfaces of a mesh (#2630)",
  "minTapir": "2.0.1",
  "requiresEmpty": [ "Mesh" ],
  "steps": [
    {
      "id": "two building materials of the check",
      "command": "CreateBuildingMaterials",
      "creates": false,
      "params": {
        "buildingMaterialDataArray": [
          { "name": "TapirCheck mesh material A" },
          { "name": "TapirCheck mesh material B" }
        ]
      },
      "save": {
        "bmA": "attributeIds[0].attributeId.guid",
        "bmB": "attributeIds[1].attributeId.guid"
      },
      "expect": [
        { "path": "attributeIds[0].attributeId.guid", "exists": true, "name": "material A created" },
        { "path": "attributeIds[1].attributeId.guid", "exists": true, "name": "material B created" }
      ]
    },
    {
      "id": "a layer of the check",
      "command": "CreateLayers",
      "creates": false,
      "params": {
        "layerDataArray": [
          { "name": "TapirCheck mesh layer", "isHidden": false, "isLocked": false }
        ]
      },
      "save": { "layer": "attributeIds[0].attributeId.guid" },
      "expect": [
        { "path": "attributeIds[0].attributeId.guid", "exists": true, "name": "layer created" }
      ]
    },
    {
      "id": "the index of the layer",
      "command": "GetLayers",
      "creates": false,
      "params": {
        "attributeIds": [ { "attributeId": { "guid": "${layer}" } } ],
        "fields": [ "isHidden" ]
      },
      "save": { "layerIndex": "layers[0].index" },
      "expect": [
        { "path": "layers[0].index", "gt": 1, "name": "the layer is not the Archicad layer" }
      ]
    },
    {
      "id": "two surfaces of the project",
      "command": "GetAttributesByType",
      "creates": false,
      "params": { "attributeType": "Surface" },
      "save": {
        "surfA": "attributes[0].attributeId.guid",
        "surfB": "attributes[1].attributeId.guid"
      },
      "expect": [
        { "path": "attributes[1].attributeId.guid", "exists": true, "name": "the project has two surfaces" }
      ]
    },
    {
      "id": "a mesh on the layer with material A and a top surface, a mesh with material B only, and two refused meshes",
      "command": "CreateMeshes",
      "params": {
        "meshesData": [
          {
            "floorIndex": 0,
            "level": 0.0,
            "skirtType": "SolidBodyWithSkirt",
            "skirtLevel": 0.5,
            "layerIndex": "${layerIndex}",
            "buildingMaterialId": { "guid": "${bmA}" },
            "topMaterial": { "overridden": true, "attributeId": { "guid": "${surfA}" } },
            "materialsChained": false,
            "polygonCoordinates": [
              { "x": 960.0, "y": 760.0, "z": 0.0 },
              { "x": 964.0, "y": 760.0, "z": 0.2 },
              { "x": 964.0, "y": 764.0, "z": 0.4 },
              { "x": 960.0, "y": 764.0, "z": 0.1 }
            ]
          },
          {
            "floorIndex": 0,
            "level": 0.0,
            "skirtType": "SolidBodyWithSkirt",
            "skirtLevel": 0.5,
            "buildingMaterialId": { "guid": "${bmB}" },
            "polygonCoordinates": [
              { "x": 970.0, "y": 760.0, "z": 0.0 },
              { "x": 974.0, "y": 760.0, "z": 0.0 },
              { "x": 974.0, "y": 764.0, "z": 0.0 },
              { "x": 970.0, "y": 764.0, "z": 0.0 }
            ]
          },
          {
            "floorIndex": 0,
            "layerIndex": 99999,
            "polygonCoordinates": [
              { "x": 980.0, "y": 760.0, "z": 0.0 },
              { "x": 984.0, "y": 760.0, "z": 0.0 },
              { "x": 984.0, "y": 764.0, "z": 0.0 }
            ]
          },
          {
            "floorIndex": 0,
            "topMaterial": { "overridden": true, "attributeId": { "guid": "00000000-0000-0000-0000-00000000BEEF" } },
            "polygonCoordinates": [
              { "x": 990.0, "y": 760.0, "z": 0.0 },
              { "x": 994.0, "y": 760.0, "z": 0.0 },
              { "x": 994.0, "y": 764.0, "z": 0.0 }
            ]
          }
        ]
      },
      "save": { "m1": "elements[0].elementId.guid", "m2": "elements[1].elementId.guid" },
      "expect": [
        { "path": "elements", "len": 4, "name": "one answer per item" },
        { "path": "elements[0].elementId.guid", "exists": true, "name": "mesh on the layer created" },
        { "path": "elements[1].elementId.guid", "exists": true, "name": "mesh with material B created" },
        { "path": "elements[2].error.code", "exists": true, "name": "a layer index that is no layer is refused" },
        { "path": "elements[3].error.code", "exists": true, "name": "an unknown top surface is refused" }
      ]
    },
    {
      "id": "read the new meshes back",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": {
        "elements": [ { "elementId": { "guid": "${m1}" } }, { "elementId": { "guid": "${m2}" } } ]
      },
      "save": { "m1Layer": "detailsOfElements[0].layerIndex" },
      "expect": [
        { "expr": "${m1Layer} - ${layerIndex}", "approx": 0, "name": "the mesh is on the given layer" },
        { "path": "detailsOfElements[0].details.buildingMaterialId.guid", "eq": "${bmA}", "name": "material A read back" },
        { "path": "detailsOfElements[0].details.topMaterial.overridden", "eq": true, "name": "top surface overridden" },
        { "path": "detailsOfElements[0].details.topMaterial.attributeId.guid", "eq": "${surfA}", "name": "top surface is surface A" },
        { "path": "detailsOfElements[0].details.sideMaterial.overridden", "eq": false, "name": "side surface from the building material" },
        { "path": "detailsOfElements[0].details.bottomMaterial.overridden", "eq": false, "name": "bottom surface from the building material" },
        { "path": "detailsOfElements[0].details.materialsChained", "eq": false, "name": "surfaces not chained" },
        { "path": "detailsOfElements[0].details.skirtLevel", "approx": 0.5, "name": "skirt level kept" },
        { "path": "detailsOfElements[1].details.buildingMaterialId.guid", "eq": "${bmB}", "name": "material B read back" },
        { "path": "detailsOfElements[1].details.topMaterial.overridden", "eq": false, "name": "a building material alone clears the top surface override" },
        { "path": "detailsOfElements[1].details.sideMaterial.overridden", "eq": false, "name": "a building material alone clears the side surface override" },
        { "path": "detailsOfElements[1].details.bottomMaterial.overridden", "eq": false, "name": "a building material alone clears the bottom surface override" }
      ]
    },
    {
      "id": "material B and side and bottom surfaces on the first mesh, top surface cleared; refused items",
      "command": "ModifyMeshes",
      "creates": false,
      "params": {
        "meshesData": [
          {
            "elementId": { "guid": "${m1}" },
            "meshData": {
              "buildingMaterialId": { "guid": "${bmB}" },
              "topMaterial": { "overridden": false },
              "sideMaterial": { "overridden": true, "attributeId": { "guid": "${surfB}" } },
              "bottomMaterial": { "overridden": true, "attributeId": { "guid": "${surfA}" } },
              "contourPen": 5,
              "levelPen": 6
            }
          },
          {
            "elementId": { "guid": "${m2}" },
            "meshData": {
              "topMaterial": { "overridden": true, "attributeId": { "guid": "${surfB}" } }
            }
          },
          {
            "elementId": { "guid": "${m1}" },
            "meshData": {
              "sideMaterial": { "overridden": true, "attributeId": { "guid": "00000000-0000-0000-0000-00000000BEEF" } },
              "contourPen": 7
            }
          },
          {
            "elementId": { "guid": "${m1}" },
            "meshData": {
              "buildingMaterialId": { "guid": "00000000-0000-0000-0000-00000000BEEF" },
              "levelPen": 8
            }
          }
        ]
      },
      "expect": [
        { "path": "executionResults", "len": 4, "name": "one result per item" },
        { "path": "executionResults[0].success", "eq": true, "name": "material and surfaces written" },
        { "path": "executionResults[1].success", "eq": true, "name": "top surface of the second mesh written" },
        { "path": "executionResults[2].success", "eq": false, "name": "an unknown side surface is refused" },
        { "path": "executionResults[3].success", "eq": false, "name": "an unknown building material is refused" }
      ]
    },
    {
      "id": "read the modified meshes back",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": {
        "elements": [ { "elementId": { "guid": "${m1}" } }, { "elementId": { "guid": "${m2}" } } ]
      },
      "save": { "m1LayerAfter": "detailsOfElements[0].layerIndex" },
      "expect": [
        { "path": "detailsOfElements[0].details.buildingMaterialId.guid", "eq": "${bmB}", "name": "material B written" },
        { "path": "detailsOfElements[0].details.topMaterial.overridden", "eq": false, "name": "top surface override cleared" },
        { "path": "detailsOfElements[0].details.sideMaterial.overridden", "eq": true, "name": "side surface overridden" },
        { "path": "detailsOfElements[0].details.sideMaterial.attributeId.guid", "eq": "${surfB}", "name": "side surface is surface B" },
        { "path": "detailsOfElements[0].details.bottomMaterial.overridden", "eq": true, "name": "bottom surface overridden" },
        { "path": "detailsOfElements[0].details.bottomMaterial.attributeId.guid", "eq": "${surfA}", "name": "bottom surface is surface A" },
        { "path": "detailsOfElements[0].details.contourPen", "eq": 5, "name": "the refused item with a bad surface changed no contour pen" },
        { "path": "detailsOfElements[0].details.levelPen", "eq": 6, "name": "the refused item with a bad building material changed no level pen" },
        { "expr": "${m1LayerAfter} - ${layerIndex}", "approx": 0, "name": "layer kept" },
        { "path": "detailsOfElements[0].details.polygonCoordinates[2].z", "approx": 0.4, "name": "outline kept" },
        { "path": "detailsOfElements[1].details.buildingMaterialId.guid", "eq": "${bmB}", "name": "material B kept on the second mesh" },
        { "path": "detailsOfElements[1].details.topMaterial.overridden", "eq": true, "name": "top surface of the second mesh overridden" },
        { "path": "detailsOfElements[1].details.topMaterial.attributeId.guid", "eq": "${surfB}", "name": "top surface of the second mesh is surface B" },
        { "path": "detailsOfElements[1].details.sideMaterial.overridden", "eq": false, "name": "side surface of the second mesh kept" }
      ]
    }
  ],
  "teardown": [
    {
      "command": "DeleteAttributes",
      "params": {
        "attributesToDelete": [
          { "attributeType": "BuildingMaterial", "attributeId": { "attributeId": { "guid": "${bmA}" } } },
          { "attributeType": "BuildingMaterial", "attributeId": { "attributeId": { "guid": "${bmB}" } } }
        ]
      }
    },
    {
      "command": "DeleteAttributes",
      "params": { "attributesToDelete": [ { "attributeType": "Layer", "attributeId": { "attributeId": { "guid": "${layer}" } } } ] }
    }
  ]
}
