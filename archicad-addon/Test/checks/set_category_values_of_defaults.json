{
  "title": "SetCategoryValuesOfDefaults sets the Renovation Status and Structural Function new walls and slabs get, a dry run changes nothing, a value of another category is refused, and GetCategoryValuesOfDefaults reads the values back (#2692)",
  "minTapir": "2.0.1",
  "requiresEmpty": [],
  "steps": [
    {
      "id": "the defaults now",
      "command": "GetCategoryValuesOfDefaults",
      "creates": false,
      "params": {"elementTypes": ["Wall", "Slab"], "categories": ["RenovationStatus", "StructuralFunction"]},
      "save": {
        "wallRen0": "categoryValuesOfDefaults[0].categoryValues[0].categoryValueId.guid",
        "wallSf0": "categoryValuesOfDefaults[0].categoryValues[1].categoryValueId.guid",
        "slabRen0": "categoryValuesOfDefaults[1].categoryValues[0].categoryValueId.guid",
        "slabSf0": "categoryValuesOfDefaults[1].categoryValues[1].categoryValueId.guid"
      },
      "expect": [
        {"path": "categoryValuesOfDefaults", "len": 2},
        {"path": "categoryValuesOfDefaults[0].categoryValues[0].type", "eq": "RenovationStatus"},
        {"path": "categoryValuesOfDefaults[0].categoryValues[0].categoryValueId.guid", "exists": true, "name": "the wall default has a Renovation Status"},
        {"path": "categoryValuesOfDefaults[0].categoryValues[1].categoryValueId.guid", "exists": true, "name": "the wall default has a Structural Function"},
        {"path": "categoryValuesOfDefaults[1].categoryValues[0].categoryValueId.guid", "exists": true, "name": "the slab default has a Renovation Status"},
        {"path": "categoryValuesOfDefaults[1].categoryValues[1].categoryValueId.guid", "exists": true, "name": "the slab default has a Structural Function"}
      ]
    },
    {
      "id": "set To Be Demolished and Load-Bearing",
      "command": "SetCategoryValuesOfDefaults",
      "creates": false,
      "params": {
        "elementTypes": ["Wall", "Slab"],
        "categoryValues": [
          {"type": "RenovationStatus", "categoryValueId": {"guid": "57E66097-9C38-8012-D9C7-0CA01AA5EB1E"}},
          {"type": "StructuralFunction", "categoryValueId": {"guid": "C852BD7D-1198-2802-7E37-E4925B997B8B"}}
        ]
      },
      "expect": [
        {"path": "executionResults", "len": 4, "name": "one result per element type and value"},
        {"path": "executionResults[0].success", "eq": true, "name": "wall renovation status"},
        {"path": "executionResults[1].success", "eq": true, "name": "wall structural function"},
        {"path": "executionResults[2].success", "eq": true, "name": "slab renovation status"},
        {"path": "executionResults[3].success", "eq": true, "name": "slab structural function"},
        {"path": "dryRun", "exists": false, "name": "not a dry run"}
      ]
    },
    {
      "id": "read back To Be Demolished and Load-Bearing",
      "command": "GetCategoryValuesOfDefaults",
      "creates": false,
      "params": {"elementTypes": ["Wall", "Slab"], "categories": ["RenovationStatus", "StructuralFunction"]},
      "expect": [
        {"path": "categoryValuesOfDefaults[0].categoryValues[0].categoryValueId.guid", "eq": "57E66097-9C38-8012-D9C7-0CA01AA5EB1E", "name": "wall default is To Be Demolished"},
        {"path": "categoryValuesOfDefaults[0].categoryValues[1].categoryValueId.guid", "eq": "C852BD7D-1198-2802-7E37-E4925B997B8B", "name": "wall default is Load-Bearing"},
        {"path": "categoryValuesOfDefaults[1].categoryValues[0].categoryValueId.guid", "eq": "57E66097-9C38-8012-D9C7-0CA01AA5EB1E", "name": "slab default is To Be Demolished"},
        {"path": "categoryValuesOfDefaults[1].categoryValues[1].categoryValueId.guid", "eq": "C852BD7D-1198-2802-7E37-E4925B997B8B", "name": "slab default is Load-Bearing"}
      ]
    },
    {
      "id": "dry run: New for the wall",
      "command": "SetCategoryValuesOfDefaults",
      "creates": false,
      "params": {
        "elementTypes": ["Wall"],
        "categoryValues": [{"type": "RenovationStatus", "categoryValueId": {"guid": "913BE5A9-C24C-DD41-AE08-079792A58CF6"}}],
        "dryRun": true
      },
      "expect": [
        {"path": "dryRun", "eq": true},
        {"path": "executionResults", "len": 1},
        {"path": "executionResults[0].success", "eq": true},
        {"path": "executionResults[0].wouldChange.oldValue.categoryValueId.guid", "eq": "57E66097-9C38-8012-D9C7-0CA01AA5EB1E", "name": "oldValue is the default now"},
        {"path": "executionResults[0].wouldChange.newValue.categoryValueId.guid", "eq": "913BE5A9-C24C-DD41-AE08-079792A58CF6", "name": "newValue is New"},
        {"path": "executionResults[0].wouldChange.newValue.type", "eq": "RenovationStatus"}
      ]
    },
    {
      "id": "the dry run changed nothing",
      "command": "GetCategoryValuesOfDefaults",
      "creates": false,
      "params": {"elementTypes": ["Wall"], "categories": ["RenovationStatus"]},
      "expect": [
        {"path": "categoryValuesOfDefaults[0].categoryValues[0].categoryValueId.guid", "eq": "57E66097-9C38-8012-D9C7-0CA01AA5EB1E", "name": "still To Be Demolished"}
      ]
    },
    {
      "id": "bad input: a Structural Function value given as a Renovation Status, next to a good one",
      "command": "SetCategoryValuesOfDefaults",
      "creates": false,
      "params": {
        "elementTypes": ["Wall"],
        "categoryValues": [
          {"type": "RenovationStatus", "categoryValueId": {"guid": "C852BD7D-1198-2802-7E37-E4925B997B8B"}},
          {"type": "StructuralFunction", "categoryValueId": {"guid": "539EA1F2-E319-7D11-7CAC-CCAA638FAD6E"}}
        ]
      },
      "expect": [
        {"path": "executionResults", "len": 2},
        {"path": "executionResults[0].success", "eq": false, "name": "the wrong category's value is refused"},
        {"path": "executionResults[1].success", "eq": true, "name": "the good item is still set"}
      ]
    },
    {
      "id": "the refused value changed nothing, the good one was set",
      "command": "GetCategoryValuesOfDefaults",
      "creates": false,
      "params": {"elementTypes": ["Wall"], "categories": ["RenovationStatus", "StructuralFunction"]},
      "expect": [
        {"path": "categoryValuesOfDefaults[0].categoryValues[0].categoryValueId.guid", "eq": "57E66097-9C38-8012-D9C7-0CA01AA5EB1E", "name": "still To Be Demolished"},
        {"path": "categoryValuesOfDefaults[0].categoryValues[1].categoryValueId.guid", "eq": "539EA1F2-E319-7D11-7CAC-CCAA638FAD6E", "name": "now Non-Load-Bearing"}
      ]
    },
    {
      "id": "set New for the wall",
      "command": "SetCategoryValuesOfDefaults",
      "creates": false,
      "params": {
        "elementTypes": ["Wall"],
        "categoryValues": [{"type": "RenovationStatus", "categoryValueId": {"guid": "913BE5A9-C24C-DD41-AE08-079792A58CF6"}}]
      },
      "expect": [
        {"path": "executionResults", "len": 1},
        {"path": "executionResults[0].success", "eq": true}
      ]
    },
    {
      "id": "a new wall gets New",
      "command": "CreateWalls",
      "params": {"wallsData": [{"begCoordinate": {"x": 720, "y": 720}, "endCoordinate": {"x": 724, "y": 720},
                                "zCoordinate": 0, "height": 2.5, "thickness": 0.2}]},
      "save": {"w1": "elements[0].elementId.guid"},
      "expect": [
        {"path": "elements[0].elementId.guid", "exists": true}
      ]
    },
    {
      "id": "read the new wall's Renovation Status",
      "command": "GetCategoryValuesOfElements",
      "creates": false,
      "params": {"elements": [{"elementId": {"guid": "${w1}"}}], "categories": ["RenovationStatus"]},
      "expect": [
        {"path": "categoryValuesOfElements[0].categoryValues[0].categoryValueId.guid", "eq": "913BE5A9-C24C-DD41-AE08-079792A58CF6", "name": "the new wall is New"}
      ]
    }
  ],
  "teardown": [
    {
      "command": "SetCategoryValuesOfDefaults",
      "params": {
        "elementTypes": ["Wall"],
        "categoryValues": [
          {"type": "RenovationStatus", "categoryValueId": {"guid": "${wallRen0}"}},
          {"type": "StructuralFunction", "categoryValueId": {"guid": "${wallSf0}"}}
        ]
      }
    },
    {
      "command": "SetCategoryValuesOfDefaults",
      "params": {
        "elementTypes": ["Slab"],
        "categoryValues": [
          {"type": "RenovationStatus", "categoryValueId": {"guid": "${slabRen0}"}},
          {"type": "StructuralFunction", "categoryValueId": {"guid": "${slabSf0}"}}
        ]
      }
    }
  ]
}
