{
  "title": "GetLibraryPartFileInfo returns the parameters of a .gsm file with their default values and descriptions, without loading the file (#1265)",
  "minTapir": "2.0.1",
  "minArchicad": "28",
  "requiresEmpty": [],
  "steps": [
    {
      "id": "a part with a length, a text and a boolean parameter",
      "command": "CreateLibraryParts",
      "creates": false,
      "params": {
        "libraryParts": [
          {
            "name": "TapirCheckFileParams",
            "parentName": "Model Element",
            "path": "TapirCheckFileParams/TapirCheckFileParams.gsm",
            "a": 0.6,
            "b": 0.4,
            "script3D": "BLOCK A, B, 1",
            "parameters": [
              { "name": "tapirLength", "type": "Length", "value": 0.75, "description": "Tapir Length" },
              { "name": "tapirText", "type": "String", "value": "file value", "description": "Tapir Text" },
              { "name": "tapirFlag", "type": "Boolean", "value": true, "description": "Tapir Flag" }
            ]
          }
        ],
        "overwriteExisting": true
      },
      "save": { "partIndex": "libraryParts[0].index" },
      "expect": [
        { "path": "libraryParts[0].name", "eq": "TapirCheckFileParams", "name": "part created" }
      ],
      "stopOnFail": true
    },
    {
      "id": "the file of the part",
      "command": "GetLibraryPartIdentities",
      "creates": false,
      "params": { "libraryParts": [{ "index": "${partIndex}" }] },
      "save": { "partPath": "identities[0].path" },
      "expect": [
        { "path": "identities[0].path", "contains": "TapirCheckFileParams.gsm", "name": "path of the part" }
      ],
      "stopOnFail": true
    },
    {
      "id": "read the file with its parameters",
      "command": "GetLibraryPartFileInfo",
      "creates": false,
      "params": { "files": [ "${partPath}" ], "scripts": [ "3d" ], "includeParameters": true },
      "expect": [
        { "path": "files", "len": 1, "name": "one item per file" },
        { "path": "files[0].scripts.3d.script", "contains": "BLOCK A, B, 1", "name": "the scripts are still read" },
        { "path": "files[0].parameters[*].name", "eq": ["A", "B", "tapirLength", "tapirText", "tapirFlag"], "name": "A, B and the three own parameters, in order" },
        { "path": "files[0].parameters[0].value", "approx": 0.6, "name": "A as created" },
        { "path": "files[0].parameters[2].type", "eq": "Length", "name": "tapirLength is a Length" },
        { "path": "files[0].parameters[2].value", "approx": 0.75, "name": "tapirLength as created" },
        { "path": "files[0].parameters[2].description", "eq": "Tapir Length", "name": "tapirLength description" },
        { "path": "files[0].parameters[3].type", "eq": "String", "name": "tapirText is a String" },
        { "path": "files[0].parameters[3].value", "eq": "file value", "name": "tapirText as created" },
        { "path": "files[0].parameters[4].type", "eq": "Boolean", "name": "tapirFlag is a Boolean" },
        { "path": "files[0].parameters[4].value", "eq": true, "name": "tapirFlag as created" }
      ]
    },
    {
      "id": "without the parameters",
      "command": "GetLibraryPartFileInfo",
      "creates": false,
      "params": { "files": [ "${partPath}" ], "scripts": [ "3d" ], "includeParameters": false },
      "expect": [
        { "path": "files[0].scripts.3d.present", "eq": true, "name": "the script is read" },
        { "path": "files[0].parameters", "exists": false, "name": "no parameters when not asked for" }
      ]
    }
  ]
}
