{
  "title": "SolveStairBaseline returns the rules CreateStairs lays the steps out by (#2526)",
  "minTapir": "2.0.1",
  "minArchicad": "27",
  "steps": [
    {
      "id": "solve with an explicit going",
      "command": "SolveStairBaseline",
      "creates": false,
      "params": {
        "stairsData": [
          {
            "baseLinePoints": [ { "x": 530.0, "y": 50.0 }, { "x": 534.0, "y": 50.0 } ],
            "zCoordinate": 0.0,
            "floorIndex": 0,
            "totalHeight": 2.8,
            "flightWidth": 1.1,
            "stepNum": 14,
            "riserHeight": 0.2,
            "treadDepth": 0.29
          }
        ]
      },
      "expect": [
        { "path": "solutions[0].solution", "exists": true, "name": "solved" },
        { "path": "solutions[0].rules.treadDepthMinValue", "approx": 0.29, "tol": 0.0001, "name": "going pinned: minimum" },
        { "path": "solutions[0].rules.treadDepthMaxValue", "approx": 0.29, "tol": 0.0001, "name": "going pinned: maximum" },
        { "path": "solutions[0].rules.treadDepthMinApplied", "eq": true, "name": "going minimum applied" },
        { "path": "solutions[0].rules.treadDepthMaxApplied", "eq": true, "name": "going maximum applied" },
        { "path": "solutions[0].rules.ruleMinApplied", "eq": false, "name": "2R+G minimum released" },
        { "path": "solutions[0].rules.ruleMaxApplied", "eq": false, "name": "2R+G maximum released" },
        { "path": "solutions[0].rules.riserPlusGoingMaxApplied", "eq": false, "name": "R+G released" },
        { "path": "solutions[0].rules.riserGoingRatioMaxApplied", "eq": false, "name": "R/G released" },
        { "path": "solutions[0].rules.riserHeightMinValue", "exists": true, "name": "riser height minimum reported" },
        { "path": "solutions[0].rules.riserHeightMaxValue", "exists": true, "name": "riser height maximum reported" },
        { "path": "solutions[0].rules.riserHeightMaxApplied", "exists": true, "name": "whether it applies is reported" }
      ]
    },
    {
      "id": "solve without a going",
      "command": "SolveStairBaseline",
      "creates": false,
      "params": {
        "stairsData": [
          {
            "baseLinePoints": [ { "x": 470.0, "y": 40.0 }, { "x": 474.0, "y": 40.0 } ],
            "zCoordinate": 0.0,
            "floorIndex": 0,
            "totalHeight": 2.8,
            "flightWidth": 1.1
          }
        ]
      },
      "expect": [
        { "path": "solutions[0].rules.treadDepthMinValue", "exists": true, "name": "the tool defaults' going limits reported" },
        { "path": "solutions[0].rules.riserHeightMaxValue", "exists": true, "name": "the tool defaults' riser limits reported" },
        { "path": "solutions[0].rules.stairPitchMaxValue", "exists": true, "name": "the pitch limit reported" }
      ]
    }
  ]
}
