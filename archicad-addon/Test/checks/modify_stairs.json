{
  "title": "ModifyStairs writes the floor plan and the reflected ceiling plan display of a stair independently: shown stories, walking line and structure (#2530)",
  "minTapir": "2.0.1",
  "steps": [
    {
      "id": "create a straight stair",
      "command": "CreateStairs",
      "params": {
        "stairsData": [
          {
            "baseLinePoints": [
              { "x": 760.0, "y": 700.0 },
              { "x": 766.0, "y": 700.0 }
            ],
            "zCoordinate": 0.0,
            "floorIndex": 0,
            "totalHeight": 2.8,
            "flightWidth": 1.2
          }
        ]
      },
      "save": { "s": "elements[0].elementId.guid" },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "stair created" }
      ]
    },
    {
      "id": "set the floor plan to the home story only and the RCP to home and one story up",
      "command": "ModifyStairs",
      "creates": false,
      "params": {
        "stairsWithDetails": [
          {
            "elementId": { "guid": "${s}" },
            "stairDisplayType": "Custom",
            "floorPlanLayout": { "storyVisibility": "HomeStoryOnly", "showWalkingLine": false, "showStructure": true },
            "reflectedCeilingPlanLayout": { "storyVisibility": "HomeAndOneStoryUp", "showWalkingLine": true, "showStructure": false }
          }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "display settings accepted and read back as given" }
      ]
    },
    {
      "id": "read the display back",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${s}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.stairDisplayType", "eq": "Custom", "name": "display type Custom" },
        { "path": "detailsOfElements[0].details.floorPlanLayout.storyVisibility", "eq": "HomeStoryOnly", "name": "floor plan on the home story only" },
        { "path": "detailsOfElements[0].details.floorPlanLayout.showWalkingLine", "eq": false, "name": "floor plan walking line hidden" },
        { "path": "detailsOfElements[0].details.floorPlanLayout.showStructure", "eq": true, "name": "floor plan structure shown" },
        { "path": "detailsOfElements[0].details.reflectedCeilingPlanLayout.storyVisibility", "eq": "HomeAndOneStoryUp", "name": "RCP on home and one story up" },
        { "path": "detailsOfElements[0].details.reflectedCeilingPlanLayout.showWalkingLine", "eq": true, "name": "RCP walking line shown" },
        { "path": "detailsOfElements[0].details.reflectedCeilingPlanLayout.showStructure", "eq": false, "name": "RCP structure hidden" },
        { "path": "detailsOfElements[0].details.flightWidth", "approx": 1.2, "name": "flight width unchanged" }
      ]
    },
    {
      "id": "change only the floor plan stories",
      "command": "ModifyStairs",
      "creates": false,
      "params": {
        "stairsWithDetails": [
          {
            "elementId": { "guid": "${s}" },
            "floorPlanLayout": { "storyVisibility": "HomeAndOneStoryDown" }
          }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "floor plan stories change accepted" }
      ]
    },
    {
      "id": "the reflected ceiling plan is kept",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${s}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.floorPlanLayout.storyVisibility", "eq": "HomeAndOneStoryDown", "name": "floor plan stories changed" },
        { "path": "detailsOfElements[0].details.floorPlanLayout.showWalkingLine", "eq": false, "name": "floor plan walking line still hidden" },
        { "path": "detailsOfElements[0].details.reflectedCeilingPlanLayout.storyVisibility", "eq": "HomeAndOneStoryUp", "name": "RCP stories unchanged" },
        { "path": "detailsOfElements[0].details.reflectedCeilingPlanLayout.showStructure", "eq": false, "name": "RCP structure still hidden" }
      ]
    },
    {
      "id": "a bad story visibility is refused by the schema",
      "command": "ModifyStairs",
      "creates": false,
      "params": {
        "stairsWithDetails": [
          { "elementId": { "guid": "${s}" }, "floorPlanLayout": { "storyVisibility": "EveryOtherStory" } }
        ]
      },
      "expect": [
        { "path": "error.code", "exists": true, "name": "refused" }
      ]
    }
  ]
}
