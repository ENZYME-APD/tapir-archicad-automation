{
  "title": "GetDetailsOfElements reads and ModifyRoofs writes the edge types of a single-plane roof without changing its polygon or edge cuts",
  "minTapir": "2.0.1",
  "requiresEmpty": [ "Roof" ],
  "steps": [
    {
      "id": "a single-plane and a multi-plane roof",
      "command": "CreateRoofs",
      "params": {
        "roofsData": [
          {
            "level": 0.0,
            "floorIndex": 0,
            "thickness": 0.2,
            "polygonCoordinates": [
              { "x": 900.0, "y": 900.0 },
              { "x": 906.0, "y": 900.0 },
              { "x": 906.0, "y": 904.0 },
              { "x": 900.0, "y": 904.0 }
            ],
            "pivotLine": {
              "begCoordinate": { "x": 900.0, "y": 900.0 },
              "endCoordinate": { "x": 906.0, "y": 900.0 }
            },
            "angle": 0.5
          },
          {
            "level": 0.0,
            "floorIndex": 0,
            "thickness": 0.2,
            "polygonCoordinates": [
              { "x": 920.0, "y": 900.0 },
              { "x": 928.0, "y": 900.0 },
              { "x": 928.0, "y": 906.0 },
              { "x": 920.0, "y": 906.0 }
            ],
            "eavesOverhang": 0.3,
            "levels": [ { "levelHeight": 10.0, "levelAngle": 0.5 } ]
          }
        ]
      },
      "save": {
        "r1": "elements[0].elementId.guid",
        "r2": "elements[1].elementId.guid"
      },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "single-plane roof created" },
        { "path": "elements[1].elementId.guid", "exists": true, "name": "multi-plane roof created" }
      ]
    },
    {
      "id": "a new single-plane roof has one Undefined edge type per edge",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${r1}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.edgeTypes", "len": 4, "name": "one edge type per edge" },
        { "path": "detailsOfElements[0].details.edgeTypes[0]", "eq": "Undefined" },
        { "path": "detailsOfElements[0].details.edgeTypes[2]", "eq": "Undefined" }
      ]
    },
    {
      "id": "a custom cut on the second edge",
      "command": "ModifyRoofs",
      "creates": false,
      "params": {
        "roofsWithDetails": [
          {
            "elementId": { "guid": "${r1}" },
            "edgeTrims": [ {}, { "trimType": "CustomAngle", "angle": 1.2 }, {}, {} ]
          }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "edge cut set" }
      ]
    },
    {
      "id": "edge types; a wrong edge count, a multi-plane roof and edge types with a new outline",
      "command": "ModifyRoofs",
      "creates": false,
      "params": {
        "roofsWithDetails": [
          {
            "elementId": { "guid": "${r1}" },
            "edgeTypes": [ "Eaves", "Gable", "Ridge", "Undefined" ]
          },
          {
            "elementId": { "guid": "${r1}" },
            "edgeTypes": [ "Hip", "Hip", "Hip" ]
          },
          {
            "elementId": { "guid": "${r2}" },
            "edgeTypes": [ "Eaves", "Eaves", "Eaves", "Eaves" ]
          },
          {
            "elementId": { "guid": "${r1}" },
            "edgeTypes": [ "Hip", "Hip", "Hip", "Hip" ],
            "polygonOutline": [
              { "x": 900.0, "y": 900.0 },
              { "x": 907.0, "y": 900.0 },
              { "x": 907.0, "y": 904.0 },
              { "x": 900.0, "y": 904.0 }
            ]
          }
        ]
      },
      "expect": [
        { "path": "executionResults", "len": 4, "name": "one result per item" },
        { "path": "executionResults[0].success", "eq": true, "name": "edge types set" },
        { "path": "executionResults[1].success", "eq": false, "name": "wrong edge count refused" },
        { "path": "executionResults[2].success", "eq": false, "name": "multi-plane roof refused" },
        { "path": "executionResults[3].success", "eq": false, "name": "edge types with polygonOutline refused" }
      ]
    },
    {
      "id": "the edge types are read back; outline and edge cuts are kept",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${r1}" } }, { "elementId": { "guid": "${r2}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.edgeTypes", "len": 4 },
        { "path": "detailsOfElements[0].details.edgeTypes[0]", "eq": "Eaves" },
        { "path": "detailsOfElements[0].details.edgeTypes[1]", "eq": "Gable" },
        { "path": "detailsOfElements[0].details.edgeTypes[2]", "eq": "Ridge" },
        { "path": "detailsOfElements[0].details.edgeTypes[3]", "eq": "Undefined" },
        { "path": "detailsOfElements[0].details.edgeTrims[1].trimType", "eq": "CustomAngle", "name": "edge cut kept" },
        { "path": "detailsOfElements[0].details.edgeTrims[1].angle", "approx": 1.2, "name": "edge cut angle kept" },
        { "path": "detailsOfElements[0].details.edgeTrims[0].trimType", "eq": "Vertical", "name": "other edge cut kept" },
        { "path": "detailsOfElements[0].details.polygonOutline", "len": 5, "name": "outline kept" },
        { "path": "detailsOfElements[0].details.polygonOutline[2].x", "approx": 906.0, "name": "corner kept (x)" },
        { "path": "detailsOfElements[0].details.polygonOutline[2].y", "approx": 904.0, "name": "corner kept (y)" },
        { "path": "detailsOfElements[0].details.angle", "approx": 0.5, "name": "angle kept" },
        { "path": "detailsOfElements[1].details.roofClass", "eq": "MultiPlane" },
        { "path": "detailsOfElements[1].details.edgeTypes", "exists": false, "name": "no edge types for a multi-plane roof" }
      ]
    },
    {
      "id": "edge cuts written after the edge types",
      "command": "ModifyRoofs",
      "creates": false,
      "params": {
        "roofsWithDetails": [
          {
            "elementId": { "guid": "${r1}" },
            "edgeTrims": [ { "trimType": "Perpendicular" }, {}, {}, {} ]
          }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true }
      ]
    },
    {
      "id": "a wider outline keeps the edge types of the edges it keeps",
      "command": "ModifyRoofs",
      "creates": false,
      "params": {
        "roofsWithDetails": [
          {
            "elementId": { "guid": "${r1}" },
            "polygonOutline": [
              { "x": 900.0, "y": 900.0 },
              { "x": 907.0, "y": 900.0 },
              { "x": 907.0, "y": 904.0 },
              { "x": 900.0, "y": 904.0 }
            ]
          }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true }
      ]
    },
    {
      "id": "edge types survive the edge cut and the outline change",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${r1}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.polygonOutline[2].x", "approx": 907.0, "name": "outline changed" },
        { "path": "detailsOfElements[0].details.edgeTrims[0].trimType", "eq": "Perpendicular", "name": "new edge cut" },
        { "path": "detailsOfElements[0].details.edgeTypes", "len": 4 },
        { "path": "detailsOfElements[0].details.edgeTypes[0]", "eq": "Eaves", "name": "edge type kept by the edge cut and the outline change" },
        { "path": "detailsOfElements[0].details.edgeTypes[1]", "eq": "Gable" },
        { "path": "detailsOfElements[0].details.edgeTypes[2]", "eq": "Ridge" }
      ]
    }
  ]
}
