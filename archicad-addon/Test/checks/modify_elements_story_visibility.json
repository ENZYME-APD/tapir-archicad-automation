{
  "title": "ModifyWalls, ModifyBeams, ModifyColumns, ModifySlabs and ModifyMorphs write every field of the story visibility, not only showOnHome, and CreateMorphs keeps the one it is given",
  "minTapir": "2.0.2",
  "minArchicad": "27",
  "steps": [
    {
      "id": "a wall",
      "command": "CreateWalls",
      "params": {
        "wallsData": [
          {
            "begCoordinate": {
              "x": 930.0,
              "y": 925.0
            },
            "endCoordinate": {
              "x": 934.0,
              "y": 925.0
            },
            "zCoordinate": 0,
            "height": 2.5,
            "thickness": 0.2
          }
        ]
      },
      "save": {
        "wall": "elements[0].elementId.guid"
      },
      "expect": [
        {
          "path": "elements[0].elementId.guid",
          "exists": true,
          "name": "wall created"
        }
      ]
    },
    {
      "id": "a beam",
      "command": "CreateBeams",
      "params": {
        "beamsData": [
          {
            "begCoordinate": {
              "x": 930.0,
              "y": 930.0
            },
            "endCoordinate": {
              "x": 934.0,
              "y": 930.0
            },
            "zCoordinate": 3.0,
            "width": 0.2,
            "height": 0.3,
            "isWidthAndHeightLinked": false
          }
        ]
      },
      "save": {
        "beam": "elements[0].elementId.guid"
      },
      "expect": [
        {
          "path": "elements[0].elementId.guid",
          "exists": true,
          "name": "beam created"
        }
      ]
    },
    {
      "id": "a column",
      "command": "CreateColumns",
      "params": {
        "columnsData": [
          {
            "coordinates": {
              "x": 930.0,
              "y": 935.0,
              "z": 0.0
            },
            "floorIndex": 0,
            "height": 2.8,
            "circleBased": false,
            "isWidthAndHeightLinked": false,
            "width": 0.3,
            "depth": 0.3
          }
        ]
      },
      "save": {
        "column": "elements[0].elementId.guid"
      },
      "expect": [
        {
          "path": "elements[0].elementId.guid",
          "exists": true,
          "name": "column created"
        }
      ]
    },
    {
      "id": "a slab",
      "command": "CreateSlabs",
      "params": {
        "slabsData": [
          {
            "level": 0,
            "floorIndex": 0,
            "thickness": 0.3,
            "structureType": "Basic",
            "polygonCoordinates": [
              {
                "x": 930,
                "y": 940
              },
              {
                "x": 933,
                "y": 940
              },
              {
                "x": 933,
                "y": 943
              },
              {
                "x": 930,
                "y": 943
              }
            ]
          }
        ]
      },
      "save": {
        "slab": "elements[0].elementId.guid"
      },
      "expect": [
        {
          "path": "elements[0].elementId.guid",
          "exists": true,
          "name": "slab created"
        }
      ]
    },
    {
      "id": "a morph",
      "command": "CreateMorphs",
      "params": {
        "morphsData": [
          {
            "floorIndex": 0,
            "layerIndex": 1,
            "basePoint": {
              "x": 930.0,
              "y": 946.0,
              "z": 0.0
            },
            "size": {
              "x": 1.0,
              "y": 1.0,
              "z": 1.0
            }
          }
        ]
      },
      "save": {
        "morph": "elements[0].elementId.guid"
      },
      "expect": [
        {
          "path": "elements[0].elementId.guid",
          "exists": true,
          "name": "morph created"
        }
      ]
    },
    {
      "id": "a morph created on its home story and one story up and down",
      "command": "CreateMorphs",
      "params": {
        "morphsData": [
          {
            "floorIndex": 0,
            "layerIndex": 1,
            "basePoint": {
              "x": 930.0,
              "y": 950.0,
              "z": 0.0
            },
            "size": {
              "x": 1.0,
              "y": 1.0,
              "z": 1.0
            },
            "isAutoOnStoryVisibility": false,
            "showContour": {
              "showOnHome": true,
              "showAllAbove": false,
              "showAllBelow": false,
              "showRelAbove": 1,
              "showRelBelow": 1
            },
            "showFill": {
              "showOnHome": true,
              "showAllAbove": false,
              "showAllBelow": false,
              "showRelAbove": 1,
              "showRelBelow": 1
            }
          }
        ]
      },
      "save": {
        "createdMorph": "elements[0].elementId.guid"
      },
      "expect": [
        {
          "path": "elements[0].elementId.guid",
          "exists": true,
          "name": "morph created"
        }
      ]
    },
    {
      "id": "wall: home, one story up and one down",
      "command": "ModifyWalls",
      "creates": false,
      "params": {
        "wallsWithDetails": [
          {
            "elementId": {
              "guid": "${wall}"
            },
            "isAutoOnStoryVisibility": false,
            "visibility": {
              "showOnHome": true,
              "showAllAbove": false,
              "showAllBelow": false,
              "showRelAbove": 1,
              "showRelBelow": 1
            }
          }
        ]
      },
      "expect": [
        {
          "path": "executionResults[0].success",
          "eq": true
        }
      ]
    },
    {
      "id": "beam: home, one story up and one down",
      "command": "ModifyBeams",
      "creates": false,
      "params": {
        "beamsWithDetails": [
          {
            "elementId": {
              "guid": "${beam}"
            },
            "isAutoOnStoryVisibility": false,
            "visibility": {
              "showOnHome": true,
              "showAllAbove": false,
              "showAllBelow": false,
              "showRelAbove": 1,
              "showRelBelow": 1
            }
          }
        ]
      },
      "expect": [
        {
          "path": "executionResults[0].success",
          "eq": true
        }
      ]
    },
    {
      "id": "column: home, one story up and one down",
      "command": "ModifyColumns",
      "creates": false,
      "params": {
        "columnsWithDetails": [
          {
            "elementId": {
              "guid": "${column}"
            },
            "isAutoOnStoryVisibility": false,
            "visibility": {
              "showOnHome": true,
              "showAllAbove": false,
              "showAllBelow": false,
              "showRelAbove": 1,
              "showRelBelow": 1
            }
          }
        ]
      },
      "expect": [
        {
          "path": "executionResults[0].success",
          "eq": true
        }
      ]
    },
    {
      "id": "slab: home, one story up and one down",
      "command": "ModifySlabs",
      "creates": false,
      "params": {
        "slabsWithDetails": [
          {
            "elementId": {
              "guid": "${slab}"
            },
            "isAutoOnStoryVisibility": false,
            "visibility": {
              "showOnHome": true,
              "showAllAbove": false,
              "showAllBelow": false,
              "showRelAbove": 1,
              "showRelBelow": 1
            },
            "fillVisibility": {
              "showOnHome": true,
              "showAllAbove": false,
              "showAllBelow": false,
              "showRelAbove": 1,
              "showRelBelow": 1
            }
          }
        ]
      },
      "expect": [
        {
          "path": "executionResults[0].success",
          "eq": true
        }
      ]
    },
    {
      "id": "morph: home, one story up and one down",
      "command": "ModifyMorphs",
      "creates": false,
      "params": {
        "morphsWithDetails": [
          {
            "elementId": {
              "guid": "${morph}"
            },
            "isAutoOnStoryVisibility": false,
            "showContour": {
              "showOnHome": true,
              "showAllAbove": false,
              "showAllBelow": false,
              "showRelAbove": 1,
              "showRelBelow": 1
            },
            "showFill": {
              "showOnHome": true,
              "showAllAbove": false,
              "showAllBelow": false,
              "showRelAbove": 1,
              "showRelBelow": 1
            }
          }
        ]
      },
      "expect": [
        {
          "path": "executionResults[0].success",
          "eq": true
        }
      ]
    },
    {
      "id": "read back",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": {
        "elements": [
          {
            "elementId": {
              "guid": "${beam}"
            }
          },
          {
            "elementId": {
              "guid": "${column}"
            }
          },
          {
            "elementId": {
              "guid": "${slab}"
            }
          },
          {
            "elementId": {
              "guid": "${morph}"
            }
          },
          {
            "elementId": {
              "guid": "${createdMorph}"
            }
          },
          {
            "elementId": {
              "guid": "${wall}"
            }
          }
        ]
      },
      "expect": [
        {
          "path": "detailsOfElements[0].details.visibility.showRelAbove",
          "eq": 1,
          "name": "beam one story up"
        },
        {
          "path": "detailsOfElements[0].details.visibility.showRelBelow",
          "eq": 1,
          "name": "beam one story down"
        },
        {
          "path": "detailsOfElements[1].details.visibility.showRelAbove",
          "eq": 1,
          "name": "column one story up"
        },
        {
          "path": "detailsOfElements[1].details.visibility.showRelBelow",
          "eq": 1,
          "name": "column one story down"
        },
        {
          "path": "detailsOfElements[2].details.visibility.showRelAbove",
          "eq": 1,
          "name": "slab contour one story up"
        },
        {
          "path": "detailsOfElements[2].details.fillVisibility.showRelBelow",
          "eq": 1,
          "name": "slab fill one story down"
        },
        {
          "path": "detailsOfElements[3].details.showContour.showRelAbove",
          "eq": 1,
          "name": "morph contour one story up"
        },
        {
          "path": "detailsOfElements[3].details.showFill.showRelBelow",
          "eq": 1,
          "name": "morph fill one story down"
        },
        {
          "path": "detailsOfElements[4].details.showContour.showRelAbove",
          "eq": 1,
          "name": "created morph contour one story up"
        },
        {
          "path": "detailsOfElements[4].details.showFill.showRelBelow",
          "eq": 1,
          "name": "created morph fill one story down"
        },
        {
          "path": "detailsOfElements[5].details.visibility.showRelAbove",
          "eq": 1,
          "name": "wall one story up"
        },
        {
          "path": "detailsOfElements[5].details.visibility.showRelBelow",
          "eq": 1,
          "name": "wall one story down"
        }
      ]
    }
  ]
}
