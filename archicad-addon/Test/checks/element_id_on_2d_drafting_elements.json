{
  "title": "Lines, arcs, circles, polylines, splines and hotspots have no Element ID on Archicad 29 and later: an id is refused with APIERR_BADELEMENTTYPE and creates or changes nothing (#2762)",
  "minTapir": "2.0.1",
  "minArchicad": "29",
  "requiresEmpty": [ "Line", "Arc", "Circle", "PolyLine", "Spline", "Hotspot" ],
  "steps": [
    {
      "id": "line with an id",
      "command": "CreateLineElements",
      "params": {
        "linesData": [
          { "begCoordinate": { "x": 800.0, "y": 800.0 }, "endCoordinate": { "x": 804.0, "y": 800.0 }, "floorInd": 0, "id": "CHK-ID-LINE" }
        ]
      },
      "expect": [
        { "path": "elements[0].error.code", "eq": -2130313103, "name": "line id refused as APIERR_BADELEMENTTYPE" },
        { "path": "elements[0].elementId", "exists": false, "name": "no line answered" }
      ]
    },
    {
      "id": "arc with an id",
      "command": "CreateArcs",
      "params": {
        "arcsData": [
          { "origin": { "x": 810.0, "y": 800.0 }, "radius": 2.0, "begAngle": 0.0, "endAngle": 1.5, "floorInd": 0, "id": "CHK-ID-ARC" }
        ]
      },
      "expect": [
        { "path": "elements[0].error.code", "eq": -2130313103, "name": "arc id refused as APIERR_BADELEMENTTYPE" },
        { "path": "elements[0].elementId", "exists": false, "name": "no arc answered" }
      ]
    },
    {
      "id": "circle with an id",
      "command": "CreateCircles",
      "params": {
        "circlesData": [
          { "origin": { "x": 820.0, "y": 800.0 }, "radius": 1.0, "floorInd": 0, "id": "CHK-ID-CIRCLE" }
        ]
      },
      "expect": [
        { "path": "elements[0].error.code", "eq": -2130313103, "name": "circle id refused as APIERR_BADELEMENTTYPE" },
        { "path": "elements[0].elementId", "exists": false, "name": "no circle answered" }
      ]
    },
    {
      "id": "polyline with an id",
      "command": "CreatePolylines",
      "params": {
        "polylinesData": [
          { "coordinates": [ { "x": 830.0, "y": 800.0 }, { "x": 833.0, "y": 800.0 }, { "x": 833.0, "y": 803.0 } ], "floorInd": 0, "id": "CHK-ID-POLYLINE" }
        ]
      },
      "expect": [
        { "path": "elements[0].error.code", "eq": -2130313103, "name": "polyline id refused as APIERR_BADELEMENTTYPE" },
        { "path": "elements[0].elementId", "exists": false, "name": "no polyline answered" }
      ]
    },
    {
      "id": "spline with an id",
      "command": "CreateSplines",
      "params": {
        "splinesData": [
          { "coordinates": [ { "x": 840.0, "y": 800.0 }, { "x": 843.0, "y": 802.0 }, { "x": 846.0, "y": 800.0 } ], "closed": false, "floorInd": 0, "id": "CHK-ID-SPLINE" }
        ]
      },
      "expect": [
        { "path": "elements[0].error.code", "eq": -2130313103, "name": "spline id refused as APIERR_BADELEMENTTYPE" },
        { "path": "elements[0].elementId", "exists": false, "name": "no spline answered" }
      ]
    },
    {
      "id": "hotspot with an id",
      "command": "CreateHotspots",
      "params": {
        "hotspotsData": [
          { "position": { "x": 850.0, "y": 800.0 }, "floorInd": 0, "id": "CHK-ID-HOTSPOT" }
        ]
      },
      "expect": [
        { "path": "elements[0].error.code", "eq": -2130313103, "name": "hotspot id refused as APIERR_BADELEMENTTYPE" },
        { "path": "elements[0].elementId", "exists": false, "name": "no hotspot answered" }
      ]
    },
    {
      "id": "no line left behind",
      "command": "GetElementsByType",
      "creates": false,
      "params": { "elementType": "Line" },
      "expect": [ { "path": "elements", "len": 0, "name": "the refused line was not created" } ]
    },
    {
      "id": "no arc left behind",
      "command": "GetElementsByType",
      "creates": false,
      "params": { "elementType": "Arc" },
      "expect": [ { "path": "elements", "len": 0, "name": "the refused arc was not created" } ]
    },
    {
      "id": "no circle left behind",
      "command": "GetElementsByType",
      "creates": false,
      "params": { "elementType": "Circle" },
      "expect": [ { "path": "elements", "len": 0, "name": "the refused circle was not created" } ]
    },
    {
      "id": "no polyline left behind",
      "command": "GetElementsByType",
      "creates": false,
      "params": { "elementType": "PolyLine" },
      "expect": [ { "path": "elements", "len": 0, "name": "the refused polyline was not created" } ]
    },
    {
      "id": "no spline left behind",
      "command": "GetElementsByType",
      "creates": false,
      "params": { "elementType": "Spline" },
      "expect": [ { "path": "elements", "len": 0, "name": "the refused spline was not created" } ]
    },
    {
      "id": "no hotspot left behind",
      "command": "GetElementsByType",
      "creates": false,
      "params": { "elementType": "Hotspot" },
      "expect": [ { "path": "elements", "len": 0, "name": "the refused hotspot was not created" } ]
    },
    {
      "id": "a line without an id",
      "command": "CreateLineElements",
      "params": {
        "linesData": [
          { "begCoordinate": { "x": 800.0, "y": 810.0 }, "endCoordinate": { "x": 804.0, "y": 810.0 }, "floorInd": 0, "linePenIndex": 5 }
        ]
      },
      "save": { "l1": "elements[0].elementId.guid" },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "line without an id created" }
      ]
    },
    {
      "id": "set an id and a pen on the line",
      "command": "SetDetailsOfElements",
      "creates": false,
      "params": {
        "elementsWithDetails": [
          { "elementId": { "guid": "${l1}" }, "details": { "id": "CHK-ID-LINE-SET", "typeSpecificDetails": { "linePenIndex": 7 } } }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": false, "name": "id on a line refused" },
        { "path": "executionResults[0].error.code", "eq": -2130313103, "name": "as APIERR_BADELEMENTTYPE" }
      ]
    },
    {
      "id": "the refused change left the line as it was",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": {
        "elements": [ { "elementId": { "guid": "${l1}" } } ]
      },
      "expect": [
        { "path": "detailsOfElements[0].id", "eq": "", "name": "line still has no id" },
        { "path": "detailsOfElements[0].details.linePenIndex", "eq": 5, "name": "no other detail changed" },
        { "path": "detailsOfElements[0].details.endCoordinate.x", "approx": 804.0, "name": "geometry unchanged" }
      ]
    }
  ]
}
