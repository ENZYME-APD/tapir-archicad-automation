{
  "title": "SetDetailsOfElements on a Spline refuses geometry (coordinates) instead of answering success, and still takes the pen (#2662)",
  "minTapir": "2.0.1",
  "requiresEmpty": [ "Spline" ],
  "steps": [
    {
      "id": "a spline with four points",
      "command": "CreateSplines",
      "params": {
        "splinesData": [
          {
            "coordinates": [
              { "x": 760.0, "y": 700.0 },
              { "x": 763.0, "y": 702.0 },
              { "x": 766.0, "y": 700.0 },
              { "x": 769.0, "y": 703.0 }
            ],
            "closed": false,
            "floorInd": 0,
            "linePenIndex": 4
          }
        ]
      },
      "save": { "s1": "elements[0].elementId.guid" },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "spline created" }
      ]
    },
    {
      "id": "set two coordinates and a pen on the spline",
      "command": "SetDetailsOfElements",
      "creates": false,
      "params": {
        "elementsWithDetails": [
          {
            "elementId": { "guid": "${s1}" },
            "details": {
              "typeSpecificDetails": {
                "coordinates": [ { "x": 776.0, "y": 720.0 }, { "x": 779.0, "y": 722.0 } ],
                "linePenIndex": 7
              }
            }
          }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": false, "name": "spline coordinates refused, not answered with success" },
        { "path": "executionResults[0].error.message", "contains": "coordinates", "name": "the error names the field" }
      ]
    },
    {
      "id": "the refused item changed nothing",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${s1}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.coordinates", "len": 4, "name": "four points kept" },
        { "path": "detailsOfElements[0].details.coordinates[0].x", "approx": 760.0, "name": "first point kept" },
        { "path": "detailsOfElements[0].details.linePenIndex", "eq": 4, "name": "pen of the refused item not applied" }
      ]
    },
    {
      "id": "set only the pen on the spline",
      "command": "SetDetailsOfElements",
      "creates": false,
      "params": {
        "elementsWithDetails": [
          {
            "elementId": { "guid": "${s1}" },
            "details": { "typeSpecificDetails": { "linePenIndex": 7 } }
          }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "spline settings still accepted" }
      ]
    },
    {
      "id": "the pen was applied",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${s1}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.linePenIndex", "eq": 7, "name": "pen 7 applied" },
        { "path": "detailsOfElements[0].details.coordinates", "len": 4, "name": "points still kept" }
      ]
    }
  ]
}
