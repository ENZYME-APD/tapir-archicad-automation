{
  "title": "ModifyRoofs and ModifyShells write the floor plan and section settings and keep the 3D geometry (#2434)",
  "minTapir": "1.8.1",
  "requiresEmpty": [ "Roof", "Shell" ],
  "steps": [
    {
      "id": "a line type for the contours",
      "command": "GetAttributesByType",
      "creates": false,
      "params": { "attributeType": "Line" },
      "save": { "lineType": "attributes[0].attributeId.guid" },
      "expect": [
        { "path": "attributes[0].attributeId.guid", "exists": true, "name": "a line type exists" }
      ]
    },
    {
      "id": "single-plane roof",
      "command": "CreateRoofs",
      "params": {
        "roofsData": [
          {
            "level": 0.0,
            "floorIndex": 0,
            "structureType": "Basic",
            "thickness": 0.2,
            "polygonCoordinates": [
              { "x": 1000.0, "y": 1000.0 },
              { "x": 1006.0, "y": 1000.0 },
              { "x": 1006.0, "y": 1004.0 },
              { "x": 1000.0, "y": 1004.0 }
            ],
            "pivotLine": {
              "begCoordinate": { "x": 1000.0, "y": 1000.0 },
              "endCoordinate": { "x": 1006.0, "y": 1000.0 }
            },
            "angle": 0.5
          }
        ]
      },
      "save": { "r1": "elements[0].elementId.guid" },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "roof created" }
      ]
    },
    {
      "id": "basic extruded shell",
      "command": "CreateShells",
      "params": {
        "shellsData": [
          {
            "shellClass": "Extruded",
            "floorIndex": 0,
            "thickness": 0.2,
            "structureType": "Basic",
            "basePlane": { "origin": { "x": 1050.0, "y": 1000.0, "z": 0.0 } },
            "profile": {
              "coordinates": [ { "x": -3.0, "y": 0.0 }, { "x": 3.0, "y": 0.0 } ],
              "arcs": [ { "begIndex": 0, "endIndex": 1, "arcAngle": -1.5707963267948966 } ]
            },
            "extrusionVector": { "x": 0.0, "y": 8.0, "z": 0.0 }
          }
        ]
      },
      "save": { "s1": "elements[0].elementId.guid" },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "shell created" }
      ]
    },
    {
      "id": "3D boxes before",
      "command": "Get3DBoundingBoxes",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${r1}" } }, { "elementId": { "guid": "${s1}" } } ] },
      "save": {
        "rxMin": "boundingBoxes3D[0].boundingBox3D.xMin", "rxMax": "boundingBoxes3D[0].boundingBox3D.xMax",
        "ryMax": "boundingBoxes3D[0].boundingBox3D.yMax", "rzMax": "boundingBoxes3D[0].boundingBox3D.zMax",
        "sxMin": "boundingBoxes3D[1].boundingBox3D.xMin", "sxMax": "boundingBoxes3D[1].boundingBox3D.xMax",
        "syMax": "boundingBoxes3D[1].boundingBox3D.yMax", "szMax": "boundingBoxes3D[1].boundingBox3D.zMax"
      },
      "expect": [
        { "path": "boundingBoxes3D", "len": 2 }
      ]
    },
    {
      "id": "floor plan settings of the roof; a roof with an unknown line type",
      "command": "ModifyRoofs",
      "creates": false,
      "params": {
        "roofsWithDetails": [
          {
            "elementId": { "guid": "${r1}" },
            "displayOption": "OutLinesOnly",
            "viewDepthLimitation": "EntireElement",
            "visibility": { "showOnHome": true, "showAllAbove": true, "showAllBelow": false, "showRelBelow": 0 },
            "cutFillPen": { "overridden": true, "penIndex": 5 },
            "cutFillBackgroundPen": { "overridden": true, "penIndex": 6 },
            "sectionContourPen": 7,
            "contourPen": 9,
            "contourLineTypeId": { "guid": "${lineType}" },
            "aboveViewLinePen": 10,
            "floorFill": { "use": true, "foregroundPen": 11, "backgroundPen": 12, "useSlantedFill": true }
          },
          {
            "elementId": { "guid": "${r1}" },
            "contourPen": 3,
            "contourLineTypeId": { "guid": "00000000-0000-0000-0000-00000000BEEF" }
          }
        ]
      },
      "expect": [
        { "path": "executionResults", "len": 2, "name": "one result per item" },
        { "path": "executionResults[0].success", "eq": true, "name": "roof modified" },
        { "path": "executionResults[1].success", "eq": false, "name": "unknown line type refused" }
      ]
    },
    {
      "id": "floor plan settings of the shell; an item without fields",
      "command": "ModifyShells",
      "creates": false,
      "params": {
        "shellsWithDetails": [
          {
            "elementId": { "guid": "${s1}" },
            "displayOption": "CutOnly",
            "isAutoOnStoryVisibility": false,
            "visibility": { "showOnHome": true, "showAllAbove": false, "showRelAbove": 1, "showAllBelow": false, "showRelBelow": 0 },
            "fillVisibility": { "showOnHome": true, "showAllAbove": false, "showRelAbove": 1, "showAllBelow": false, "showRelBelow": 0 },
            "cutFillPen": { "overridden": true, "penIndex": 15 },
            "contourPen": 19,
            "contourLineTypeId": { "guid": "${lineType}" },
            "floorFill": { "use": false, "foregroundPen": 21, "backgroundPen": 22 }
          },
          {
            "elementId": { "guid": "${s1}" }
          }
        ]
      },
      "expect": [
        { "path": "executionResults", "len": 2, "name": "one result per item" },
        { "path": "executionResults[0].success", "eq": true, "name": "shell modified" },
        { "path": "executionResults[1].success", "eq": false, "name": "item without fields refused" }
      ]
    },
    {
      "id": "read the roof and the shell back",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${r1}" } }, { "elementId": { "guid": "${s1}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.displayOption", "eq": "OutLinesOnly" },
        { "path": "detailsOfElements[0].details.viewDepthLimitation", "eq": "EntireElement" },
        { "path": "detailsOfElements[0].details.isAutoOnStoryVisibility", "eq": false, "name": "roof: setting visibility turned the automatic one off" },
        { "path": "detailsOfElements[0].details.visibility.showOnHome", "eq": true },
        { "path": "detailsOfElements[0].details.visibility.showAllAbove", "eq": true },
        { "path": "detailsOfElements[0].details.cutFillPen.overridden", "eq": true },
        { "path": "detailsOfElements[0].details.cutFillPen.penIndex", "eq": 5 },
        { "path": "detailsOfElements[0].details.cutFillBackgroundPen.penIndex", "eq": 6 },
        { "path": "detailsOfElements[0].details.sectionContourPen", "eq": 7 },
        { "path": "detailsOfElements[0].details.contourPen", "eq": 9, "name": "roof contour pen (the refused item changed nothing)" },
        { "path": "detailsOfElements[0].details.contourLineTypeId.guid", "eq": "${lineType}" },
        { "path": "detailsOfElements[0].details.aboveViewLinePen", "eq": 10 },
        { "path": "detailsOfElements[0].details.floorFill.use", "eq": true },
        { "path": "detailsOfElements[0].details.floorFill.foregroundPen", "eq": 11 },
        { "path": "detailsOfElements[0].details.floorFill.backgroundPen", "eq": 12 },
        { "path": "detailsOfElements[0].details.floorFill.useSlantedFill", "eq": true },
        { "path": "detailsOfElements[0].details.roofClass", "eq": "SinglePlane", "name": "roof: still single-plane" },
        { "path": "detailsOfElements[0].details.thickness", "approx": 0.2, "name": "roof: thickness kept" },
        { "path": "detailsOfElements[0].details.angle", "approx": 0.5, "name": "roof: angle kept" },
        { "path": "detailsOfElements[0].details.polygonOutline", "len": 5, "name": "roof: outline kept" },
        { "path": "detailsOfElements[1].details.displayOption", "eq": "CutOnly" },
        { "path": "detailsOfElements[1].details.isAutoOnStoryVisibility", "eq": false },
        { "path": "detailsOfElements[1].details.visibility.showRelAbove", "eq": 1 },
        { "path": "detailsOfElements[1].details.fillVisibility.showRelAbove", "eq": 1 },
        { "path": "detailsOfElements[1].details.cutFillPen.overridden", "eq": true },
        { "path": "detailsOfElements[1].details.cutFillPen.penIndex", "eq": 15 },
        { "path": "detailsOfElements[1].details.contourPen", "eq": 19 },
        { "path": "detailsOfElements[1].details.contourLineTypeId.guid", "eq": "${lineType}" },
        { "path": "detailsOfElements[1].details.floorFill.use", "eq": false },
        { "path": "detailsOfElements[1].details.floorFill.foregroundPen", "eq": 21 },
        { "path": "detailsOfElements[1].details.floorFill.backgroundPen", "eq": 22 },
        { "path": "detailsOfElements[1].details.shellClass", "eq": "Extruded", "name": "shell: class kept" },
        { "path": "detailsOfElements[1].details.thickness", "approx": 0.2, "name": "shell: thickness kept" }
      ]
    },
    {
      "id": "3D boxes after: the geometry did not move",
      "command": "Get3DBoundingBoxes",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${r1}" } }, { "elementId": { "guid": "${s1}" } } ] },
      "save": {
        "rxMin2": "boundingBoxes3D[0].boundingBox3D.xMin", "rxMax2": "boundingBoxes3D[0].boundingBox3D.xMax",
        "ryMax2": "boundingBoxes3D[0].boundingBox3D.yMax", "rzMax2": "boundingBoxes3D[0].boundingBox3D.zMax",
        "sxMin2": "boundingBoxes3D[1].boundingBox3D.xMin", "sxMax2": "boundingBoxes3D[1].boundingBox3D.xMax",
        "syMax2": "boundingBoxes3D[1].boundingBox3D.yMax", "szMax2": "boundingBoxes3D[1].boundingBox3D.zMax"
      },
      "expect": [
        { "expr": "${rxMin2} - ${rxMin}", "approx": 0.0, "name": "roof xMin kept" },
        { "expr": "${rxMax2} - ${rxMax}", "approx": 0.0, "name": "roof xMax kept" },
        { "expr": "${ryMax2} - ${ryMax}", "approx": 0.0, "name": "roof yMax kept" },
        { "expr": "${rzMax2} - ${rzMax}", "approx": 0.0, "name": "roof zMax kept" },
        { "expr": "${sxMin2} - ${sxMin}", "approx": 0.0, "name": "shell xMin kept" },
        { "expr": "${sxMax2} - ${sxMax}", "approx": 0.0, "name": "shell xMax kept" },
        { "expr": "${syMax2} - ${syMax}", "approx": 0.0, "name": "shell yMax kept" },
        { "expr": "${szMax2} - ${szMax}", "approx": 0.0, "name": "shell zMax kept" }
      ]
    }
  ]
}
