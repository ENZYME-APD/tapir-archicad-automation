{
  "title": "ModifyCameras changes a camera's positions, view cone, two-point perspective, sun and pen and keeps its GUID and path (#2657)",
  "minTapir": "2.0.1",
  "steps": [
    {
      "id": "create a Camera Set",
      "command": "CreateCameraSets",
      "params": {
        "cameraSets": [
          { "name": "Tapir check modify cameras" }
        ]
      },
      "save": {
        "set": "elements[0].elementId.guid"
      },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "set created" }
      ]
    },
    {
      "id": "create two cameras in the set",
      "command": "CreateCameras",
      "params": {
        "cameras": [
          {
            "cameraSetElementId": { "guid": "${set}" },
            "cameraPosition": { "x": 801.25, "y": 802.5, "z": 1.75 },
            "targetPosition": { "x": 811.25, "y": 802.5, "z": 1.25 },
            "pen": 4
          },
          {
            "cameraSetElementId": { "guid": "${set}" },
            "cameraPosition": { "x": 821.5, "y": 803.75, "z": 2.25 },
            "targetPosition": { "x": 821.5, "y": 813.75, "z": 1.5 }
          }
        ]
      },
      "save": {
        "cam1": "elements[0].elementId.guid",
        "cam2": "elements[1].elementId.guid"
      },
      "expect": [
        { "path": "elements", "len": 2 },
        { "path": "elements[0].elementId.guid", "exists": true, "name": "camera 1 created" },
        { "path": "elements[1].elementId.guid", "exists": true, "name": "camera 2 created" }
      ]
    },
    {
      "id": "modify camera 1, and refuse a missing camera, a Camera Set and an empty change",
      "command": "ModifyCameras",
      "creates": false,
      "params": {
        "cameras": [
          {
            "cameraElementId": { "guid": "${cam1}" },
            "cameraPosition": { "x": 805.5, "y": 798.25, "z": 3.25 },
            "targetPosition": { "x": 815.75, "y": 808.5, "z": 0.75 },
            "isTwoPointPersp": true,
            "sun": { "sunPositionOption": "DateAndTime", "year": 2026, "month": 12, "day": 21, "hour": 10, "minute": 45, "second": 0 },
            "pen": 9
          },
          {
            "cameraElementId": { "guid": "00000000-0000-0000-0000-00000000BEEF" },
            "pen": 9
          },
          {
            "cameraElementId": { "guid": "${set}" },
            "pen": 9
          },
          {
            "cameraElementId": { "guid": "${cam2}" }
          }
        ]
      },
      "expect": [
        { "path": "executionResults", "len": 4 },
        { "path": "executionResults[0].success", "eq": true, "name": "camera 1 changed" },
        { "path": "executionResults[1].success", "eq": false, "name": "no camera with an unknown GUID" },
        { "path": "executionResults[2].success", "eq": false, "name": "a Camera Set is not a camera" },
        { "path": "executionResults[3].success", "eq": false, "name": "nothing to change is refused" }
      ]
    },
    {
      "id": "GetCameras shows the change, the same GUIDs and camera 2 unchanged",
      "command": "GetCameras",
      "creates": false,
      "params": {},
      "expect": [
        { "path": "cameraSets[*].cameras[*].cameraElementId.guid", "contains": "${cam1}", "name": "camera 1 keeps its GUID" },
        { "path": "cameraSets[*].cameras[*].cameraElementId.guid", "contains": "${cam2}" },
        { "path": "cameraSets[*].cameras[*].perspective.cameraPosition.x", "contains": 805.5, "name": "camera 1 new x" },
        { "path": "cameraSets[*].cameras[*].perspective.cameraPosition.y", "contains": 798.25, "name": "camera 1 new y" },
        { "path": "cameraSets[*].cameras[*].perspective.cameraPosition.z", "contains": 3.25, "name": "camera 1 new height" },
        { "path": "cameraSets[*].cameras[*].perspective.targetPosition.x", "contains": 815.75, "name": "target 1 new x" },
        { "path": "cameraSets[*].cameras[*].perspective.targetPosition.y", "contains": 808.5, "name": "target 1 new y" },
        { "path": "cameraSets[*].cameras[*].perspective.targetPosition.z", "contains": 0.75, "name": "target 1 new height" },
        { "path": "cameraSets[*].cameras[*].perspective.isTwoPointPersp", "contains": true, "name": "camera 1 two-point" },
        { "path": "cameraSets[*].cameras[*].perspective.sun.sunPositionOption", "contains": "DateAndTime", "name": "camera 1 sun by date" },
        { "path": "cameraSets[*].cameras[*].perspective.sun.month", "contains": 12, "name": "camera 1 sun month" },
        { "path": "cameraSets[*].cameras[*].perspective.sun.minute", "contains": 45, "name": "camera 1 sun minute" },
        { "path": "cameraSets[*].cameras[*].pen", "contains": 9, "name": "camera 1 new pen" },
        { "path": "cameraSets[*].cameras[*].perspective.cameraPosition.x", "contains": 821.5, "name": "camera 2 x unchanged" },
        { "path": "cameraSets[*].cameras[*].perspective.targetPosition.y", "contains": 813.75, "name": "camera 2 target unchanged" }
      ]
    },
    {
      "id": "modify only the pen of camera 2",
      "command": "ModifyCameras",
      "creates": false,
      "params": {
        "cameras": [
          {
            "cameraElementId": { "guid": "${cam2}" },
            "pen": 11
          }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true, "name": "camera 2 pen changed" }
      ]
    },
    {
      "id": "camera 2 has the new pen and keeps its position",
      "command": "GetCameras",
      "creates": false,
      "params": {},
      "expect": [
        { "path": "cameraSets[*].cameras[*].pen", "contains": 11, "name": "camera 2 new pen" },
        { "path": "cameraSets[*].cameras[*].perspective.cameraPosition.z", "contains": 2.25, "name": "camera 2 height kept" },
        { "path": "cameraSets[*].cameras[*].perspective.cameraPosition.x", "contains": 805.5, "name": "camera 1 x kept" }
      ]
    }
  ]
}
