{
  "title": "ReorderNavigatorItems reorders a View Map folder that holds only views and a clone folder, with no sibling folder to bounce through (#2701)",
  "minTapir": "2.0.1",
  "steps": [
    {
      "id": "the stories group and a story of the Project Map",
      "command": "GetNavigatorItemTree",
      "creates": false,
      "stopOnFail": true,
      "params": { "navigatorMapId": "ProjectMap" },
      "save": {
        "storyGroup": "navigatorItemTree.children[0].navigatorItem.navigatorItemId.guid",
        "story": "navigatorItemTree.children[0].navigatorItem.children[0].navigatorItem.navigatorItemId.guid"
      },
      "expect": [
        { "path": "navigatorItemTree.children[0].navigatorItem.children[0].navigatorItem.type", "eq": "StoryItem", "name": "first item of the first Project Map group is a story" }
      ]
    },
    {
      "id": "outer folder",
      "command": "CreateViewMapFolder",
      "creates": false,
      "stopOnFail": true,
      "params": { "folderName": "Tapir check reorder outer" },
      "save": { "outer": "navigatorItemId.guid" }
    },
    {
      "id": "folder in it",
      "command": "CreateViewMapFolder",
      "creates": false,
      "stopOnFail": true,
      "params": { "folderName": "Tapir check reorder folder", "parentNavigatorItemId": { "guid": "${outer}" } },
      "save": { "folder": "navigatorItemId.guid" }
    },
    {
      "id": "view 1 in the folder",
      "command": "CloneProjectMapItemToViewMap",
      "creates": false,
      "stopOnFail": true,
      "params": {
        "viewsData": [
          { "navigatorItemId": { "guid": "${story}" }, "parentNavigatorItemId": { "guid": "${folder}" } }
        ]
      },
      "save": { "view1": "navigatorItems[0].navigatorItemId.guid" },
      "expect": [
        { "path": "navigatorItems[0].navigatorItemId.guid", "exists": true, "name": "view created" }
      ]
    },
    {
      "id": "view 2 in the folder",
      "command": "CloneProjectMapItemToViewMap",
      "creates": false,
      "stopOnFail": true,
      "params": {
        "viewsData": [
          { "navigatorItemId": { "guid": "${story}" }, "parentNavigatorItemId": { "guid": "${folder}" } }
        ]
      },
      "save": { "view2": "navigatorItems[0].navigatorItemId.guid" },
      "expect": [
        { "path": "navigatorItems[0].navigatorItemId.guid", "exists": true, "name": "view created" }
      ]
    },
    {
      "id": "rename the views",
      "command": "RenameNavigatorItem",
      "creates": false,
      "params": { "navigatorItemId": { "guid": "${view1}" }, "newName": "Tapir check view 1" },
      "expect": [
        { "path": "success", "eq": true }
      ]
    },
    {
      "id": "rename view 2",
      "command": "RenameNavigatorItem",
      "creates": false,
      "params": { "navigatorItemId": { "guid": "${view2}" }, "newName": "Tapir check view 2" },
      "expect": [
        { "path": "success", "eq": true }
      ]
    },
    {
      "id": "clone folder of the stories group in the folder",
      "command": "CloneProjectMapItemToViewMap",
      "creates": false,
      "stopOnFail": true,
      "params": {
        "viewsData": [
          { "navigatorItemId": { "guid": "${storyGroup}" }, "parentNavigatorItemId": { "guid": "${folder}" } }
        ]
      },
      "save": { "cloneFolder": "navigatorItems[0].navigatorItemId.guid" },
      "expect": [
        { "path": "navigatorItems[0].navigatorItemId.guid", "exists": true, "name": "clone folder created" }
      ]
    },
    {
      "id": "reorder to clone folder, view 2, view 1",
      "command": "ReorderNavigatorItems",
      "creates": false,
      "params": {
        "parentNavigatorItemId": { "guid": "${folder}" },
        "orderedNavigatorItemIds": [
          { "navigatorItemId": { "guid": "${cloneFolder}" } },
          { "navigatorItemId": { "guid": "${view2}" } },
          { "navigatorItemId": { "guid": "${view1}" } }
        ]
      },
      "expect": [
        { "path": "executionResults", "len": 3, "name": "one result per item, not refused for want of a sibling folder" },
        { "path": "executionResults[0].success", "eq": true },
        { "path": "executionResults[1].success", "eq": true },
        { "path": "executionResults[2].success", "eq": true }
      ]
    },
    {
      "id": "the folder's children are in the new order",
      "command": "GetNavigatorParentItems",
      "creates": false,
      "params": {
        "navigatorItemIds": [
          { "navigatorItemId": { "guid": "${cloneFolder}" } },
          { "navigatorItemId": { "guid": "${view2}" } },
          { "navigatorItemId": { "guid": "${view1}" } }
        ]
      },
      "expect": [
        { "path": "parentItems[0].name", "eq": "Tapir check reorder folder", "name": "clone folder back in the folder" },
        { "path": "parentItems[1].name", "eq": "Tapir check reorder folder", "name": "view 2 back in the folder" },
        { "path": "parentItems[2].name", "eq": "Tapir check reorder folder", "name": "view 1 back in the folder" }
      ]
    },
    {
      "id": "View Map root",
      "command": "GetNavigatorItemTree",
      "creates": false,
      "params": { "navigatorMapId": "PublicViewMap" },
      "save": {
        "viewRoot": "navigatorItemTree.navigatorItemId.guid",
        "viewFirst": "navigatorItemTree.children[0].navigatorItem.navigatorItemId.guid"
      }
    },
    {
      "id": "outer folder second in the View Map",
      "command": "MoveNavigatorItem",
      "creates": false,
      "params": {
        "navigatorItemIdToMove": { "guid": "${outer}" },
        "parentNavigatorItemId": { "guid": "${viewRoot}" },
        "previousNavigatorItemId": { "guid": "${viewFirst}" }
      },
      "expect": [
        { "path": "success", "eq": true }
      ]
    },
    {
      "id": "read the order",
      "command": "GetNavigatorItemTree",
      "creates": false,
      "params": { "navigatorMapId": "PublicViewMap", "includeChildCount": true },
      "expect": [
        { "path": "navigatorItemTree.children[1].navigatorItem.name", "eq": "Tapir check reorder outer", "name": "outer folder second at the root" },
        { "path": "navigatorItemTree.children[1].navigatorItem.childCount", "eq": 1, "name": "nothing left behind in the outer folder" },
        { "path": "navigatorItemTree.children[1].navigatorItem.children[0].navigatorItem.childCount", "eq": 3, "name": "three items in the folder" },
        { "path": "navigatorItemTree.children[1].navigatorItem.children[0].navigatorItem.children[0].navigatorItem.name", "ne": "Tapir check view 1", "name": "first is not view 1" },
        { "path": "navigatorItemTree.children[1].navigatorItem.children[0].navigatorItem.children[0].navigatorItem.name", "ne": "Tapir check view 2", "name": "first is not view 2, so it is the clone folder" },
        { "path": "navigatorItemTree.children[1].navigatorItem.children[0].navigatorItem.children[1].navigatorItem.name", "eq": "Tapir check view 2", "name": "view 2 second" },
        { "path": "navigatorItemTree.children[1].navigatorItem.children[0].navigatorItem.children[2].navigatorItem.name", "eq": "Tapir check view 1", "name": "view 1 third" }
      ]
    }
  ],
  "teardown": [
    { "command": "DeleteNavigatorItems", "params": { "navigatorItemIds": [ { "navigatorItemId": { "guid": "${view1}" } } ] } },
    { "command": "DeleteNavigatorItems", "params": { "navigatorItemIds": [ { "navigatorItemId": { "guid": "${view2}" } } ] } },
    { "command": "DeleteNavigatorItems", "params": { "navigatorItemIds": [ { "navigatorItemId": { "guid": "${cloneFolder}" } } ] } },
    { "command": "DeleteNavigatorItems", "params": { "navigatorItemIds": [ { "navigatorItemId": { "guid": "${folder}" } } ] } },
    { "command": "DeleteNavigatorItems", "params": { "navigatorItemIds": [ { "navigatorItemId": { "guid": "${outer}" } } ] } }
  ]
}
