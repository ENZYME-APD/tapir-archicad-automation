{
  "title": "Label text direction (textWay) for Text labels in CreateLabels, ModifyLabels and GetDetailsOfElements (#2666)",
  "minTapir": "2.0.1",
  "steps": [
    {
      "id": "[Horizontal, Vertical text labels]",
      "command": "CreateLabels",
      "params": {
        "labelsData": [
          { "labelClass": "Text", "text": "Tapir horizontal", "textWay": "Horizontal",
            "begCoordinate": { "x": 700, "y": 700 }, "midCoordinate": { "x": 701, "y": 701 }, "endCoordinate": { "x": 703, "y": 701 } },
          { "labelClass": "Text", "text": "Tapir vertical", "textWay": "Vertical",
            "begCoordinate": { "x": 710, "y": 700 }, "midCoordinate": { "x": 711, "y": 701 }, "endCoordinate": { "x": 713, "y": 701 } }
        ]
      },
      "save": { "l1": "elements[0].elementId.guid", "l2": "elements[1].elementId.guid" },
      "expect": [
        { "path": "elements", "len": 2, "name": "one result per label" },
        { "path": "elements[0].elementId.guid", "exists": true, "name": "horizontal label created" },
        { "path": "elements[1].elementId.guid", "exists": true, "name": "vertical label created" }
      ]
    },
    {
      "id": "read the new labels",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": {
        "elements": [ { "elementId": { "guid": "${l1}" } }, { "elementId": { "guid": "${l2}" } } ]
      },
      "expect": [
        { "path": "detailsOfElements[0].details.labelClass", "eq": "Text", "name": "label 1 is a text label" },
        { "path": "detailsOfElements[0].details.textWay", "eq": "Horizontal", "name": "label 1 created horizontal" },
        { "path": "detailsOfElements[1].details.labelClass", "eq": "Text", "name": "label 2 is a text label" },
        { "path": "detailsOfElements[1].details.textWay", "eq": "Vertical", "name": "label 2 created vertical" }
      ]
    },
    {
      "id": "[label 1 to a custom angle, label 2 to horizontal]",
      "command": "ModifyLabels",
      "creates": false,
      "params": {
        "labelsWithDetails": [
          { "elementId": { "guid": "${l1}" }, "textWay": "General", "style": { "angle": 0.5 } },
          { "elementId": { "guid": "${l2}" }, "textWay": "Horizontal" }
        ]
      },
      "expect": [
        { "path": "executionResults", "len": 2, "name": "one result per label" },
        { "path": "executionResults[0].success", "eq": true, "name": "label 1: success" },
        { "path": "executionResults[1].success", "eq": true, "name": "label 2: success" }
      ]
    },
    {
      "id": "read the modified labels",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": {
        "elements": [ { "elementId": { "guid": "${l1}" } }, { "elementId": { "guid": "${l2}" } } ]
      },
      "expect": [
        { "path": "detailsOfElements[0].details.textWay", "eq": "General", "name": "label 1 now at a custom angle" },
        { "path": "detailsOfElements[0].details.style.angle", "approx": 0.5, "tol": 0.001, "name": "label 1 at the given angle" },
        { "path": "detailsOfElements[0].details.text", "eq": "Tapir horizontal", "name": "label 1 text kept" },
        { "path": "detailsOfElements[1].details.textWay", "eq": "Horizontal", "name": "label 2 now horizontal" },
        { "path": "detailsOfElements[1].details.text", "eq": "Tapir vertical", "name": "label 2 text kept" }
      ]
    },
    {
      "id": "[textWay given twice]",
      "command": "CreateLabels",
      "creates": false,
      "params": {
        "labelsData": [
          { "labelClass": "Text", "text": "Tapir twice", "textWay": "Horizontal", "symbolStyle": { "textWay": "Vertical" },
            "begCoordinate": { "x": 720, "y": 700 }, "midCoordinate": { "x": 721, "y": 701 }, "endCoordinate": { "x": 723, "y": 701 } }
        ]
      },
      "expect": [
        { "path": "elements", "len": 1, "name": "one result per label" },
        { "path": "elements[0].error", "exists": true, "name": "refused: textWay on the label and in symbolStyle" }
      ]
    }
  ]
}
