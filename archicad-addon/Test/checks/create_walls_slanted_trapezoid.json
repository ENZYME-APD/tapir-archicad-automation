{
  "title": "CreateWalls takes profileType and geometryType, Create/ModifyWalls take begThickness/endThickness, and a slant that cannot take effect fails (#2564)",
  "minTapir": "2.0.1",
  "steps": [
    {
      "id": "slanted wall in one call",
      "command": "CreateWalls",
      "params": {
        "wallsData": [
          {
            "begCoordinate": { "x": 900.0, "y": 760.0 },
            "endCoordinate": { "x": 904.0, "y": 760.0 },
            "floorIndex": 0,
            "zCoordinate": 0.0,
            "height": 2.8,
            "structureType": "Basic",
            "thickness": 0.25,
            "profileType": "Slanted",
            "slantAlpha": 1.3962634
          }
        ]
      },
      "save": { "slanted": "elements[0].elementId.guid" },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "profileType accepted by CreateWalls" }
      ]
    },
    {
      "id": "read the slanted wall",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${slanted}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.profileType", "eq": "Slanted" },
        { "path": "detailsOfElements[0].details.slantAlpha", "approx": 1.3962634, "tol": 0.0001, "name": "80 degree slant kept" }
      ]
    },
    {
      "id": "trapezoid wall in one call",
      "command": "CreateWalls",
      "params": {
        "wallsData": [
          {
            "begCoordinate": { "x": 910.0, "y": 760.0 },
            "endCoordinate": { "x": 915.0, "y": 760.0 },
            "floorIndex": 0,
            "zCoordinate": 0.0,
            "height": 2.8,
            "structureType": "Basic",
            "profileType": "Normal",
            "geometryType": "Trapezoid",
            "begThickness": 0.2,
            "endThickness": 0.4
          }
        ]
      },
      "save": { "trapezoid": "elements[0].elementId.guid" },
      "expect": [
        { "path": "elements[0].elementId.guid", "exists": true, "name": "geometryType and begin/end thickness accepted by CreateWalls" }
      ]
    },
    {
      "id": "read the trapezoid wall",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${trapezoid}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.geometryType", "eq": "Trapezoid" },
        { "path": "detailsOfElements[0].details.begThickness", "approx": 0.2, "tol": 0.0001 },
        { "path": "detailsOfElements[0].details.endThickness", "approx": 0.4, "tol": 0.0001 }
      ]
    },
    {
      "id": "modify the begin/end thickness, and refuse a slant the walls cannot take",
      "command": "ModifyWalls",
      "creates": false,
      "params": {
        "wallsWithDetails": [
          { "elementId": { "guid": "${trapezoid}" }, "begThickness": 0.3, "endThickness": 0.15 },
          { "elementId": { "guid": "${trapezoid}" }, "slantAlpha": 1.2, "height": 3.5 },
          { "elementId": { "guid": "${slanted}" }, "slantBeta": 1.2, "height": 3.5 },
          { "elementId": { "guid": "${trapezoid}" }, "slantAlpha": 1.5707963267948966 }
        ]
      },
      "expect": [
        { "path": "executionResults", "len": 4, "name": "one result per item" },
        { "path": "executionResults[0].success", "eq": true, "name": "begin/end thickness modified" },
        { "path": "executionResults[1].success", "eq": false, "name": "slantAlpha on a Normal profile fails" },
        { "path": "executionResults[2].success", "eq": false, "name": "slantBeta on a Slanted profile fails" },
        { "path": "executionResults[3].success", "eq": true, "name": "a vertical slantAlpha is accepted" }
      ]
    },
    {
      "id": "read the modified walls",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": { "elements": [ { "elementId": { "guid": "${trapezoid}" } }, { "elementId": { "guid": "${slanted}" } } ] },
      "expect": [
        { "path": "detailsOfElements[0].details.begThickness", "approx": 0.3, "tol": 0.0001 },
        { "path": "detailsOfElements[0].details.endThickness", "approx": 0.15, "tol": 0.0001 },
        { "path": "detailsOfElements[0].details.height", "approx": 2.8, "tol": 0.0001, "name": "the failed item changed nothing" },
        { "path": "detailsOfElements[1].details.height", "approx": 2.8, "tol": 0.0001, "name": "the failed item changed nothing on the slanted wall" },
        { "path": "detailsOfElements[1].details.slantAlpha", "approx": 1.3962634, "tol": 0.0001 }
      ]
    },
    {
      "id": "a slant on a Normal profile fails the new wall instead of being dropped",
      "command": "CreateWalls",
      "params": {
        "wallsData": [
          {
            "begCoordinate": { "x": 920.0, "y": 760.0 },
            "endCoordinate": { "x": 924.0, "y": 760.0 },
            "floorIndex": 0,
            "zCoordinate": 0.0,
            "height": 2.8,
            "structureType": "Basic",
            "thickness": 0.25,
            "profileType": "Normal",
            "slantAlpha": 1.3962634
          }
        ]
      },
      "expect": [
        { "path": "elements[0].error.code", "exists": true, "name": "ineffective slantAlpha refused" }
      ]
    }
  ]
}
