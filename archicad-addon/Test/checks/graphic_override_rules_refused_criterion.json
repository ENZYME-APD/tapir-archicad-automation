{
  "title": "Graphic override rules: a rule Archicad refuses gets an error result, the others of the call are kept",
  "minTapir": "1.8.1",
  "minArchicad": "29",
  "steps": [
    {
      "id": "a property group",
      "command": "CreatePropertyGroups",
      "creates": false,
      "params": {
        "propertyGroups": [
          {
            "propertyGroup": {
              "name": "TapirCheck Refused Criterion Group",
              "description": ""
            }
          }
        ]
      },
      "save": {
        "group": "propertyGroupIds[0].propertyGroupId.guid"
      },
      "expect": [
        {
          "path": "propertyGroupIds[0].propertyGroupId.guid",
          "exists": true,
          "name": "group created"
        }
      ]
    },
    {
      "id": "a multiple choice option set property",
      "command": "CreatePropertyDefinitions",
      "creates": false,
      "params": {
        "propertyDefinitions": [
          {
            "propertyDefinition": {
              "name": "TapirCheck Finish",
              "description": "TapirCheck",
              "type": "multiEnum",
              "isEditable": true,
              "availability": [],
              "group": {
                "propertyGroupId": {
                  "guid": "${group}"
                }
              },
              "possibleEnumValues": [
                {
                  "enumValue": {
                    "displayValue": "Plaster"
                  }
                }
              ]
            }
          }
        ]
      },
      "save": {
        "prop": "propertyIds[0].propertyId.guid"
      },
      "expect": [
        {
          "path": "propertyIds[0].propertyId.guid",
          "exists": true,
          "name": "property created"
        }
      ]
    },
    {
      "id": "a good rule, one with \"is not\" on the multiple choice property, another good rule",
      "command": "CreateGraphicOverrideRules",
      "creates": false,
      "params": {
        "graphicOverrideRules": [
          {
            "name": "TapirCheck good 1",
            "ruleGroupName": "TapirCheck refused criterion",
            "criterion": {
              "and": [
                {
                  "elementType": "Wall"
                }
              ]
            },
            "style": {
              "lineMarkerTextPen": 20
            }
          },
          {
            "name": "TapirCheck refused",
            "ruleGroupName": "TapirCheck refused criterion",
            "criterion": {
              "and": [
                {
                  "all3DTypes": true
                },
                {
                  "criterionXML": "<ClassGuid>58E4905F-AD57-45F5-8D26-0100000F60BF</ClassGuid><PropertyCriterion Mv=\"6\" Sv=\"0\"><VBEF::ConditionIO Mv=\"2\" Sv=\"0\"><PropertyDefinitionUserId Version=\"2\"><PrimaryId>1</PrimaryId><HasGuidId>false</HasGuidId><Guid>00000000-0000-0000-0000-000000000000</Guid><HasNameId>true</HasNameId><Name>TapirCheck Finish</Name><PropertyDefinitionGroupUserId Version=\"2\"><PrimaryId>1</PrimaryId><HasGuidId>false</HasGuidId><Guid>00000000-0000-0000-0000-000000000000</Guid><HasNameId>true</HasNameId><Name>TapirCheck Refused Criterion Group</Name></PropertyDefinitionGroupUserId></PropertyDefinitionUserId><CriteriaOperatorEnum>1</CriteriaOperatorEnum><Variant Type=\"StringListVariant\"><Status>Normal</Status><ValueArray><ValueItem>Plaster</ValueItem></ValueArray></Variant></VBEF::ConditionIO></PropertyCriterion>"
                }
              ]
            },
            "style": {
              "lineMarkerTextPen": 20
            }
          },
          {
            "name": "TapirCheck good 2",
            "ruleGroupName": "TapirCheck refused criterion",
            "criterion": {
              "and": [
                {
                  "elementType": "Slab"
                }
              ]
            },
            "style": {
              "lineMarkerTextPen": 20
            }
          }
        ]
      },
      "save": {
        "good1": "graphicOverrideRuleIds[0].graphicOverrideRuleId.guid",
        "good2": "graphicOverrideRuleIds[2].graphicOverrideRuleId.guid"
      },
      "expect": [
        {
          "path": "graphicOverrideRuleIds",
          "len": 3,
          "name": "a result for each rule"
        },
        {
          "path": "graphicOverrideRuleIds[0].graphicOverrideRuleId.guid",
          "exists": true,
          "name": "first rule created"
        },
        {
          "path": "graphicOverrideRuleIds[1].error.code",
          "exists": true,
          "name": "refused rule gets an error"
        },
        {
          "path": "graphicOverrideRuleIds[2].graphicOverrideRuleId.guid",
          "exists": true,
          "name": "third rule created"
        }
      ]
    },
    {
      "id": "the two good rules exist",
      "command": "GetGraphicOverrideRulesByName",
      "params": {
        "graphicOverrideRules": [
          {
            "name": "TapirCheck good 1",
            "ruleGroupName": "TapirCheck refused criterion"
          },
          {
            "name": "TapirCheck good 2",
            "ruleGroupName": "TapirCheck refused criterion"
          },
          {
            "name": "TapirCheck refused",
            "ruleGroupName": "TapirCheck refused criterion"
          }
        ]
      },
      "expect": [
        {
          "path": "graphicOverrideRules[0].name",
          "eq": "TapirCheck good 1",
          "name": "first rule kept"
        },
        {
          "path": "graphicOverrideRules[1].name",
          "eq": "TapirCheck good 2",
          "name": "third rule kept"
        },
        {
          "path": "graphicOverrideRules[2].error.code",
          "exists": true,
          "name": "refused rule not created"
        }
      ]
    },
    {
      "id": "modify: the refused criterion, and a rename",
      "command": "ModifyGraphicOverrideRules",
      "params": {
        "graphicOverrideRules": [
          {
            "graphicOverrideRuleId": {
              "guid": "${good1}"
            },
            "criterion": {
              "and": [
                {
                  "all3DTypes": true
                },
                {
                  "criterionXML": "<ClassGuid>58E4905F-AD57-45F5-8D26-0100000F60BF</ClassGuid><PropertyCriterion Mv=\"6\" Sv=\"0\"><VBEF::ConditionIO Mv=\"2\" Sv=\"0\"><PropertyDefinitionUserId Version=\"2\"><PrimaryId>1</PrimaryId><HasGuidId>false</HasGuidId><Guid>00000000-0000-0000-0000-000000000000</Guid><HasNameId>true</HasNameId><Name>TapirCheck Finish</Name><PropertyDefinitionGroupUserId Version=\"2\"><PrimaryId>1</PrimaryId><HasGuidId>false</HasGuidId><Guid>00000000-0000-0000-0000-000000000000</Guid><HasNameId>true</HasNameId><Name>TapirCheck Refused Criterion Group</Name></PropertyDefinitionGroupUserId></PropertyDefinitionUserId><CriteriaOperatorEnum>1</CriteriaOperatorEnum><Variant Type=\"StringListVariant\"><Status>Normal</Status><ValueArray><ValueItem>Plaster</ValueItem></ValueArray></Variant></VBEF::ConditionIO></PropertyCriterion>"
                }
              ]
            }
          },
          {
            "graphicOverrideRuleId": {
              "guid": "${good2}"
            },
            "name": "TapirCheck good 2 renamed"
          }
        ]
      },
      "expect": [
        {
          "path": "executionResults",
          "len": 2,
          "name": "a result for each rule"
        },
        {
          "path": "executionResults[0].success",
          "eq": false,
          "name": "refused criterion reported"
        },
        {
          "path": "executionResults[1].success",
          "eq": true,
          "name": "rename done"
        }
      ]
    },
    {
      "id": "the first rule keeps its criterion",
      "command": "GetGraphicOverrideRulesByName",
      "params": {
        "graphicOverrideRules": [
          {
            "name": "TapirCheck good 1",
            "ruleGroupName": "TapirCheck refused criterion"
          },
          {
            "name": "TapirCheck good 2 renamed",
            "ruleGroupName": "TapirCheck refused criterion"
          }
        ],
        "includeCriterion": true
      },
      "expect": [
        {
          "path": "graphicOverrideRules[0].criterion.and[0].elementType",
          "eq": "Wall",
          "name": "criterion unchanged"
        },
        {
          "path": "graphicOverrideRules[1].name",
          "eq": "TapirCheck good 2 renamed",
          "name": "renamed"
        }
      ]
    }
  ],
  "teardown": [
    {
      "command": "DeleteGraphicOverrideRuleGroups",
      "params": {
        "ruleGroupNames": [
          "TapirCheck refused criterion"
        ],
        "deleteRules": true
      }
    },
    {
      "command": "DeletePropertyDefinitions",
      "params": {
        "propertyIds": [
          {
            "propertyId": {
              "guid": "${prop}"
            }
          }
        ]
      }
    },
    {
      "command": "DeletePropertyGroups",
      "params": {
        "propertyGroupIds": [
          {
            "propertyGroupId": {
              "guid": "${group}"
            }
          }
        ]
      }
    }
  ]
}
